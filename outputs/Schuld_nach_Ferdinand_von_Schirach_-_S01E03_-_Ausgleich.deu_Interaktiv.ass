Dialogue: 0,0:03:16.34,0:03:20.16,Standard,,0,0,0,,‫علاوه بر این، خانم لویفر‬\N‫اعتراف کرده‬
Dialogue: 0,0:03:22.18,0:03:24.52,Standard,,0,0,0,,‫{\c&H00FFFF&}اعتراف؟{\c}‬\N‫بله‬
Dialogue: 0,0:03:24.62,0:03:27.04,Standard,,0,0,0,,‫یه وکیل از برلین هم‬\N‫نمی‌تونه چیزی رو عوض کنه‬
Dialogue: 0,0:03:27.14,0:03:31.14,Standard,,0,0,0,,‫من به اتهام قتل ازش شکایت می‌کنم‬\N‫یه کپی از پرونده رو بهتون می‌دم‬
Dialogue: 1,0:03:31.24,0:03:40.24,InfoBox,,0,0,0,,{\b1}Sprechschein{\b0}
Dialogue: 0,0:03:31.24,0:03:34.20,Standard,,0,0,0,,‫{\c&H00FFFF&}لطفاً مجوز ملاقات{\c}‬\N‫{\c&H00FFFF&}برام صادر کنید{\c}‬
Dialogue: 0,0:03:34.30,0:03:37.32,Standard,,0,0,0,,‫{\c&H00FFFF&}بقیه مسائل را با خانم{\c}‬\N‫{\c&H00FFFF&}لویفر حل و فصل می‌کنم{\c}‬
Dialogue: 0,0:03:37.42,0:03:58.48,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:04:07.82,0:04:10.40,Standard,,0,0,0,,‫{\c&H00FFFF&}روز بخیر{\c}‬
Dialogue: 0,0:04:11.06,0:04:13.64,Standard,,0,0,0,,‫{\c&H00FFFF&}ممنون{\c}‬\N‫خواهش می‌کنم‬
Dialogue: 0,0:04:20.54,0:04:22.32,Standard,,0,0,0,,‫خواهش می‌کنم‬
Dialogue: 0,0:04:22.54,0:04:24.20,Standard,,0,0,0,,‫{\c&H00FFFF&}ممنون{\c}‬
Dialogue: 0,0:04:24.30,0:04:27.00,Standard,,0,0,0,,‫{\c&H00FFFF&}روز بخیر خانم لویفر{\c}‬
Dialogue: 0,0:04:27.10,0:04:30.16,Standard,,0,0,0,,‫{\c&H00FFFF&}نام من کرونبرگ است{\c}‬\N‫{\c&H00FFFF&}من وکیل هستم{\c}‬
Dialogue: 0,0:04:30.26,0:04:33.12,Standard,,0,0,0,,‫{\c&H00FFFF&}لطفاً بنشینید{\c}‬
Dialogue: 0,0:04:44.38,0:04:48.36,Standard,,0,0,0,,‫{\c&H00FFFF&}والدین‌تان از من خواستند{\c}‬\N‫{\c&H00FFFF&}که وکالت شما را بر عهده بگیرم{\c}‬
Dialogue: 1,0:04:54.46,0:05:03.46,InfoBox,,0,0,0,,{\b1}Vollmacht{\b0}
Dialogue: 0,0:04:54.46,0:04:58.44,Standard,,0,0,0,,‫{\c&H00FFFF&}برای این کار باید لطفاً{\c}‬\N‫{\c&H00FFFF&}وکالت‌نامه را امضا کنید{\c}‬
Dialogue: 0,0:05:04.06,0:05:05.84,Standard,,0,0,0,,‫{\c&H00FFFF&}ممنون{\c}‬
Dialogue: 0,0:05:15.54,0:05:18.76,Standard,,0,0,0,,‫{\c&H00FFFF&}نمی‌توانم شما را از این کار معاف کنم{\c}‬\N‫{\c&H00FFFF&}شما باید...{\c}‬
Dialogue: 0,0:05:18.86,0:05:21.84,Standard,,0,0,0,,‫{\c&H00FFFF&}به من بگویید{\c}‬\N‫{\c&H00FFFF&}چه اتفاقی افتاده است{\c}‬
Dialogue: 0,0:05:25.14,0:05:28.12,Standard,,0,0,0,,‫{\c&HFFFF00&}من که همه این‌ها را{\c}‬\N‫{\c&HFFFF00&}قبلاً گفته‌ام{\c}‬
Dialogue: 0,0:05:28.62,0:05:31.04,Standard,,0,0,0,,‫{\c&H00FFFF&}نه واقعاً{\c}‬\N‫{\c&H00FFFF&}شما فقط اعتراف کردید{\c}‬
Dialogue: 0,0:05:31.14,0:05:35.72,Standard,,0,0,0,,‫{\c&H00FFFF&}این موضوع متفاوتی است و کار را{\c}‬\N‫{\c&H00FFFF&}برای من چندان آسان نمی‌کند{\c}‬
Dialogue: 0,0:05:37.90,0:05:42.28,Standard,,0,0,0,,‫{\c&H00FFFF&}اما چیزی که نگفتید این است که{\c}‬\N‫{\c&H00FFFF&}این جراحات از کجا آمده‌اند{\c}‬
Dialogue: 0,0:05:42.38,0:05:45.24,Standard,,0,0,0,,‫{\c&H00FFFF&}چه کسی شما را به این روز انداخته؟{\c}‬
Dialogue: 0,0:05:53.98,0:05:57.96,Standard,,0,0,0,,‫{\c&H00FFFF&}فکر می‌کنم باید این‌ها را{\c}‬\N‫{\c&H00FFFF&}مستند کنیم{\c}‬
Dialogue: 0,0:06:00.98,0:06:03.20,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم لویفر، به من گوش دهید{\c}‬
Dialogue: 0,0:06:03.30,0:06:07.36,Standard,,0,0,0,,‫{\c&H00FFFF&}من مثل پلیس به دنبال{\c}‬\N‫{\c&H00FFFF&}چیزهایی که علیه شماست نیستم{\c}‬
Dialogue: 0,0:06:07.48,0:06:11.32,Standard,,0,0,0,,‫{\c&H00FFFF&}من وکیل شما هستم{\c}‬\N‫{\c&H00FFFF&}و می‌خواهم به شما کمک کنم{\c}‬
Dialogue: 0,0:06:11.70,0:06:15.30,Standard,,0,0,0,,‫{\c&H00FFFF&}اما برای این کار باید{\c}‬\N‫{\c&H00FFFF&}با من صحبت کنید{\c}‬
Dialogue: 0,0:06:16.14,0:06:20.72,Standard,,0,0,0,,‫{\c&H00FFFF&}از همان ابتدا تعریف کنید{\c}‬\N‫{\c&H00FFFF&}چطور با همسرتان آشنا شدید{\c}‬
Dialogue: 0,0:06:26.82,0:06:29.40,Standard,,0,0,0,,‫{\c&HFFFF00&}آن موقع ۱۹ سالم بود{\c}‬
Dialogue: 0,0:06:34.86,0:06:37.56,Standard,,0,0,0,,‫{\c&H00FF00&}خوب راه می‌ره، نه؟{\c}‬
Dialogue: 0,0:06:37.66,0:06:39.44,Standard,,0,0,0,,‫{\c&HFFFF00&}خیلی{\c}‬
Dialogue: 0,0:06:44.66,0:06:46.64,Standard,,0,0,0,,‫{\c&HFF0000&}شما می‌خندید{\c}‬
Dialogue: 0,0:06:47.34,0:06:51.04,Standard,,0,0,0,,‫{\c&H00FF00&}انتخاب خوبیه{\c}‬\N‫{\c&H00FF00&}ماشین یک سال گارانتی داره{\c}‬
Dialogue: 0,0:06:51.14,0:06:54.12,Standard,,0,0,0,,‫{\c&H00FF00&}اگه مشکلی پیش اومد،{\c}‬\N‫{\c&H00FF00&}که امیدوارم پیش نیاد...{\c}‬
Dialogue: 0,0:06:54.22,0:06:58.20,Standard,,0,0,0,,‫{\c&H00FF00&}یا شاید هم امیدوارم پیش بیاد،{\c}‬\N‫{\c&H00FF00&}اون وقت فقط کافیه بیاید اینجا{\c}‬
Dialogue: 0,0:06:59.02,0:07:00.80,Standard,,0,0,0,,‫{\c&HFFFF00&}ممنونم{\c}‬
Dialogue: 0,0:07:10.98,0:07:48.00,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:08:06.70,0:08:09.28,Standard,,0,0,0,,‫{\c&H00FF00&}به سلامتی تو{\c}‬\N‫{\c&HFFFF00&}به سلامتی ما{\c}‬
Dialogue: 0,0:08:17.14,0:08:20.00,Standard,,0,0,0,,‫این برای شماست، عزیزانم‬
Dialogue: 0,0:08:20.30,0:08:22.88,Standard,,0,0,0,,‫{\c&HFFFF00&}ممنون پدربزرگ{\c}‬
Dialogue: 0,0:08:28.22,0:08:30.12,Standard,,0,0,0,,‫لبخند بزنید...‬
Dialogue: 0,0:08:37.14,0:08:40.12,Standard,,0,0,0,,‫می‌شه لطفاً پیراهنتون رو دربیارید؟‬
Dialogue: 0,0:08:47.54,0:08:50.12,Standard,,0,0,0,,‫کبد به صورت طولی‬
Dialogue: 0,0:08:53.70,0:08:56.00,Standard,,0,0,0,,‫ساعد چپ‬
Dialogue: 0,0:08:56.10,0:08:58.68,Standard,,0,0,0,,‫ران چپ‬
Dialogue: 0,0:09:03.26,0:09:06.24,Standard,,0,0,0,,‫می‌شه لطفاً برگردید؟‬
Dialogue: 0,0:09:29.58,0:09:32.16,Standard,,0,0,0,,‫{\c&HFFFF00&}خب عزیزم؟{\c}‬
Dialogue: 0,0:09:33.74,0:09:36.24,Standard,,0,0,0,,‫{\c&HFFFF00&}مست کردی؟{\c}‬\N‫{\c&H00FF00&}خب که چی؟{\c}‬
Dialogue: 0,0:09:36.34,0:09:38.44,Standard,,0,0,0,,‫{\c&HFFFF00&}نمی‌دونم والا...{\c}‬
Dialogue: 0,0:09:38.54,0:09:41.68,Standard,,0,0,0,,‫{\c&HFFFF00&}اول کتت رو دربیار{\c}‬\N‫{\c&H00FF00&}این دیگه چه معنی داره؟{\c}‬
Dialogue: 0,0:09:41.78,0:09:44.36,Standard,,0,0,0,,‫{\c&HFFFF00&}چی شده؟{\c}‬
Dialogue: 0,0:10:19.94,0:10:22.80,Standard,,0,0,0,,‫{\c&H00FF00&}قهوه الان آماده می‌شه{\c}‬
Dialogue: 0,0:10:23.98,0:10:27.84,Standard,,0,0,0,,‫{\c&H00FF00&}واقعاً بابت دیروز متاسفم{\c}‬\N‫{\c&H00FF00&}خواهش می‌کنم، منو ببخش{\c}‬
Dialogue: 0,0:10:27.94,0:10:30.80,Standard,,0,0,0,,‫{\c&H00FF00&}زیادی نوشیدم{\c}‬
Dialogue: 0,0:10:35.38,0:10:40.56,Standard,,0,0,0,,‫{\c&H00FF00&}منو ببخش، من... دیگه هیچ‌وقت،{\c}‬\N‫{\c&H00FF00&}دیگه لب به نوشیدنی نمی‌زنم، هیچ‌وقت{\c}‬
Dialogue: 0,0:10:41.34,0:10:43.64,Standard,,0,0,0,,‫{\c&H00FF00&}خواهش می‌کنم، ببخش{\c}‬
Dialogue: 0,0:10:43.74,0:10:47.32,Standard,,0,0,0,,‫{\c&H00FF00&}خواهش می‌کنم{\c}‬
Dialogue: 0,0:11:02.34,0:11:04.52,Standard,,0,0,0,,‫{\c&H00FFFF&}آقای قاضی فالک{\c}‬
Dialogue: 0,0:11:04.62,0:11:07.64,Standard,,0,0,0,,‫{\c&H00FFFF&}روز بخیر، کرونبرگ هستم{\c}‬\N‫{\c&H00FFFF&}وکیل خانم لُیفر{\c}‬
Dialogue: 0,0:11:07.74,0:11:09.80,Standard,,0,0,0,,‫از آشنایی با شما خوشبختم‬\N‫{\c&H00FFFF&}همچنین{\c}‬
Dialogue: 1,0:11:09.90,0:11:18.90,InfoBox,,0,0,0,,{\b1}Staatsanwaltschaft{\b0}
Dialogue: 0,0:11:09.90,0:11:12.52,Standard,,0,0,0,,‫{\c&H00FFFF&}دادستانی اتهام رو{\c}‬\N‫{\c&H00FFFF&}قتل عمد اعلام کرده{\c}‬
Dialogue: 0,0:11:12.62,0:11:15.90,Standard,,0,0,0,,‫{\c&H00FFFF&}می‌تونید تصور کنید که{\c}‬\N‫{\c&H00FFFF&}بشه جور دیگه‌ای هم بهش نگاه کرد{\c}‬
Dialogue: 0,0:11:15.98,0:11:18.96,Standard,,0,0,0,,‫{\c&H00FFFF&}به نظر میاد که اون{\c}‬\N‫{\c&H00FFFF&}درست قبل از وقوع جرم{\c}‬
Dialogue: 0,0:11:19.06,0:11:22.84,Standard,,0,0,0,,‫{\c&H00FFFF&}توسط شوهرش مورد ضرب و شتم قرار گرفته{\c}‬\N‫مرد خواب بوده‬
Dialogue: 0,0:11:22.94,0:11:26.92,Standard,,0,0,0,,‫می‌دونید که دیوان عالی فدرال‬\N‫در چنین مواردی چه حکمی میده‬
Dialogue: 0,0:11:27.02,0:11:28.48,Standard,,0,0,0,,‫{\c&H00FFFF&}بله{\c}‬
Dialogue: 0,0:11:28.90,0:11:31.48,Standard,,0,0,0,,‫متأسفم‬
Dialogue: 0,0:11:37.98,0:11:39.96,Standard,,0,0,0,,‫{\c&HFF0000&}همهمه نامفهوم صداها{\c}‬
Dialogue: 0,0:11:44.98,0:11:47.56,Standard,,0,0,0,,‫{\c&H00FFFF&}روز بخیر{\c}‬
Dialogue: 0,0:11:56.78,0:11:59.64,Standard,,0,0,0,,‫جلسه دادگاه را در شعبه دوم‬\N‫کیفری دادگاه ایالتی اولدنبورگ‬
Dialogue: 0,0:11:59.74,0:12:02.60,Standard,,0,0,0,,‫آغاز می‌کنم‬
Dialogue: 0,0:12:05.50,0:12:07.48,Standard,,0,0,0,,‫دادگاه با حضور اعضایی که‬
Dialogue: 0,0:12:07.58,0:12:11.52,Standard,,0,0,0,,‫قبلاً به صورت کتبی به اطلاع‬\N‫طرفین رسیده، تشکیل می‌شود‬
Dialogue: 0,0:12:11.62,0:12:14.60,Standard,,0,0,0,,‫متهم،‬\N‫خانم الکساندرا لُیفر،‬
Dialogue: 0,0:12:14.70,0:12:18.68,Standard,,0,0,0,,‫با حضور وکیل خود‬\N‫فریدریش کرونبرگ حاضر است،‬
Dialogue: 0,0:12:19.38,0:12:23.36,Standard,,0,0,0,,‫دادستانی توسط دادستان دکتر کائولباخ‬\N‫نمایندگی می‌شود‬
Dialogue: 0,0:12:23.98,0:12:27.48,Standard,,0,0,0,,‫شما الکساندرا لُیفر هستید،‬\N‫متولد دلمن‌هورست‬
Dialogue: 0,0:12:27.58,0:12:32.08,Standard,,0,0,0,,‫در ۵ فوریه ۱۹۸۲،‬\N‫ساکن اولدنبورگ‬
Dialogue: 0,0:12:32.58,0:12:35.56,Standard,,0,0,0,,‫شما همسر مقتول بودید؟‬
Dialogue: 0,0:12:37.90,0:12:41.48,Standard,,0,0,0,,‫جناب دادستان،‬\N‫تریبون در اختیار شماست‬
Dialogue: 0,0:12:41.82,0:12:45.80,Standard,,0,0,0,,‫الکساندرا لویفر متهم است که‬\N‫در دوازدهم آوریل امسال‬
Dialogue: 0,0:12:45.90,0:12:49.28,Standard,,0,0,0,,‫در اولدنبورگ، همسرش‬\N‫توماس لویفر را به قتل رسانده است‬
Dialogue: 0,0:12:49.38,0:12:51.44,Standard,,0,0,0,,‫از آنجایی که مقتول‬\N‫در زمان وقوع جرم در خواب بوده‬
Dialogue: 1,0:12:51.54,0:13:00.54,InfoBox,,0,0,0,,{\b1}Heimtücke{\b0}
Dialogue: 0,0:12:51.54,0:12:54.04,Standard,,0,0,0,,‫ما این عمل را‬\N‫مصداق بارز قتل عمد و غافلگیری‬
Dialogue: 0,0:12:54.14,0:12:57.12,Standard,,0,0,0,,‫طبق بند ۲ ماده ۲۱۱‬\N‫محرز می‌دانیم‬
Dialogue: 0,0:12:58.34,0:13:00.32,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:13:02.74,0:13:07.32,Standard,,0,0,0,,‫(قاضی) خانم لویفر؟ آیا مایلید‬\N‫در مورد اتهام خود اظهار نظر کنید؟‬
Dialogue: 0,0:13:11.02,0:13:14.60,Standard,,0,0,0,,‫{\c&H00FFFF&}موکل من{\c}‬\N‫{\c&H00FFFF&}هیچ اظهار نظری نخواهد کرد{\c}‬
Dialogue: 0,0:13:22.90,0:13:24.88,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:13:31.54,0:13:34.12,Standard,,0,0,0,,‫{\c&HFFFF00&}چه عالی{\c}‬
Dialogue: 0,0:13:53.74,0:13:55.72,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 1,0:14:12.14,0:14:21.14,InfoBox,,0,0,0,,{\b1}Tathergang{\b0}
Dialogue: 0,0:14:12.14,0:14:16.32,Standard,,0,0,0,,‫(قاضی) دکتر مایر، یافته‌های شما‬\N‫در مورد نحوه وقوع جرم چیست؟‬
Dialogue: 0,0:14:16.42,0:14:20.24,Standard,,0,0,0,,‫ما مقتول را در تخت پیدا کردیم‬\N‫جمجمه او متلاشی شده بود‬
Dialogue: 0,0:14:20.34,0:14:22.84,Standard,,0,0,0,,‫شکستگی‌ها و خردشدگی‌هایی‬\N‫قابل تشخیص بود‬
Dialogue: 1,0:14:22.94,0:14:31.94,InfoBox,,0,0,0,,{\b1}Gewalteinwirkung{\b0}
Dialogue: 0,0:14:22.94,0:14:25.84,Standard,,0,0,0,,‫که ناشی از ضربه بسیار سنگین بود‬
Dialogue: 0,0:14:25.94,0:14:29.24,Standard,,0,0,0,,‫بخش‌های مغزی زیر آن‬\N‫چنان آسیب دیده بودند‬
Dialogue: 0,0:14:29.34,0:14:32.64,Standard,,0,0,0,,‫که مرگ آنی رخ داده است‬\N‫- (دکتر کائولباخ) چندین ضربه؟‬
Dialogue: 0,0:14:32.74,0:14:37.32,Standard,,0,0,0,,‫خیر، اثر ضربه روی جمجمه‬\N‫نشان‌دهنده تنها یک ضربه است‬
Dialogue: 0,0:14:37.42,0:14:40.88,Standard,,0,0,0,,‫آیا لکه‌های خون‬\N‫به‌طور دقیق با روند جرم مطابقت دارند؟‬
Dialogue: 0,0:14:40.98,0:14:45.20,Standard,,0,0,0,,‫(مایر) هیچ لکه خونی وجود نداشت‬\N‫که چیزی غیر از این را ثابت کند‬
Dialogue: 0,0:14:45.30,0:14:48.28,Standard,,0,0,0,,‫(دکتر کائولباخ) و آلت قتاله؟‬\N‫(مایر) این وسیله‬
Dialogue: 0,0:14:48.38,0:14:52.36,Standard,,0,0,0,,‫یک مجسمه سنگی است‬\N‫که پیکر یک زوج را نشان می‌دهد‬
Dialogue: 0,0:14:53.38,0:14:59.76,Standard,,0,0,0,,‫{\c&HFF0000&}صدای بوق تلفن{\c}‬
Dialogue: 0,0:15:01.54,0:15:05.80,Standard,,0,0,0,,‫{\c&H00FF00&}(صداگیر) اینجا توماس لویفر است،{\c}‬\N‫{\c&H00FF00&}لطفاً بعد از شنیدن صدای بوق پیغام بگذارید{\c}‬
Dialogue: 0,0:15:05.90,0:15:09.88,Standard,,0,0,0,,‫{\c&HFFFF00&}توماس، ما هستیم. کجایی؟{\c}‬\N‫{\c&HFFFF00&}منتظرت هستیم{\c}‬
Dialogue: 0,0:15:09.98,0:15:12.56,Standard,,0,0,0,,‫{\c&HFFFF00&}تا بعد{\c}‬
Dialogue: 0,0:15:19.14,0:15:21.72,Standard,,0,0,0,,‫{\c&HFFFF00&}به مامان کمک می‌کنی؟{\c}‬
Dialogue: 0,0:15:24.46,0:15:26.68,Standard,,0,0,0,,‫(آنها می‌خوانند)‬\N‫شب خاموش!‬
Dialogue: 0,0:15:27.30,0:15:29.76,Standard,,0,0,0,,‫شب مقدس!‬
Dialogue: 0,0:15:30.30,0:15:32.64,Standard,,0,0,0,,‫همه در خوابند،‬
Dialogue: 0,0:15:32.90,0:15:35.48,Standard,,0,0,0,,‫تنها بیدار است‬
Dialogue: 0,0:15:35.82,0:15:40.36,Standard,,0,0,0,,‫آن زوج مقدس و عزیز‬
Dialogue: 0,0:15:41.14,0:15:45.44,Standard,,0,0,0,,‫پسرک زیبا با موهای مجعد،‬
Dialogue: 0,0:15:46.18,0:15:50.76,Standard,,0,0,0,,‫در آرامش آسمانی بخواب...‬
Dialogue: 0,0:15:53.26,0:15:55.88,Standard,,0,0,0,,‫{\c&HFFFF00&}شب بخیر عزیزم{\c}‬\N‫شب بخیر‬
Dialogue: 0,0:15:55.98,0:15:58.56,Standard,,0,0,0,,‫{\c&HFFFF00&}خوب بخوابی{\c}‬
Dialogue: 0,0:16:01.06,0:16:03.64,Standard,,0,0,0,,‫بابا کجاست؟‬
Dialogue: 0,0:16:06.14,0:16:10.12,Standard,,0,0,0,,‫{\c&HFFFF00&}فردا صبح که بیدار شوی،{\c}‬\N‫{\c&HFFFF00&}او دوباره اینجاست{\c}‬
Dialogue: 0,0:16:15.14,0:16:17.12,Standard,,0,0,0,,‫{\c&HFF0000&}در باز می‌شود{\c}‬
Dialogue: 0,0:16:27.38,0:16:29.96,Standard,,0,0,0,,‫{\c&HFFFF00&}خب، تو هم که اینجایی؟{\c}‬
Dialogue: 0,0:16:31.06,0:16:33.64,Standard,,0,0,0,,‫{\c&H00FF00&}یعنی چی؟{\c}‬
Dialogue: 0,0:16:33.74,0:16:35.34,Standard,,0,0,0,,‫{\c&H00FF00&}هم؟{\c}‬
Dialogue: 0,0:16:36.02,0:16:38.88,Standard,,0,0,0,,‫{\c&H00FF00&}منظورت چیه؟ چی؟{\c}‬
Dialogue: 0,0:16:54.70,0:16:56.68,Standard,,0,0,0,,‫{\c&HFF0000&}او گریه می‌کند{\c}‬
Dialogue: 0,0:16:59.74,0:17:01.92,Standard,,0,0,0,,‫(قاضی)‬\N‫سوالی از کارشناس دارید؟‬
Dialogue: 0,0:17:02.02,0:17:04.72,Standard,,0,0,0,,‫{\c&H00FFFF&}آقای دکتر،{\c}‬\N‫{\c&H00FFFF&}لطفاً برای ما توضیح دهید،{\c}‬
Dialogue: 0,0:17:04.82,0:17:10.00,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم لویفر را در چه وضعیتی{\c}‬\N‫{\c&H00FFFF&}هنگام معاینه یافتید{\c}‬
Dialogue: 0,0:17:10.94,0:17:14.76,Standard,,0,0,0,,‫روی بدن متهم‬\N‫دو روز پس از حادثه، من متوجه شدم‬
Dialogue: 1,0:17:14.86,0:17:23.86,InfoBox,,0,0,0,,{\b1}Zeuge{\b0}
Dialogue: 0,0:17:14.86,0:17:19.44,Standard,,0,0,0,,‫جراحات شدید ناشی از‬\N‫ضربه جسم سخت مشاهده شد‬
Dialogue: 0,0:17:19.62,0:17:24.20,Standard,,0,0,0,,‫کبد به طول چهار سانتی‌متر‬\N‫دچار پارگی شده بود‬
Dialogue: 0,0:17:25.34,0:17:29.92,Standard,,0,0,0,,‫کلیه‌ها چنان کوفته شده بودند‬\N‫که دچار خونریزی داخلی شدند‬
Dialogue: 0,0:17:30.02,0:17:33.12,Standard,,0,0,0,,‫علاوه بر این جراحات‬\N‫در زیر پوست‬
Dialogue: 0,0:17:33.22,0:17:37.20,Standard,,0,0,0,,‫خون‌مردگی‌های وسیعی در‬\N‫سراسر بالاتنه پخش بود‬
Dialogue: 0,0:17:37.30,0:17:40.76,Standard,,0,0,0,,‫در این عکس رادیولوژی می‌بینید‬\N‫چهار دنده ترک‌خورده است‬
Dialogue: 0,0:17:40.86,0:17:43.32,Standard,,0,0,0,,‫شش شکستگی دنده دیگر‬\N‫التیام یافته‌اند‬
Dialogue: 0,0:17:43.42,0:17:46.60,Standard,,0,0,0,,‫باید فرض را بر این گذاشت‬\N‫که این جراحات سه تا...‬
Dialogue: 0,0:17:46.70,0:17:49.56,Standard,,0,0,0,,‫هفت سال پیش ایجاد شده‌اند‬
Dialogue: 0,0:18:00.42,0:18:02.42,Standard,,0,0,0,,‫{\c&HFF0000&}صدای سیفون توالت{\c}‬
Dialogue: 0,0:18:21.98,0:18:24.88,Standard,,0,0,0,,‫{\c&HFFFF00&}موش کوچولو، پاشو بیدار شو.{\c}‬\N‫{\c&HFFFF00&}پاشو، وقت بیدار شدنه.{\c}‬
Dialogue: 0,0:18:24.98,0:18:26.96,Standard,,0,0,0,,‫{\c&HFFFF00&}داریم می‌ریم خونه مامان‌بزرگ و بابابزرگ،{\c}‬\N‫{\c&HFFFF00&}برای خوردن غاز.{\c}‬
Dialogue: 0,0:18:27.06,0:18:29.84,Standard,,0,0,0,,‫چرا زودتر بیدارم نکردی؟‬
Dialogue: 0,0:18:29.94,0:18:34.52,Standard,,0,0,0,,‫می‌خوام با سوفیا بازی کنم.‬\N‫{\c&HFFFF00&}اونجا هم می‌تونیم بازی کنیم.{\c}‬
Dialogue: 0,0:18:34.82,0:18:37.40,Standard,,0,0,0,,‫{\c&HFFFF00&}اون رو هم با خودمون می‌بریم.{\c}‬
Dialogue: 0,0:18:39.14,0:18:40.92,Standard,,0,0,0,,‫{\c&HFFFF00&}بیا.{\c}‬
Dialogue: 0,0:18:43.94,0:18:47.80,Standard,,0,0,0,,‫{\c&HFFFF00&}خب، اینم کلاهت. بپوشش.{\c}‬\N‫{\c&HFFFF00&}برو بیرون منتظر باش.{\c}‬
Dialogue: 0,0:18:56.62,0:18:59.20,Standard,,0,0,0,,‫{\c&HFFFF00&}بیا، بدو.{\c}‬
Dialogue: 0,0:19:02.42,0:19:07.60,Standard,,0,0,0,,‫{\c&H00FF00&}کجا دارید می‌رید؟  {\c}‬\N‫{\c&HFFFFFF&}خونه مامان‌بزرگ،{\c}‬\N‫برای خوردن غاز. یادت رفته؟‬
Dialogue: 0,0:19:08.22,0:19:11.36,Standard,,0,0,0,,‫{\c&H00FF00&}ببین، مامان‌بزرگ زنگ زد.{\c}‬\N‫{\c&H00FF00&}حالش خیلی خوب نیست.{\c}‬
Dialogue: 0,0:19:11.46,0:19:14.44,Standard,,0,0,0,,‫{\c&H00FF00&}متأسفانه برنامه خوردن غاز کنسل شد.{\c}‬
Dialogue: 0,0:19:15.46,0:19:19.12,Standard,,0,0,0,,‫{\c&H00FF00&}بابانوئل برات چی{\c}‬\N‫{\c&H00FF00&}آورده؟  {\c}‬\N‫{\c&HFFFFFF&}سوفیا.{\c}‬
Dialogue: 0,0:19:19.22,0:19:22.80,Standard,,0,0,0,,‫{\c&H00FF00&}سلام سوفیا. می‌خوای بازی کنیم؟{\c}‬\N‫آره، حتماً‬
Dialogue: 0,0:19:40.98,0:19:43.96,Standard,,0,0,0,,‫{\c&H00FF00&}تو هیچ‌جا نمی‌ری، فهمیدی؟{\c}‬
Dialogue: 0,0:19:49.26,0:19:51.24,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی دراماتیک{\c}‬
Dialogue: 1,0:20:06.54,0:20:15.54,InfoBox,,0,0,0,,{\b1}Einsichts- und Steuerungsfähigkeit{\b0}
Dialogue: 0,0:20:06.54,0:20:09.72,Standard,,0,0,0,,‫آقای دکتر بانرت، آیا در زمان ارتکاب جرم،‬\N‫در متهم توانایی تشخیص و کنترل‬
Dialogue: 0,0:20:09.82,0:20:13.80,Standard,,0,0,0,,‫محدود و مختلی قابل تشخیص بود؟‬
Dialogue: 1,0:20:13.90,0:20:22.90,InfoBox,,0,0,0,,{\b1}Schuldunfähigkeit{\b0}
Dialogue: 0,0:20:13.90,0:20:17.88,Standard,,0,0,0,,‫من هیچ اختلال روان‌پزشکی مرتبطی که بتواند‬\N‫به عدم مسئولیت کیفری‬
Dialogue: 0,0:20:17.98,0:20:19.96,Standard,,0,0,0,,‫یا کاهش مسئولیت کیفری‬
Dialogue: 0,0:20:20.06,0:20:24.04,Standard,,0,0,0,,‫منجر شود، تشخیص ندادم‬
Dialogue: 0,0:20:24.22,0:20:27.20,Standard,,0,0,0,,‫سپاسگزارم‬\N‫سوالی دیگر ندارم‬
Dialogue: 0,0:20:29.22,0:20:31.96,Standard,,0,0,0,,‫آقای وکیل مدافع، سوال دیگری دارید؟‬\N‫{\c&H00FFFF&}بله، آقای بانرت،{\c}‬
Dialogue: 0,0:20:32.06,0:20:36.04,Standard,,0,0,0,,‫{\c&H00FFFF&}می‌خواستم بپرسم که شما{\c}‬\N‫{\c&H00FFFF&}بدرفتاری‌هایی را که خانم لویفر{\c}‬
Dialogue: 0,0:20:36.14,0:20:39.28,Standard,,0,0,0,,‫{\c&H00FFFF&}در طول زندگی مشترک متحمل شده،{\c}‬\N‫{\c&H00FFFF&}چگونه ارزیابی می‌کنید؟{\c}‬
Dialogue: 0,0:20:39.38,0:20:41.80,Standard,,0,0,0,,‫(بانرت) او قطعاً در زمان ارتکاب جرم‬\N‫تحت تأثیر‬
Dialogue: 1,0:20:41.90,0:20:50.90,InfoBox,,0,0,0,,{\b1}Posttraumatische Belastungsstörung{\b0}
Dialogue: 0,0:20:41.90,0:20:44.08,Standard,,0,0,0,,‫اختلال استرس پس از سانحه بوده است‬
Dialogue: 0,0:20:44.18,0:20:48.16,Standard,,0,0,0,,‫بیش از این نمی‌توانم چیزی بگویم‬\N‫{\c&H00FFFF&}جراحات قدیمی‌تری هم در بدن{\c}‬
Dialogue: 0,0:20:48.26,0:20:51.92,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم لویفر تأیید شده است{\c}‬\N‫{\c&H00FFFF&}آیا ممکن است این‌ها توسط{\c}‬
Dialogue: 1,0:20:52.02,0:21:01.02,InfoBox,,0,0,0,,{\b1}beigebracht{\b0}
Dialogue: 0,0:20:52.02,0:20:55.80,Standard,,0,0,0,,‫{\c&H00FFFF&}همسرش به او تحمیل شده باشد؟{\c}‬\N‫من نمی‌توانم در این مورد قضاوت کنم‬
Dialogue: 0,0:20:55.90,0:20:58.88,Standard,,0,0,0,,‫{\c&H00FFFF&}سوالی ندارم{\c}‬\N‫(قاضی) بسیار خب‬
Dialogue: 0,0:20:59.14,0:21:03.12,Standard,,0,0,0,,‫ممنون آقای دکتر بانرت،‬\N‫شما به عنوان شاهد مرخص هستید‬
Dialogue: 0,0:21:06.62,0:21:08.60,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی دراماتیک{\c}‬
Dialogue: 0,0:21:45.90,0:21:47.88,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:21:51.74,0:21:55.32,Standard,,0,0,0,,‫{\c&H00FF00&}اصلاً گرسنه نیستی؟{\c}‬\N‫(ساسکیا) نه‬
Dialogue: 0,0:21:55.42,0:21:58.00,Standard,,0,0,0,,‫{\c&H00FF00&}می‌خواهیم راه بیفتیم؟{\c}‬\N‫بله‬
Dialogue: 0,0:22:03.70,0:22:07.30,Standard,,0,0,0,,‫ممنون‬\N‫{\c&HFFFF00&}خداحافظ عزیزم، روز خوبی داشته باشی{\c}‬
Dialogue: 0,0:22:13.90,0:22:16.64,Standard,,0,0,0,,‫{\c&H00FF00&}کاپشن آنجاست، نه؟{\c}‬\N‫بله‬
Dialogue: 0,0:22:16.74,0:22:18.72,Standard,,0,0,0,,‫{\c&HFF0000&}صدای بسته شدن در{\c}‬
Dialogue: 0,0:22:24.18,0:22:28.76,Standard,,0,0,0,,‫{\c&H00FFFF&}حالا اجازه ندهید که همه این‌ها{\c}‬\N‫{\c&H00FFFF&}به همین سادگی بر سرتان بیاید{\c}‬
Dialogue: 0,0:22:31.22,0:22:34.32,Standard,,0,0,0,,‫{\c&H00FFFF&}شما باید فردا{\c}‬\N‫{\c&H00FFFF&}با تمام جزئیات{\c}‬
Dialogue: 1,0:22:34.42,0:22:43.42,InfoBox,,0,0,0,,{\b1}Gewalttätigkeiten{\b0}
Dialogue: 0,0:22:34.42,0:22:38.40,Standard,,0,0,0,,‫{\c&H00FFFF&}درباره خشونت‌های{\c}‬\N‫{\c&H00FFFF&}همسرتان شهادت دهید{\c}‬
Dialogue: 0,0:22:39.02,0:22:44.20,Standard,,0,0,0,,‫{\c&H00FFFF&}و اینکه چرا مقاومت نکردید{\c}‬\N‫{\c&H00FFFF&}وگرنه هیچ‌کس شما را درک نخواهد کرد{\c}‬
Dialogue: 0,0:22:45.86,0:22:48.72,Standard,,0,0,0,,‫{\c&H00FFFF&}می‌توانم یک سوال از شما بپرسم؟{\c}‬
Dialogue: 0,0:22:48.82,0:22:52.80,Standard,,0,0,0,,‫{\c&H00FFFF&}چرا از همسرتان{\c}‬\N‫{\c&H00FFFF&}جدا نشدید؟{\c}‬
Dialogue: 0,0:22:56.38,0:23:00.36,Standard,,0,0,0,,‫{\c&HFFFF00&}می‌خواستم تحمل کنم{\c}‬\N‫{\c&HFFFF00&}تا ساسکیا به اندازه کافی بزرگ شود{\c}‬
Dialogue: 0,0:23:02.62,0:23:06.24,Standard,,0,0,0,,‫{\c&HFFFF00&}می‌خواستم تا آن موقع دوام بیاورم{\c}‬\N‫{\c&H00FFFF&}پس دقیقاً همین را در دادگاه بگویید{\c}‬
Dialogue: 0,0:23:06.34,0:23:09.68,Standard,,0,0,0,,‫{\c&HFFFF00&}نمی‌توانم{\c}‬\N‫{\c&H00FFFF&}خانم لویفر{\c}‬\N‫{\c&H00FFFF&}آیا متوجه نیستید؟{\c}‬
Dialogue: 0,0:23:09.78,0:23:12.16,Standard,,0,0,0,,‫{\c&H00FFFF&}شما به اتهام قتل محاکمه می‌شوید{\c}‬
Dialogue: 1,0:23:12.26,0:23:21.26,InfoBox,,0,0,0,,{\b1}Freiheitsstrafe{\b0}
Dialogue: 1,0:23:12.26,0:23:21.26,InfoBox,,0,0,0,,{\b1}lebenslange Haftstrafe{\b0}
Dialogue: 0,0:23:12.26,0:23:15.52,Standard,,0,0,0,,‫{\c&H00FFFF&}این یعنی{\c}‬\N‫{\c&H00FFFF&}حکم حبس ابد{\c}‬
Dialogue: 0,0:23:15.62,0:23:18.08,Standard,,0,0,0,,‫{\c&H00FFFF&}قاضی طرف شماست{\c}‬\N‫{\c&H00FFFF&}مطمئن باشید{\c}‬
Dialogue: 0,0:23:18.18,0:23:21.76,Standard,,0,0,0,,‫{\c&H00FFFF&}اما شما باید چیزی به او بدهید{\c}‬\N‫{\c&H00FFFF&}تا بتواند کمکتان کند{\c}‬
Dialogue: 0,0:23:30.38,0:23:33.96,Standard,,0,0,0,,‫{\c&H00FFFF&}دیگر بس کنید{\c}‬\N‫{\c&H00FFFF&}خانم لویفر{\c}‬
Dialogue: 0,0:23:34.94,0:23:37.80,Standard,,0,0,0,,‫{\c&H00FFFF&}این رفتار شما را به جایی نمی‌رساند{\c}‬
Dialogue: 0,0:23:49.50,0:23:52.48,Standard,,0,0,0,,‫{\c&H00FFFF&}شما فردا مجبور به شهادت دادن هستید{\c}‬
Dialogue: 0,0:23:57.14,0:23:58.68,Standard,,0,0,0,,‫{\c&HFF0000&}او به در می‌کوبد{\c}‬
Dialogue: 0,0:24:01.82,0:24:05.40,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم لویفر{\c}‬\N‫{\c&H00FFFF&}به فکر دخترتان باشید{\c}‬
Dialogue: 0,0:24:06.22,0:24:08.80,Standard,,0,0,0,,‫{\c&H00FFFF&}او منتظر شماست{\c}‬
Dialogue: 0,0:25:03.94,0:25:06.08,Standard,,0,0,0,,‫{\c&HFFFF00&}خب؟{\c}‬\N‫می‌توانی این را با خودت ببری بالا؟‬
Dialogue: 0,0:25:06.18,0:25:09.32,Standard,,0,0,0,,‫من کوتاه پیش لیا می‌روم‬\N‫{\c&HFFFF00&}اما تا یک ساعت دیگر شام آماده است{\c}‬
Dialogue: 0,0:25:09.42,0:25:12.28,Standard,,0,0,0,,‫{\c&HFFFF00&}تا آن موقع برمی‌گردی، نه؟{\c}‬
Dialogue: 0,0:25:13.30,0:25:15.68,Standard,,0,0,0,,‫می‌توانم کمک کنم؟‬
Dialogue: 0,0:25:15.78,0:25:18.36,Standard,,0,0,0,,‫{\c&HFFFF00&}ممنون{\c}‬\N‫خواهش می‌کنم‬
Dialogue: 0,0:25:18.98,0:25:21.84,Standard,,0,0,0,,‫راستی، اسم من فلیکس است‬
Dialogue: 0,0:25:22.06,0:25:24.64,Standard,,0,0,0,,‫زونن‌برگ هستم، من طبقه بالای شما زندگی می‌کنم‬
Dialogue: 0,0:25:24.74,0:25:27.12,Standard,,0,0,0,,‫شاید بتوانید‬\N‫گاهی زنگ بزنید‬
Dialogue: 0,0:25:27.22,0:25:29.80,Standard,,0,0,0,,‫{\c&HFFFF00&}بله، ممنون{\c}‬
Dialogue: 0,0:25:41.42,0:25:43.40,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:26:13.14,0:26:14.60,Standard,,0,0,0,,‫{\c&HFF0000&}صدای زنگ در{\c}‬
Dialogue: 0,0:26:18.14,0:26:20.72,Standard,,0,0,0,,‫نمک دارید؟‬\N‫{\c&HFFFF00&}بله{\c}‬
Dialogue: 0,0:26:21.74,0:26:24.32,Standard,,0,0,0,,‫نه، من...‬
Dialogue: 0,0:26:24.70,0:26:28.12,Standard,,0,0,0,,‫می‌دانم بهانه احمقانه‌ای است،‬\N‫من...‬
Dialogue: 0,0:26:28.22,0:26:32.20,Standard,,0,0,0,,‫اتفاقاً میل دارید‬\N‫با هم قهوه‌ای بخوریم؟‬
Dialogue: 0,0:26:35.14,0:26:38.00,Standard,,0,0,0,,‫{\c&HFFFF00&}بله، الان ژاکتم را می‌آورم{\c}‬
Dialogue: 0,0:26:45.74,0:26:48.72,Standard,,0,0,0,,‫(قاضی) خانم لویفر،‬\N‫الان فرصت دارید‬
Dialogue: 0,0:26:48.82,0:26:52.80,Standard,,0,0,0,,‫که برای دادگاه تعریف کنید‬\N‫ماجرا چطور اتفاق افتاد‬
Dialogue: 0,0:26:55.46,0:26:58.44,Standard,,0,0,0,,‫{\c&H00FFFF&}(زمزمه) خانم لویفر،{\c}‬\N‫{\c&H00FFFF&}توصیه می‌کنم چیزی بگویید{\c}‬
Dialogue: 0,0:26:58.54,0:27:01.40,Standard,,0,0,0,,‫(قاضی) خانم لویفر؟‬
Dialogue: 0,0:27:02.94,0:27:04.92,Standard,,0,0,0,,‫دادگاه‬\N‫اعترافات مکتوب متهم را‬
Dialogue: 0,0:27:05.02,0:27:09.36,Standard,,0,0,0,,‫در اختیار دارد.‬\N‫می‌توانیم به جای آن، آن را قرائت کنیم‬
Dialogue: 0,0:27:09.46,0:27:12.28,Standard,,0,0,0,,‫منظورم این نبود.‬\N‫آقای وکیل؟‬
Dialogue: 0,0:27:12.38,0:27:15.28,Standard,,0,0,0,,‫{\c&H00FFFF&}ریاست محترم دادگاه،{\c}‬\N‫{\c&H00FFFF&}موکل من به دلیل{\c}‬
Dialogue: 0,0:27:15.38,0:27:19.28,Standard,,0,0,0,,‫{\c&H00FFFF&}اختلال استرس پس از سانحه{\c}‬\N‫{\c&H00FFFF&}قادر به ادای شهادت نیست{\c}‬
Dialogue: 0,0:27:19.38,0:27:22.96,Standard,,0,0,0,,‫بسیار خب، پس اعترافات را‬\N‫قرائت می‌کنیم‬
Dialogue: 0,0:27:24.70,0:27:27.56,Standard,,0,0,0,,‫«صورت‌جلسه مورخ ۱۳ آوریل ۲۰۱۴‬
Dialogue: 0,0:27:28.30,0:27:30.28,Standard,,0,0,0,,‫بازجویی توسط‬\N‫دادستان کائولباخ‬
Dialogue: 0,0:27:30.38,0:27:34.36,Standard,,0,0,0,,‫از متهم الکساندرا لویفر‬\N‫در پرونده توماس لویفر:‬
Dialogue: 0,0:27:34.82,0:27:39.24,Standard,,0,0,0,,‫توماس و من دخترمان ساسکیا را‬\N‫پیش والدینم بردیم‬
Dialogue: 0,0:27:39.34,0:27:41.68,Standard,,0,0,0,,‫به محض اینکه...»‬\N‫{\c&HFFFF00&}«به محض اینکه به خانه رسیدیم،{\c}‬
Dialogue: 0,0:27:41.78,0:27:45.36,Standard,,0,0,0,,‫{\c&HFFFF00&}توماس مرا کتک زد{\c}‬\N‫{\c&HFFFF00&}و مورد تجاوز قرار داد{\c}‬
Dialogue: 0,0:27:49.90,0:27:54.50,Standard,,0,0,0,,‫{\c&HFFFF00&}وقتی کارش تمام شد، مرا با لگد{\c}‬\N‫{\c&HFFFF00&}به زمین انداخت»{\c}‬
Dialogue: 0,0:27:59.82,0:28:02.48,Standard,,0,0,0,,‫{\c&H00FF00&}ساسکیا به زودی ده ساله می‌شود{\c}‬\N‫{\c&HFFFF00&}«بعد به من گفت{\c}‬
Dialogue: 0,0:28:02.58,0:28:07.52,Standard,,0,0,0,,‫{\c&HFFFF00&}که ساسکیا دیگر به سنی رسیده که همان کاری را{\c}‬\N‫{\c&HFFFF00&}با او انجام دهد که با من کرد{\c}‬
Dialogue: 0,0:28:07.62,0:28:11.28,Standard,,0,0,0,,‫{\c&HFFFF00&}خواستم مقاومت کنم{\c}‬\N‫{\c&HFFFF00&}که با لگد به شکمم زد{\c}‬
Dialogue: 0,0:28:11.38,0:28:14.24,Standard,,0,0,0,,‫{\c&HFFFF00&}مجبور شدم استفراغ کنم{\c}‬
Dialogue: 0,0:28:16.06,0:28:20.04,Standard,,0,0,0,,‫{\c&HFFFF00&}استفراغ را پاک کردم{\c}‬\N‫{\c&HFFFF00&}و منتظر ماندم تا به خواب برود{\c}‬
Dialogue: 0,0:28:29.14,0:28:32.12,Standard,,0,0,0,,‫{\c&HFFFF00&}تمام مدت به ساسکیا فکر می‌کردم{\c}‬
Dialogue: 0,0:28:32.62,0:28:35.48,Standard,,0,0,0,,‫{\c&HFFFF00&}او فقط نه سال دارد{\c}‬
Dialogue: 0,0:28:43.34,0:28:46.32,Standard,,0,0,0,,‫{\c&HFFFF00&}مجسمه را برداشتم{\c}‬\N‫{\c&HFFFF00&}و...{\c}‬
Dialogue: 0,0:28:46.42,0:28:49.28,Standard,,0,0,0,,‫{\c&HFFFF00&}با آن او را کشتم»{\c}‬
Dialogue: 1,0:29:02.82,0:29:11.82,InfoBox,,0,0,0,,{\b1}Rechtsprechung{\b0}
Dialogue: 0,0:29:02.82,0:29:05.72,Standard,,0,0,0,,‫ریاست محترم دادگاه‬\N‫طبق رویه قضایی ثابت دیوان عالی کشور‬
Dialogue: 0,0:29:05.82,0:29:08.80,Standard,,0,0,0,,‫در قتل فردی که در خواب است‬
Dialogue: 0,0:29:08.90,0:29:11.88,Standard,,0,0,0,,‫عنصر جنایی غافلگیری‬\N‫همواره محرز است‬
Dialogue: 1,0:29:12.42,0:29:21.42,InfoBox,,0,0,0,,{\b1}mildernde Umstände{\b0}
Dialogue: 0,0:29:12.42,0:29:16.32,Standard,,0,0,0,,‫بنابراین به عقیده من‬\N‫هیچ‌گونه شرایط تخفیف مجازاتی‬
Dialogue: 0,0:29:16.42,0:29:19.72,Standard,,0,0,0,,‫به دلیل بدرفتاری‌های تحمل‌شده‬\N‫قابل اعمال نیست‬
Dialogue: 1,0:29:19.82,0:29:28.82,InfoBox,,0,0,0,,{\b1}vorsätzlich{\b0}
Dialogue: 0,0:29:19.82,0:29:24.88,Standard,,0,0,0,,‫متهم با قصد قبلی عمل کرده‬\N‫او شوهرش را در خواب به قتل رسانده‬
Dialogue: 0,0:29:24.98,0:29:29.56,Standard,,0,0,0,,‫بنابراین باید به حبس ابد‬\N‫محکوم شود‬
Dialogue: 0,0:29:31.74,0:29:34.60,Standard,,0,0,0,,‫(قاضی) جلسه را‬\N‫به فردا صبح موکول می‌کنم‬
Dialogue: 0,0:29:34.70,0:29:37.24,Standard,,0,0,0,,‫شروع: ساعت ۹:۳۰‬
Dialogue: 0,0:29:37.34,0:29:39.36,Standard,,0,0,0,,‫همکاران...‬
Dialogue: 0,0:29:39.46,0:29:43.04,Standard,,0,0,0,,‫می‌خواهم کوتاه با شما صحبت کنم‬\N‫هر دوی شما‬
Dialogue: 0,0:29:52.74,0:29:54.96,Standard,,0,0,0,,‫دکتر کائولباخ، شما که دیدید‬
Dialogue: 0,0:29:55.06,0:29:58.44,Standard,,0,0,0,,‫آن زن شب قبل از حادثه چه وضعیتی داشت؟‬
Dialogue: 0,0:29:58.54,0:30:02.60,Standard,,0,0,0,,‫بله، البته که دیدم‬\N‫- می‌توانید تصور کنید‬
Dialogue: 0,0:30:02.70,0:30:07.28,Standard,,0,0,0,,‫که آن مرد چه کارهای دیگری با او می‌کرد؟‬\N‫- بله، اما او چیزی نمی‌گوید‬
Dialogue: 0,0:30:07.38,0:30:10.72,Standard,,0,0,0,,‫{\c&H00FFFF&}او دچار ضربه روحی شده{\c}‬\N‫{\c&H00FFFF&}این را که دیگر می‌شود حدس زد{\c}‬
Dialogue: 0,0:30:10.82,0:30:14.16,Standard,,0,0,0,,‫دیوان فدرال دادگستری در چنین مواردی‬\N‫بسیار قاطعانه تصمیم می‌گیرد‬
Dialogue: 0,0:30:14.26,0:30:17.24,Standard,,0,0,0,,‫قربانی در خواب بوده،‬\N‫پس این قتل با غافلگیری است‬
Dialogue: 0,0:30:17.34,0:30:21.32,Standard,,0,0,0,,‫{\c&H00FFFF&}این اصطلاحی مربوط به دوران نازی‌هاست!{\c}‬\N‫شما که واقعاً انتظار ندارید،‬
Dialogue: 0,0:30:21.42,0:30:25.40,Standard,,0,0,0,,‫که من این زن را برای حبس ابد‬\N‫به زندان بفرستم؟‬
Dialogue: 0,0:30:26.78,0:30:29.28,Standard,,0,0,0,,‫آقای کرونبرگ...‬
Dialogue: 0,0:30:29.38,0:30:32.80,Standard,,0,0,0,,‫من می‌خواهم فردا‬\N‫حرف‌های منطقی‌تری از شما بشنوم‬
Dialogue: 0,0:30:32.90,0:30:34.68,Standard,,0,0,0,,‫خواهش می‌کنم‬
Dialogue: 0,0:30:36.90,0:30:39.48,Standard,,0,0,0,,‫{\c&H00FFFF&}تلاشم را می‌کنم{\c}‬
Dialogue: 0,0:30:42.46,0:30:45.44,Standard,,0,0,0,,‫خداحافظ مامان‬\N‫{\c&HFFFF00&}خداحافظ عزیزم{\c}‬
Dialogue: 0,0:30:45.90,0:30:48.48,Standard,,0,0,0,,‫خداحافظ‬\N‫{\c&HFFFF00&}کلاه ایمنی‌ات؟{\c}‬
Dialogue: 0,0:30:52.06,0:30:53.84,Standard,,0,0,0,,‫خداحافظ‬
Dialogue: 0,0:30:56.22,0:30:58.20,Standard,,0,0,0,,‫{\c&HFF0000&}صدای لرزش گوشی{\c}‬
Dialogue: 0,0:31:07.70,0:32:13.04,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:32:18.86,0:32:20.64,Standard,,0,0,0,,‫{\c&HFFFF00&}صبر کن{\c}‬
Dialogue: 0,0:32:37.82,0:32:39.80,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:33:01.34,0:33:37.04,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی دراماتیک{\c}‬
Dialogue: 0,0:33:40.22,0:33:44.28,Standard,,0,0,0,,‫می‌خواهم دقیقاً از همان‌جایی شروع کنم‬\N‫که دیروز بحث را قطع کردیم‬
Dialogue: 0,0:33:44.38,0:33:47.12,Standard,,0,0,0,,‫و از وکیل مدافع می‌خواهم‬\N‫که دفاعیات خود را ارائه دهد‬
Dialogue: 0,0:33:47.22,0:33:50.20,Standard,,0,0,0,,‫{\c&H00FFFF&}ریاست محترم دادگاه، جناب دادستان{\c}‬
Dialogue: 0,0:33:50.30,0:33:53.52,Standard,,0,0,0,,‫{\c&H00FFFF&}کسانی که مانند موکل من{\c}‬\N‫{\c&H00FFFF&}الکساندرا لویفر،{\c}‬
Dialogue: 0,0:33:53.62,0:33:56.36,Standard,,0,0,0,,‫{\c&H00FFFF&}سال‌ها تحت خشونت خانگی{\c}‬\N‫{\c&H00FFFF&}رنج کشیده‌اند،{\c}‬
Dialogue: 0,0:33:56.46,0:34:00.44,Standard,,0,0,0,,‫{\c&H00FFFF&}مانند دیگران زندگی نمی‌کنند{\c}‬\N‫{\c&H00FFFF&}و باید از خود پرسید،{\c}‬
Dialogue: 0,0:34:00.54,0:34:03.68,Standard,,0,0,0,,‫{\c&H00FFFF&}آیا می‌توان از قتل با غافلگیری{\c}‬\N‫{\c&H00FFFF&}سخن گفت؟{\c}‬
Dialogue: 0,0:34:03.78,0:34:07.22,Standard,,0,0,0,,‫{\c&H00FFFF&}حتی اگر، و در این مورد{\c}‬\N‫{\c&H00FFFF&}با شما موافقم جناب دادستان،{\c}‬
Dialogue: 0,0:34:07.34,0:34:11.28,Standard,,0,0,0,,‫{\c&H00FFFF&}طبق رویه قضایی ثابت،{\c}‬\N‫{\c&H00FFFF&}خواب بودن قربانی کافی باشد،{\c}‬
Dialogue: 0,0:34:11.38,0:34:14.38,Standard,,0,0,0,,‫{\c&H00FFFF&}برای تحقق عنصر{\c}‬\N‫{\c&H00FFFF&}غافلگیری در قتل،{\c}‬
Dialogue: 0,0:34:14.46,0:34:17.44,Standard,,0,0,0,,‫{\c&H00FFFF&}دیوان عالی فدرال برای موارد{\c}‬\N‫{\c&H00FFFF&}بسیار خاص پذیرفته است که،{\c}‬
Dialogue: 0,0:34:17.54,0:34:19.84,Standard,,0,0,0,,‫{\c&H00FFFF&}هر قتل غافلگیرانه‌ای{\c}‬\N‫{\c&H00FFFF&}لزوماً{\c}‬
Dialogue: 0,0:34:19.94,0:34:24.24,Standard,,0,0,0,,‫{\c&H00FFFF&}نباید به حبس ابد منجر شود{\c}‬\N‫{\c&H00FFFF&}اینجا نقل‌قول می‌کنم:{\c}‬
Dialogue: 0,0:34:24.34,0:34:28.92,Standard,,0,0,0,,‫{\c&H00FFFF&}«زمانی که عنصر غافلگیری با{\c}‬\N‫{\c&H00FFFF&}عوامل تخفیف‌دهنده همراه باشد،{\c}‬
Dialogue: 0,0:34:29.02,0:34:32.00,Standard,,0,0,0,,‫{\c&H00FFFF&}صدور حکم حبس ابد{\c}‬\N‫{\c&H00FFFF&}ممکن است{\c}‬
Dialogue: 1,0:34:32.10,0:34:41.10,InfoBox,,0,0,0,,{\b1}unverhältnismäßig{\b0}
Dialogue: 0,0:34:32.10,0:34:34.96,Standard,,0,0,0,,‫{\c&H00FFFF&}نامتناسب به نظر برسد»{\c}‬
Dialogue: 0,0:34:35.18,0:34:39.16,Standard,,0,0,0,,‫{\c&H00FFFF&}چنین موردی در اینجا{\c}‬\N‫{\c&H00FFFF&}بدیهی است{\c}‬
Dialogue: 0,0:34:39.26,0:34:43.24,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم لویفر سال‌ها توسط{\c}‬\N‫{\c&H00FFFF&}همسرش تحقیر شده{\c}‬
Dialogue: 0,0:34:43.34,0:34:46.32,Standard,,0,0,0,,‫{\c&H00FFFF&}و مورد آزار قرار گرفته است{\c}‬\N‫{\c&H00FFFF&}او جرئت نکرد{\c}‬
Dialogue: 0,0:34:46.42,0:34:49.40,Standard,,0,0,0,,‫{\c&H00FFFF&}با کسی درددل کند{\c}‬\N‫{\c&H00FFFF&}یا از خود دفاع کند{\c}‬
Dialogue: 0,0:34:49.50,0:34:52.64,Standard,,0,0,0,,‫{\c&H00FFFF&}این وضعیت قطعاً تا مدت‌ها{\c}‬\N‫{\c&H00FFFF&}ادامه می‌یافت، اگر...{\c}‬
Dialogue: 0,0:34:52.74,0:34:54.72,Standard,,0,0,0,,‫{\c&H00FFFF&}همسرش، آقای لویفر،{\c}‬
Dialogue: 0,0:34:54.82,0:34:57.24,Standard,,0,0,0,,‫{\c&H00FFFF&}در شب حادثه تهدید نمی‌کرد که{\c}‬
Dialogue: 0,0:34:57.34,0:35:01.32,Standard,,0,0,0,,‫{\c&H00FFFF&}همین بلا را سر دخترشان ساسکیا{\c}‬\N‫{\c&H00FFFF&}خواهد آورد{\c}‬
Dialogue: 0,0:35:02.46,0:35:06.44,Standard,,0,0,0,,‫{\c&H00FFFF&}و من معتقدم کلید این پرونده{\c}‬\N‫{\c&H00FFFF&}دقیقاً همین‌جاست{\c}‬
Dialogue: 0,0:35:06.54,0:35:09.04,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم لویفر باید فرض می‌کرد{\c}‬
Dialogue: 0,0:35:09.14,0:35:11.12,Standard,,0,0,0,,‫{\c&H00FFFF&}که او این تهدید را عملی می‌کند،{\c}‬
Dialogue: 0,0:35:11.22,0:35:14.12,Standard,,0,0,0,,‫{\c&H00FFFF&}همان‌طور که تمام تهدیدهای دیگرش{\c}‬\N‫{\c&H00FFFF&}را تا آن زمان{\c}‬
Dialogue: 0,0:35:14.22,0:35:16.72,Standard,,0,0,0,,‫{\c&H00FFFF&}عملی کرده بود{\c}‬
Dialogue: 0,0:35:16.82,0:35:19.32,Standard,,0,0,0,,‫{\c&H00FFFF&}خود توماس لویفر را در این پرونده{\c}‬\N‫{\c&H00FFFF&}باید به عنوان{\c}‬
Dialogue: 0,0:35:19.42,0:35:23.56,Standard,,0,0,0,,‫{\c&H00FFFF&}«یک حمله دائمی و قریب‌الوقوع»{\c}‬\N‫{\c&H00FFFF&}دید{\c}‬
Dialogue: 0,0:35:23.66,0:35:27.44,Standard,,0,0,0,,‫{\c&H00FFFF&}حتی اگر آقای لویفر{\c}‬\N‫{\c&H00FFFF&}در زمان وقوع جرم خواب بوده باشد،{\c}‬
Dialogue: 0,0:35:27.54,0:35:30.40,Standard,,0,0,0,,‫{\c&H00FFFF&}حمله‌ای{\c}‬\N‫{\c&H00FFFF&}قریب‌الوقوع در کار بود{\c}‬
Dialogue: 1,0:35:30.50,0:35:39.50,InfoBox,,0,0,0,,{\b1}Notwehr{\b0}
Dialogue: 0,0:35:30.50,0:35:33.40,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم لویفر{\c}‬\N‫{\c&H00FFFF&}در دفاع مشروع عمل کرده است{\c}‬
Dialogue: 0,0:35:33.50,0:35:36.04,Standard,,0,0,0,,‫{\c&H00FFFF&}او دخترش را...{\c}‬
Dialogue: 0,0:35:36.14,0:35:38.92,Standard,,0,0,0,,‫{\c&H00FFFF&}از یک تعرض،{\c}‬\N‫{\c&H00FFFF&}از یک تجاوز{\c}‬
Dialogue: 0,0:35:39.02,0:35:42.60,Standard,,0,0,0,,‫{\c&H00FFFF&}توسط آقای لُوفر{\c}‬\N‫{\c&H00FFFF&}حفظ و محافظت کرد{\c}‬
Dialogue: 0,0:35:45.54,0:35:47.52,Standard,,0,0,0,,‫{\c&H00FFFF&}ریاست محترم دادگاه، جناب دادستان،{\c}‬
Dialogue: 1,0:35:47.62,0:35:56.62,InfoBox,,0,0,0,,{\b1}Plädoyer{\b0}
Dialogue: 1,0:35:47.62,0:35:56.62,InfoBox,,0,0,0,,{\b1}Freispruch{\b0}
Dialogue: 0,0:35:47.62,0:35:51.88,Standard,,0,0,0,,‫{\c&H00FFFF&}دفاعیه به همین دلیل درخواست{\c}‬\N‫{\c&H00FFFF&}تبرئه الکساندرا لُوفر را دارد{\c}‬
Dialogue: 0,0:35:57.94,0:36:00.16,Standard,,0,0,0,,‫متهم آخرین حرفش را می‌زند‬
Dialogue: 0,0:36:00.26,0:36:02.84,Standard,,0,0,0,,‫خانم لُوفر؟‬
Dialogue: 0,0:36:08.50,0:36:12.36,Standard,,0,0,0,,‫دادگاه اکنون برای‬\N‫مشورت تنفس اعلام می‌کند‬
Dialogue: 0,0:36:13.38,0:36:16.24,Standard,,0,0,0,,‫(فلیکس) آنجا یک ساحل است‬
Dialogue: 0,0:36:19.50,0:36:22.08,Standard,,0,0,0,,‫و درختان نخل‬
Dialogue: 0,0:36:25.18,0:36:28.04,Standard,,0,0,0,,‫و آنجا خیلی گرم است‬
Dialogue: 0,0:36:29.18,0:36:32.16,Standard,,0,0,0,,‫دلم می‌خواست الان با تو آنجا باشم‬
Dialogue: 0,0:36:32.26,0:36:35.12,Standard,,0,0,0,,‫{\c&HFFFF00&}تو خیلی احساساتی شدی{\c}‬
Dialogue: 0,0:36:39.30,0:36:42.84,Standard,,0,0,0,,‫{\c&HFFFF00&}شورت من کجاست؟{\c}‬\N‫{\c&HFFFFFF&}چی؟{\c}‬\N‫{\c&HFFFF00&}شورت من{\c}‬
Dialogue: 0,0:36:42.94,0:36:44.72,Standard,,0,0,0,,‫صبر کن‬
Dialogue: 0,0:36:50.74,0:36:53.32,Standard,,0,0,0,,‫این دیگر چیست؟‬
Dialogue: 0,0:36:56.96,0:36:59.52,Standard,,0,0,0,,‫این شوهرت بود؟‬
Dialogue: 0,0:37:00.06,0:37:01.84,Standard,,0,0,0,,‫الکس...‬
Dialogue: 0,0:37:03.66,0:37:06.52,Standard,,0,0,0,,‫ما باید به پلیس برویم‬\N‫{\c&HFFFF00&}نه{\c}‬
Dialogue: 0,0:37:07.98,0:37:10.84,Standard,,0,0,0,,‫{\c&HFFFF00&}وقتی ساسکیا به اندازه کافی بزرگ شد{\c}‬
Dialogue: 0,0:37:14.74,0:37:16.52,Standard,,0,0,0,,‫{\c&HFFFF00&}هی...{\c}‬
Dialogue: 0,0:37:29.34,0:37:33.32,Standard,,0,0,0,,‫(قاضی) به نام ملت‬\N‫حکم زیر صادر می‌شود:‬
Dialogue: 0,0:37:33.42,0:37:36.40,Standard,,0,0,0,,‫متهم،‬\N‫خانم الکساندرا لُوفر،‬
Dialogue: 0,0:37:37.30,0:37:41.28,Standard,,0,0,0,,‫از اتهام قتل‬\N‫توماس لُوفر تبرئه می‌شود‬
Dialogue: 0,0:37:42.90,0:37:44.88,Standard,,0,0,0,,‫{\c&HFF0000&}همهمه نامفهوم{\c}‬
Dialogue: 0,0:37:48.22,0:37:50.88,Standard,,0,0,0,,‫دلیل صدور حکم به شرح زیر است:‬
Dialogue: 0,0:37:50.98,0:37:53.96,Standard,,0,0,0,,‫خانم لویفر‬\N‫در وضعیت دفاع مشروع عمل کرده است‬
Dialogue: 0,0:37:54.22,0:37:57.20,Standard,,0,0,0,,‫کسی که در حین وقوع حمله‬\N‫یا زمانی که حمله قریب‌الوقوع است از خود دفاع کند‬
Dialogue: 0,0:37:57.30,0:38:00.60,Standard,,0,0,0,,‫قابل مجازات نیست‬
Dialogue: 0,0:38:00.70,0:38:03.56,Standard,,0,0,0,,‫خانم لویفر‬\N‫جز این کاری نکرده است‬
Dialogue: 0,0:38:03.66,0:38:06.64,Standard,,0,0,0,,‫او ناچار بود فرض را بر این بگذارد که همسرش‬
Dialogue: 0,0:38:06.74,0:38:09.72,Standard,,0,0,0,,‫در هر لحظه تهدیدی واقعی‬\N‫برای او‬
Dialogue: 0,0:38:09.82,0:38:13.40,Standard,,0,0,0,,‫و دختر خردسالش محسوب می‌شود‬
Dialogue: 0,0:38:13.90,0:38:16.88,Standard,,0,0,0,,‫این یک تصمیم‬\N‫مختص به همین پرونده است‬
Dialogue: 1,0:38:17.74,0:38:26.74,InfoBox,,0,0,0,,{\b1}Haftbefehl{\b0}
Dialogue: 0,0:38:17.74,0:38:21.72,Standard,,0,0,0,,‫دادگاه قرار بازداشت خانم لویفر را لغو می‌کند‬
Dialogue: 1,0:38:22.30,0:38:31.30,InfoBox,,0,0,0,,{\b1}Untersuchungshaft{\b0}
Dialogue: 0,0:38:22.30,0:38:26.88,Standard,,0,0,0,,‫و او را با اثر فوری‬\N‫از بازداشت موقت آزاد می‌نماید‬
Dialogue: 0,0:38:27.14,0:38:30.12,Standard,,0,0,0,,‫ختم جلسه دادرسی اعلام می‌شود‬
Dialogue: 0,0:38:30.42,0:38:32.72,Standard,,0,0,0,,‫{\c&H00FFFF&}برای شما خوشحالم{\c}‬\N‫ممنونم، آقای فریدریش کرونبرگ‬
Dialogue: 0,0:38:32.82,0:38:34.72,Standard,,0,0,0,,‫{\c&H00FFFF&}شما آزاد هستید{\c}‬
Dialogue: 0,0:38:34.82,0:38:37.40,Standard,,0,0,0,,‫{\c&H00FFFF&}بیایید{\c}‬
Dialogue: 0,0:38:46.26,0:38:48.84,Standard,,0,0,0,,‫{\c&H00FFFF&}موفق باشید{\c}‬
Dialogue: 0,0:38:51.26,0:38:53.72,Standard,,0,0,0,,‫بسیار سپاسگزارم‬\N‫{\c&H00FFFF&}خواهش می‌کنم{\c}‬
Dialogue: 0,0:38:53.82,0:38:56.92,Standard,,0,0,0,,‫دفاعیه خوبی بود‬\N‫{\c&H00FFFF&}بسیار متشکرم{\c}‬
Dialogue: 0,0:38:57.02,0:39:01.00,Standard,,0,0,0,,‫دکتر کائولباخ، لطفاً بگذارید‬\N‫این مسائل همین‌جا تمام شود‬
Dialogue: 0,0:39:01.54,0:39:03.12,Standard,,0,0,0,,‫بله‬
Dialogue: 0,0:39:03.90,0:39:06.76,Standard,,0,0,0,,‫موفق باشید‬\N‫{\c&H00FFFF&}روز خوبی داشته باشید{\c}‬
Dialogue: 0,0:39:13.64,0:39:15.60,Standard,,0,0,0,,‫{\c&HFF0000&}همهمه نامفهوم{\c}‬
Dialogue: 0,0:39:36.42,0:39:38.40,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی دراماتیک{\c}‬
Dialogue: 0,0:39:57.02,0:40:00.00,Standard,,0,0,0,,‫{\c&HFFFF00&}«من یک پیراهن خواب سفید تنم بود{\c}‬
Dialogue: 0,0:40:01.34,0:40:04.32,Standard,,0,0,0,,‫{\c&HFFFF00&}نه، من دوش نگرفتم»{\c}‬
Dialogue: 0,0:40:08.26,0:40:10.24,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی دراماتیک{\c}‬
Dialogue: 0,0:40:16.94,0:40:21.52,Standard,,0,0,0,,‫{\c&HFFFF00&}«همیشه به ساسکیا فکر می‌کردم.{\c}‬\N‫{\c&HFFFF00&}او فقط نه سال دارد»{\c}‬
Dialogue: 0,0:40:23.74,0:40:25.72,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی دراماتیک{\c}‬
Dialogue: 0,0:40:50.22,0:40:53.80,Standard,,0,0,0,,‫{\c&HFFFF00&}«منتظر ماندم{\c}‬\N‫{\c&HFFFF00&}تا به خواب برود{\c}‬
Dialogue: 0,0:40:59.14,0:41:02.12,Standard,,0,0,0,,‫{\c&HFFFF00&}مجسمه را برداشتم...{\c}‬
Dialogue: 0,0:41:10.54,0:41:13.52,Standard,,0,0,0,,‫{\c&HFFFF00&}و با آن او را کشتم»{\c}‬
Dialogue: 0,0:41:47.72,0:41:49.68,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬
Dialogue: 0,0:42:13.22,0:42:15.72,Standard,,0,0,0,,‫{\c&H00FFFF&}«سنجش گناه یک انسان{\c}‬\N‫{\c&H00FFFF&}کار دشواری است{\c}‬
Dialogue: 0,0:42:15.82,0:42:17.96,Standard,,0,0,0,,‫{\c&H00FFFF&}ما تمام عمرمان را{\c}‬\N‫{\c&H00FFFF&}در پی خوشبختی هستیم{\c}‬
Dialogue: 0,0:42:18.06,0:42:21.28,Standard,,0,0,0,,‫{\c&H00FFFF&}اما گاهی خودمان را گم می‌کنیم{\c}‬\N‫{\c&H00FFFF&}و اوضاع به بیراهه می‌رود{\c}‬
Dialogue: 0,0:42:21.38,0:42:24.72,Standard,,0,0,0,,‫{\c&H00FFFF&}آنگاه تنها قانون است که ما را{\c}‬\N‫{\c&H00FFFF&}از هرج‌ومرج جدا می‌کند{\c}‬
Dialogue: 0,0:42:24.82,0:42:28.12,Standard,,0,0,0,,‫{\c&H00FFFF&}لایه‌ای نازک از یخ{\c}‬\N‫{\c&H00FFFF&}که زیر آن بسیار سرد است{\c}‬
Dialogue: 0,0:42:28.22,0:42:30.36,Standard,,0,0,0,,‫{\c&H00FFFF&}و مرگ در آن زود فرا می‌رسد»{\c}‬
Dialogue: 0,0:42:30.46,0:42:32.44,Standard,,0,0,0,,‫{\c&HFF0000&}موسیقی{\c}‬