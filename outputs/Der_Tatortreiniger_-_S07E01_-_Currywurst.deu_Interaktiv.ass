Dialogue: 0,0:05:51.27,0:05:53.83,Standard,,0,0,0,,‫{\c&H00FF00&}ولی آثار هنری سالمن{\c}‬
Dialogue: 0,0:05:54.23,0:05:57.75,Standard,,0,0,0,,‫{\c&H00FFFF&}خب اصل کاری همینه{\c}‬\N‫{\c&H00FF00&}اینا همه‌اش اسکولاتی‌یه{\c}‬
Dialogue: 0,0:05:58.51,0:05:59.99,Standard,,0,0,0,,‫{\c&H00FF00&}یه آدم بزرگیه{\c}‬
Dialogue: 0,0:06:00.79,0:06:02.47,Standard,,0,0,0,,‫{\c&H00FF00&}یه آدم خیلی بزرگ{\c}‬
Dialogue: 0,0:06:05.71,0:06:08.07,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی پرانرژی *{\c}‬
Dialogue: 1,0:07:10.71,0:07:21.71,InfoBox,,0,0,0,,{\b1}Lustich{\b0}\N{\c&H00FFFF&}جالبه{\c}
Dialogue: 0,0:07:10.71,0:07:12.27,Standard,,0,0,0,,‫{\c&H00FFFF&}‬\N‫{\u1}جالبه{\u0}‬\N‫{\c}‬
Dialogue: 0,0:07:25.91,0:07:27.71,Standard,,0,0,0,,‫{\c&H00FFFF&}به نظرم قشنگه{\c}‬
Dialogue: 0,0:07:29.23,0:07:32.51,Standard,,0,0,0,,‫{\c&H00FFFF&}یکی رو می‌شناسم{\c}‬\N‫{\c&H00FFFF&}که اونم خوشش میاد، مرله{\c}‬
Dialogue: 0,0:07:32.75,0:07:34.83,Standard,,0,0,0,,‫{\c&H00FFFF&}دوست‌دخترِ فعلیِ سابقم{\c}‬
Dialogue: 0,0:07:34.91,0:07:38.99,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی امیدوارم زن آینده‌ام{\c}‬\N‫{\c&H00FFFF&}و مادر بچه‌هام بشه{\c}‬
Dialogue: 1,0:07:39.11,0:07:50.11,InfoBox,,0,0,0,,{\b1}umhauen{\b0}\N{\c&H00FFFF&}غافلگیرش می‌کنه{\c}
Dialogue: 0,0:07:39.11,0:07:42.51,Standard,,0,0,0,,‫{\c&H00FFFF&}تولدش نزدیکه{\c}‬\N‫{\c&H00FFFF&}یه همچین چیزی‬\N‫{\u1}غافلگیرش می‌کنه{\u0}‬\N‫{\c}‬
Dialogue: 1,0:07:42.59,0:07:53.59,InfoBox,,0,0,0,,{\b1}Furzkissen{\b0}\N{\c&H00FFFF&}بالشتکِ گوز{\c}
Dialogue: 0,0:07:42.59,0:07:46.39,Standard,,0,0,0,,‫{\c&H00FFFF&}معمولاً چیزای کوچیک و خنده‌دار{\c}‬\N‫{\c&H00FFFF&}هدیه می‌دم، مثلاً‬\N‫{\u1}بالشتکِ گوز{\u0}‬\N‫{\c}‬
Dialogue: 0,0:07:46.47,0:07:48.75,Standard,,0,0,0,,‫{\c&H00FFFF&}بعد یهو... واو! هنر{\c}‬
Dialogue: 0,0:07:48.91,0:07:52.07,Standard,,0,0,0,,‫{\c&H00FFFF&}چند درمیاد؟{\c}‬\N‫{\c&H00FF00&}همین‌طوری نمی‌تونم بگم{\c}‬
Dialogue: 0,0:07:52.19,0:07:54.35,Standard,,0,0,0,,‫{\c&H00FFFF&}بیست یورو می‌دم برمی‌دارمش{\c}‬
Dialogue: 0,0:07:54.91,0:07:56.35,Standard,,0,0,0,,‫{\c&H00FFFF&}۵۰! {\c}‬\N‫{\c&H00FF00&}خیلی بامزه‌ای{\c}‬
Dialogue: 0,0:07:56.59,0:08:01.23,Standard,,0,0,0,,‫{\c&H00FF00&}فکر کردی می‌تونی یه تابلو{\c}‬\N‫{\c&H00FF00&}از راون‌باخ رو با ۵۰ یورو بخری؟{\c}‬
Dialogue: 0,0:08:02.67,0:08:06.59,Standard,,0,0,0,,‫{\c&H00FFFF&}خب، تو ۵ یورو دادی{\c}‬\N‫{\c&H00FFFF&}و به نظرت هم افتضاحه{\c}‬
Dialogue: 0,0:08:06.71,0:08:08.23,Standard,,0,0,0,,‫{\c&H00FFFF&}۵۰ که می‌شه ده برابرش{\c}‬
Dialogue: 0,0:08:08.27,0:08:11.07,Standard,,0,0,0,,‫{\c&H00FF00&}مسئله اینه که{\c}‬\N‫{\c&H00FF00&}ارزشش چقدره{\c}‬
Dialogue: 0,0:08:11.27,0:08:14.27,Standard,,0,0,0,,‫{\c&H00FF00&}در حال حاضر...{\c}‬\N‫{\c&H00FF00&}حداقل ۱۰۰۰ یورو می‌ارزه{\c}‬
Dialogue: 0,0:08:14.75,0:08:16.19,Standard,,0,0,0,,‫{\c&H00FFFF&}چی؟ چرا آخه؟{\c}‬
Dialogue: 0,0:08:16.43,0:08:20.07,Standard,,0,0,0,,‫{\c&H00FFFF&}حاضر نبودی ۵ یورو بدی،{\c}‬\N‫{\c&H00FFFF&}حالا می‌خوای ۱۰۰۰ یورو بدی؟{\c}‬
Dialogue: 0,0:08:20.15,0:08:21.95,Standard,,0,0,0,,‫{\c&H00FFFF&}این که داغونه! {\c}‬\N‫{\c&H00FF00&}دقیقاً{\c}‬
Dialogue: 0,0:08:22.71,0:08:26.27,Standard,,0,0,0,,‫{\c&H00FFFF&}باید چسبش زد{\c}‬\N‫{\c&H00FFFF&}و با دقت روش رو رنگ کرد{\c}‬
Dialogue: 0,0:08:26.95,0:08:28.23,Standard,,0,0,0,,‫{\c&H00FF00&}برعکس{\c}‬
Dialogue: 0,0:08:28.31,0:08:31.15,Standard,,0,0,0,,‫{\c&H00FF00&}همین جای گلوله{\c}‬\N‫{\c&H00FF00&}تبدیلش کرده به یه اثر هنری{\c}‬
Dialogue: 0,0:08:31.35,0:08:32.59,Standard,,0,0,0,,‫{\c&H00FFFF&}چی؟{\c}‬
Dialogue: 0,0:08:32.67,0:08:36.99,Standard,,0,0,0,,‫{\c&H00FF00&}اینجوری یه تضاد بین{\c}‬\N‫{\c&H00FF00&}هارمونی و ویرانی ایجاد می‌شه{\c}‬
Dialogue: 0,0:08:37.03,0:08:40.03,Standard,,0,0,0,,‫{\c&H00FF00&}یه جای خالی،{\c}‬\N‫{\c&H00FF00&}که بیننده باید پرش کنه{\c}‬
Dialogue: 0,0:08:40.83,0:08:43.39,Standard,,0,0,0,,‫{\c&H00FF00&}مبهم، گیج‌کننده، آزاردهنده{\c}‬
Dialogue: 0,0:08:43.47,0:08:46.27,Standard,,0,0,0,,‫{\c&H00FFFF&}آزاردهنده بودن{\c}‬\N‫{\c&H00FFFF&}چه فایده‌ای داره؟{\c}‬
Dialogue: 0,0:08:46.91,0:08:48.59,Standard,,0,0,0,,‫{\c&H00FF00&}یه دیدگاه تازه{\c}‬
Dialogue: 1,0:08:49.27,0:09:00.27,InfoBox,,0,0,0,,{\b1}belanglos{\b0}\N{\c&H00FFFF&}بی‌ارزش{\c}
Dialogue: 0,0:08:49.27,0:08:53.03,Standard,,0,0,0,,‫{\c&H00FF00&}هنری که آدم رو آزار نده{\c}‬\N‫{\c&H00FF00&}یا به چالش نکشه،‬\N‫{\u1}بی‌ارزش{\u0}‬\N‫ه{\c}‬
Dialogue: 0,0:08:53.07,0:08:55.63,Standard,,0,0,0,,‫{\c&H00FFFF&}بی‌ارزش یعنی ارزون‌تر؟ {\c}‬\N‫{\c&H00FF00&}آره{\c}‬
Dialogue: 0,0:08:55.83,0:08:59.39,Standard,,0,0,0,,‫{\c&H00FF00&}ولی اینجا{\c}‬\N‫{\c&H00FF00&}چیز بی‌ارزش پیدا نمی‌کنی {\c}‬\N‫{\c&H00FFFF&}اوه{\c}‬
Dialogue: 0,0:08:59.91,0:09:03.07,Standard,,0,0,0,,‫{\c&H00FFFF&}نهایتاً{\c}‬\N‫{\c&H00FFFF&}بتونم بدم...{\c}‬
Dialogue: 0,0:09:04.11,0:09:05.11,Standard,,0,0,0,,‫{\c&H00FFFF&}... ۴۰۰ تا{\c}‬
Dialogue: 0,0:09:05.23,0:09:08.23,Standard,,0,0,0,,‫{\c&H00FF00&}حتماً می‌تونی یه چیزی{\c}‬\N‫{\c&H00FF00&}توی سمساری‌ها پیدا کنی{\c}‬
Dialogue: 0,0:09:08.31,0:09:09.83,Standard,,0,0,0,,‫{\c&H00FF00&}ولی این یکی ۱۰۰۰ تاست{\c}‬
Dialogue: 0,0:09:09.91,0:09:10.99,Standard,,0,0,0,,‫{\c&H00FF00&}تا الان که اینطور بوده{\c}‬
Dialogue: 0,0:09:11.11,0:09:12.95,Standard,,0,0,0,,‫{\c&H00FFFF&}خب... دیگه لازم نیست{\c}‬
Dialogue: 1,0:09:25.59,0:09:36.59,InfoBox,,0,0,0,,{\b1}Boah{\b0}\N{\c&H00FFFF&}یا خدا{\c}
Dialogue: 0,0:09:25.59,0:09:28.75,Standard,,0,0,0,,‫{\c&H00FF00&}‬\N‫{\u1}یا خدا{\u0}‬\N‫!{\c}‬\N‫{\c&H00FF00&}این یه اسکولاتی اصله!{\c}‬
Dialogue: 0,0:09:29.23,0:09:30.51,Standard,,0,0,0,,‫{\c&H00FFFF&}آها...{\c}‬
Dialogue: 0,0:09:30.67,0:09:33.23,Standard,,0,0,0,,‫{\c&H00FFFF&}آره می‌دونم، خیلی خیلی بزرگه{\c}‬
Dialogue: 0,0:09:33.39,0:09:34.83,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی واسه چی؟{\c}‬
Dialogue: 0,0:09:35.83,0:09:40.03,Standard,,0,0,0,,‫{\c&H00FFFF&}اگه قراره هنر{\c}‬\N‫{\c&H00FFFF&}آدم رو تحریک کنه یا بهم بریزه{\c}‬
Dialogue: 0,0:09:40.07,0:09:41.91,Standard,,0,0,0,,‫{\c&H00FFFF&}پس واسه من سواله که:{\c}‬
Dialogue: 0,0:09:41.99,0:09:46.35,Standard,,0,0,0,,‫{\c&H00FFFF&}یه اسکناس ۵ یورویی تقلبی{\c}‬\N‫{\c&H00FFFF&}چه چیز تحریک‌کننده‌ای داره؟{\c}‬
Dialogue: 0,0:09:46.47,0:09:49.11,Standard,,0,0,0,,‫{\c&H00FFFF&}خب، یکی اومده{\c}‬\N‫{\c&H00FFFF&}یه ۵ یورویی جعل کرده{\c}‬
Dialogue: 0,0:09:49.35,0:09:53.27,Standard,,0,0,0,,‫{\c&H00FF00&}ولی این ۵ یورویی{\c}‬\N‫{\c&H00FF00&}از کلی اسکناس یورو درست شده{\c}‬
Dialogue: 0,0:09:53.79,0:09:56.71,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی خب همه می‌دونن{\c}‬\N‫{\c&H00FFFF&}که این پولِ کاردستی‌ایه{\c}‬
Dialogue: 0,0:09:56.79,0:09:59.15,Standard,,0,0,0,,‫{\c&H00FFFF&}واقعی که نیست، واسه همین...{\c}‬
Dialogue: 0,0:10:08.23,0:10:09.95,Standard,,0,0,0,,‫{\c&H00FFFF&}اینا اسکناس‌های واقعی‌ان؟!{\c}‬
Dialogue: 0,0:10:10.31,0:10:13.75,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی... اون اومده{\c}‬\N‫{\c&H00FFFF&}با اسکناس‌های واقعی اینو...{\c}‬
Dialogue: 0,0:10:14.23,0:10:15.95,Standard,,0,0,0,,‫{\c&H00FFFF&}یه صد یورویی واقعی اینجاست؟!{\c}‬
Dialogue: 0,0:10:16.03,0:10:17.47,Standard,,0,0,0,,‫{\c&H00FFFF&}همه‌ش واقعی‌ان؟{\c}‬
Dialogue: 0,0:10:17.75,0:10:20.71,Standard,,0,0,0,,‫{\c&H00FFFF&}اون همه پول پشتش چی؟{\c}‬\N‫{\c&H00FF00&}پانصد یورویی‌ان{\c}‬
Dialogue: 0,0:10:21.71,0:10:24.07,Standard,,0,0,0,,‫{\c&H00FFFF&}اسکناس ۵۰۰ یورویی... به عنوان پس‌زمینه؟!{\c}‬
Dialogue: 0,0:10:24.35,0:10:26.35,Standard,,0,0,0,,‫{\c&H00FFFF&}و... اون ستاره‌ها...{\c}‬
Dialogue: 0,0:10:26.71,0:10:30.07,Standard,,0,0,0,,‫{\c&H00FFFF&}اون دویست یورویی‌ها رو تیکه کرده{\c}‬\N‫{\c&H00FFFF&}فقط واسه چند تا ستاره؟!{\c}‬
Dialogue: 1,0:10:30.59,0:10:41.59,InfoBox,,0,0,0,,{\b1}Ich fass es nicht{\b0}\N{\c&H00FFFF&}باورم نمیشه{\c}
Dialogue: 0,0:10:30.59,0:10:32.15,Standard,,0,0,0,,‫{\c&H00FFFF&}‬\N‫{\u1}باورم نمیشه{\u0}‬\N‫!{\c}‬
Dialogue: 0,0:10:32.23,0:10:34.23,Standard,,0,0,0,,‫{\c&H00FFFF&}این... این دیگه... خب...{\c}‬
Dialogue: 0,0:10:34.55,0:10:37.07,Standard,,0,0,0,,‫{\c&H00FFFF&}اوه، اینا حداقل...{\c}‬
Dialogue: 0,0:10:37.55,0:10:40.83,Standard,,0,0,0,,‫{\c&H00FFFF&}اینا هزاران یوروئه؟!{\c}‬\N‫{\c&H00FF00&}۱۲۰ هزار تا، فقط پولِ کاغذش{\c}‬
Dialogue: 0,0:10:40.95,0:10:44.59,Standard,,0,0,0,,‫{\c&H00FFFF&}صد و بیست هزار یورو برای اینکه{\c}‬\N‫{\c&H00FFFF&}یه اسکناس پنج یورویی رو کپی کنی؟!{\c}‬
Dialogue: 0,0:10:45.79,0:10:48.59,Standard,,0,0,0,,‫{\c&H00FF00&}جذابه، نه؟{\c}‬\N‫{\c&H00FFFF&}نه بابا، این که چرنده{\c}‬
Dialogue: 1,0:10:48.91,0:10:59.91,InfoBox,,0,0,0,,{\b1}Dekadent{\b0}\N{\c&H00FFFF&}فساد{\c}
Dialogue: 0,0:10:48.91,0:10:50.35,Standard,,0,0,0,,‫{\c&H00FFFF&}این عینِ ول‌خرجی و‬\N‫{\u1}فساد{\u0}‬\N‫ه!{\c}‬
Dialogue: 0,0:10:50.43,0:10:53.99,Standard,,0,0,0,,‫{\c&H00FFFF&}به این میگن هنر؟! {\c}‬\N‫{\c&H00FF00&}می‌بینی؟ داره تحریکت می‌کنه{\c}‬
Dialogue: 1,0:10:54.11,0:11:05.11,InfoBox,,0,0,0,,{\b1}bodenlose Frechheit{\b0}\N{\c&H00FFFF&}وقاحتِ بی‌حد و مرز{\c}
Dialogue: 0,0:10:54.11,0:10:56.03,Standard,,0,0,0,,‫{\c&H00FFFF&}یه‬\N‫{\u1}وقاحتِ بی‌حد و مرز{\u0}‬\N‫ه{\c}‬
Dialogue: 0,0:10:56.27,0:10:59.83,Standard,,0,0,0,,‫{\c&H00FFFF&}داره به همه اونایی که واسه{\c}‬\N‫{\c&H00FFFF&}پول جون می‌کنن می‌خنده!{\c}‬
Dialogue: 1,0:10:59.91,0:11:10.91,InfoBox,,0,0,0,,{\b1}Arsch aufreißen{\b0}\N{\c&H00FFFF&}سگ‌دو بزنم{\c}
Dialogue: 0,0:10:59.91,0:11:03.83,Standard,,0,0,0,,‫{\c&H00FFFF&}من واسه همین مقدار پول باید{\c}‬\N‫{\c&H00FFFF&}شش ماه‬\N‫{\u1}سگ‌دو بزنم{\u0}‬\N‫!{\c}‬
Dialogue: 0,0:11:04.11,0:11:06.03,Standard,,0,0,0,,‫{\c&H00FFFF&}اونم با کارِ واقعی!{\c}‬
Dialogue: 0,0:11:06.07,0:11:10.63,Standard,,0,0,0,,‫{\c&H00FFFF&}پول واسه من اسباب‌بازی نیست که{\c}‬\N‫{\c&H00FFFF&}باهاش دیوار صاف کنم{\c}‬
Dialogue: 0,0:11:11.71,0:11:15.55,Standard,,0,0,0,,‫{\c&H00FFFF&}بعد اسمشم میذارن «ارزش‌های واقعی»!{\c}‬\N‫{\c&H00FF00&}من عاشقِ اسکولا‌تی‌ام{\c}‬
Dialogue: 0,0:11:15.59,0:11:17.31,Standard,,0,0,0,,‫{\c&H00FF00&}اون هیچ‌کس رو بی‌تفاوت نمی‌ذاره{\c}‬
Dialogue: 0,0:11:17.83,0:11:20.47,Standard,,0,0,0,,‫{\c&H00FF00&}اون دست می‌ذاره روی{\c}‬\N‫{\c&H00FF00&}واقعیتِ زندگیِ تو{\c}‬
Dialogue: 0,0:11:21.23,0:11:25.87,Standard,,0,0,0,,‫{\c&H00FFFF&}نه! تیکه تیکه کردنِ پول{\c}‬\N‫{\c&H00FFFF&}هیچ ربطی به واقعیتِ من نداره{\c}‬
Dialogue: 0,0:11:26.15,0:11:29.87,Standard,,0,0,0,,‫{\c&H00FFFF&}اصلاً این... این واقعاً{\c}‬\N‫{\c&H00FFFF&}عصبیم می‌کنه! {\c}‬\N‫{\c&H00FF00&}این خوبه{\c}‬
Dialogue: 0,0:11:29.99,0:11:31.31,Standard,,0,0,0,,‫{\c&H00FFFF&}اصلاً هم خوب نیست!{\c}‬
Dialogue: 0,0:11:31.39,0:11:34.23,Standard,,0,0,0,,‫{\c&H00FFFF&}اینکه من عصبانی‌ام{\c}‬\N‫{\c&H00FFFF&}معنیش این نیست که خوبه!{\c}‬
Dialogue: 0,0:11:34.31,0:11:36.87,Standard,,0,0,0,,‫{\c&H00FFFF&}بعضی وقتا هم اصلاً خوب نیست!{\c}‬
Dialogue: 0,0:11:36.91,0:11:41.19,Standard,,0,0,0,,‫{\c&H00FFFF&}من به هنر احترام می‌ذارم، حتی اگه{\c}‬\N‫{\c&H00FFFF&}بیشتر وقتا سر در نیارم{\c}‬
Dialogue: 0,0:11:41.23,0:11:43.39,Standard,,0,0,0,,‫{\c&H00FFFF&}شاید اون‌قدر احمقم که نمی‌فهمم{\c}‬
Dialogue: 0,0:11:43.47,0:11:45.67,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی این یکی! اینو دیگه می‌فهمم{\c}‬
Dialogue: 0,0:11:45.79,0:11:50.51,Standard,,0,0,0,,‫{\c&H00FFFF&}این توهین به اوناییه که{\c}‬\N‫{\c&H00FFFF&}پنج یورو هنوز براشون ارزش داره{\c}‬
Dialogue: 0,0:11:50.59,0:11:51.83,Standard,,0,0,0,,‫{\c&H00FFFF&}صد و بیست هزار یورو!{\c}‬
Dialogue: 0,0:11:51.95,0:11:55.67,Standard,,0,0,0,,‫{\c&H00FFFF&}تازه این قیمتِ خریدش نیست، نه؟{\c}‬\N‫{\c&H00FF00&}معلومه که نه{\c}‬
Dialogue: 0,0:11:55.83,0:11:59.15,Standard,,0,0,0,,‫{\c&H00FFFF&}یه میلیون؟ این همه پول رو{\c}‬\N‫{\c&H00FFFF&}از کجا میاره که هدر بده؟{\c}‬
Dialogue: 0,0:11:59.19,0:12:02.47,Standard,,0,0,0,,‫{\c&H00FF00&}حامیان مالی، بنیادهای خصوصی،{\c}‬\N‫{\c&H00FF00&}بودجه‌های دولتی{\c}‬
Dialogue: 0,0:12:02.63,0:12:05.07,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی منم پولشو دادم؟!{\c}‬
Dialogue: 0,0:12:06.51,0:12:11.03,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی من با پول مالیاتم دادم که{\c}‬\N‫{\c&H00FFFF&}این یارو پول تیکه پاره کنه؟!{\c}‬
Dialogue: 0,0:12:13.15,0:12:15.35,Standard,,0,0,0,,‫{\c&H00FFFF&}من پولمو پس می‌خوام!{\c}‬
Dialogue: 0,0:12:17.71,0:12:19.59,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی پرانرژی *{\c}‬
Dialogue: 0,0:12:44.87,0:12:47.71,Standard,,0,0,0,,‫{\c&H00FF00&}اینکه هنرمند چقدر ازش درمیاره{\c}‬\N‫{\c&H00FF00&}معیار ارزش هنری کار نیست{\c}‬
Dialogue: 0,0:12:47.79,0:12:51.15,Standard,,0,0,0,,‫{\c&H00FF00&}هنرمند چقدر ازش درمیاره{\c}‬\N‫{\c&H00FFFF&}به نظر من که هست{\c}‬
Dialogue: 0,0:12:51.23,0:12:55.87,Standard,,0,0,0,,‫{\c&H00FFFF&}ژست انتقاد اجتماعی می‌گیرن{\c}‬\N‫{\c&H00FFFF&}بعد یه خروار پول به جیب می‌زنن{\c}‬
Dialogue: 0,0:12:55.95,0:12:57.39,Standard,,0,0,0,,‫{\c&H00FF00&}خب چرا نزنن؟{\c}‬
Dialogue: 0,0:12:57.95,0:13:00.11,Standard,,0,0,0,,‫{\c&H00FFFF&}چون اگه نمی‌زدن، کارشون باورپذیرتر بود{\c}‬
Dialogue: 0,0:13:00.67,0:13:03.75,Standard,,0,0,0,,‫{\c&H00FF00&}فقر هنر رو باورپذیرتر می‌کنه؟{\c}‬\N‫{\c&H00FF00&}عجب حرفی{\c}‬
Dialogue: 0,0:13:06.27,0:13:10.55,Standard,,0,0,0,,‫{\c&H00FFFF&}اگه می‌دونستم طرف تمام دار و ندارشو{\c}‬\N‫{\c&H00FFFF&}گذاشته پای این کار{\c}‬
Dialogue: 0,0:13:10.71,0:13:13.15,Standard,,0,0,0,,‫{\c&H00FFFF&}بیشتر بهش احترام می‌ذاشتم{\c}‬
Dialogue: 0,0:13:14.11,0:13:19.11,Standard,,0,0,0,,‫{\c&H00FFFF&}اون‌وقت می‌گفتم واقعاً براش مهم بوده{\c}‬\N‫{\c&H00FFFF&}و حرفی برای گفتن داشته{\c}‬
Dialogue: 0,0:13:19.19,0:13:21.71,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی این‌طوری آدم فقط فکر می‌کنه سرکاریم{\c}‬
Dialogue: 1,0:13:22.39,0:13:33.39,InfoBox,,0,0,0,,{\b1}sich einen Kopp machen{\b0}\N{\c&H00FFFF&}فکر و خیال می‌کنن{\c}
Dialogue: 0,0:13:22.39,0:13:25.91,Standard,,0,0,0,,‫{\c&H00FFFF&}مردم می‌شینن جلوی تابلوهاش{\c}‬\N‫{\c&H00FFFF&}کلی‬\N‫{\u1}فکر و خیال می‌کنن{\u0}‬\N‫{\c}‬
Dialogue: 0,0:13:26.07,0:13:27.99,Standard,,0,0,0,,‫{\c&H00FFFF&}یا حرص می‌خورن{\c}‬
Dialogue: 1,0:13:28.11,0:13:39.11,InfoBox,,0,0,0,,{\b1}sich einen Ast lachen{\b0}\N{\c&H00FFFF&}به ریششون می‌خنده{\c}
Dialogue: 0,0:13:28.11,0:13:32.27,Standard,,0,0,0,,‫{\c&H00FFFF&}اون‌وقت اونم داره‬\N‫{\u1}به ریششون می‌خنده{\u0}‬\N‫{\c}‬\N‫{\c&H00FFFF&}و حساب بانکیشو چک می‌کنه{\c}‬
Dialogue: 0,0:13:32.67,0:13:34.51,Standard,,0,0,0,,‫{\c&H00FF00&}اصلاً مهم نیست{\c}‬
Dialogue: 0,0:13:34.59,0:13:38.11,Standard,,0,0,0,,‫{\c&H00FF00&}هنرمند با چه انگیزه‌ای{\c}‬\N‫{\c&H00FF00&}اثری رو خلق می‌کنه{\c}‬
Dialogue: 0,0:13:38.15,0:13:40.59,Standard,,0,0,0,,‫{\c&H00FF00&}اعتبار کار توی خودِ اثر نهفته‌ست{\c}‬
Dialogue: 0,0:13:41.07,0:13:44.63,Standard,,0,0,0,,‫{\c&H00FFFF&}به نظر من نابود کردن پول{\c}‬\N‫{\c&H00FFFF&}اصلاً اعتبار نداره{\c}‬
Dialogue: 0,0:13:45.71,0:13:47.63,Standard,,0,0,0,,‫{\c&H00FF00&}اون پول رو نابود نکرده{\c}‬
Dialogue: 0,0:13:48.23,0:13:49.67,Standard,,0,0,0,,‫{\c&H00FFFF&}خب، حالا{\c}‬
Dialogue: 0,0:13:50.99,0:13:52.71,Standard,,0,0,0,,‫{\c&H00FF00&}اون چیزی خلق کرده{\c}‬
Dialogue: 0,0:13:55.03,0:13:56.51,Standard,,0,0,0,,‫{\c&H00FF00&}یه چیز جدید{\c}‬
Dialogue: 0,0:13:58.27,0:14:00.43,Standard,,0,0,0,,‫{\c&H00FF00&}ارزش معنوی، همون ایده{\c}‬
Dialogue: 0,0:14:00.83,0:14:02.67,Standard,,0,0,0,,‫{\c&H00FF00&}و ارزش مالی{\c}‬
Dialogue: 0,0:14:02.71,0:14:05.79,Standard,,0,0,0,,‫{\c&H00FF00&}ارزش این تابلو خیلی بیشتر از{\c}‬\N‫{\c&H00FF00&}قیمت مواد اولیه‌شه{\c}‬
Dialogue: 0,0:14:05.87,0:14:08.51,Standard,,0,0,0,,‫{\c&H00FFFF&}چرا از پول تقلبی{\c}‬\N‫{\c&H00FFFF&}استفاده نکرد؟{\c}‬
Dialogue: 0,0:14:09.11,0:14:10.83,Standard,,0,0,0,,‫{\c&H00FF00&}اگه این کارو می‌کرد، ناراحت می‌شدی؟{\c}‬
Dialogue: 0,0:14:11.79,0:14:14.87,Standard,,0,0,0,,‫{\c&H00FFFF&}احتمالاً نه، ولی...{\c}‬\N‫{\c&H00FF00&}خودت داری می‌گی دیگه{\c}‬
Dialogue: 0,0:14:15.51,0:14:18.39,Standard,,0,0,0,,‫{\c&H00FF00&}یه کاردستی بی‌ارزش می‌شد{\c}‬\N‫{\c&H00FF00&}که اصلاً برات مهم نبود{\c}‬
Dialogue: 0,0:14:18.43,0:14:20.43,Standard,,0,0,0,,‫{\c&H00FF00&}و هیچ حسی بهت نمی‌داد{\c}‬
Dialogue: 0,0:14:21.39,0:14:22.75,Standard,,0,0,0,,‫{\c&H00FFFF&}آره خب، شاید{\c}‬
Dialogue: 0,0:14:23.15,0:14:26.87,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی این یکی، این گیلاس، نه{\c}‬\N‫{\c&H00FFFF&}منو هم عصبانی نمی‌کنه{\c}‬
Dialogue: 0,0:14:26.95,0:14:29.23,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی بی‌تفاوت هم از کنارش رد نمی‌شم{\c}‬
Dialogue: 0,0:14:29.35,0:14:32.63,Standard,,0,0,0,,‫{\c&H00FFFF&}منو یاد یه چیزی بین خودم و مرله می‌ندازه{\c}‬\N‫{\c&H00FFFF&}که اصلاً نمی‌تونم{\c}‬
Dialogue: 0,0:14:32.67,0:14:35.23,Standard,,0,0,0,,‫{\c&H00FFFF&}دقیق توصیفش کنم{\c}‬
Dialogue: 0,0:14:35.31,0:14:37.75,Standard,,0,0,0,,‫{\c&H00FFFF&}با خودم می‌گم: آره، ما دقیقاً همین‌جوری هستیم{\c}‬
Dialogue: 0,0:14:37.91,0:14:40.11,Standard,,0,0,0,,‫{\c&H00FFFF&}شاید خیلی خسته‌کننده باشه، ولی...{\c}‬
Dialogue: 0,0:14:40.19,0:14:42.95,Standard,,0,0,0,,‫{\c&H00FFFF&}چرا هنر نمی‌تونه{\c}‬\N‫{\c&H00FFFF&}فقط قشنگ باشه؟{\c}‬
Dialogue: 0,0:14:42.99,0:14:46.27,Standard,,0,0,0,,‫{\c&H00FF00&}به نظرت پول قشنگ نیست؟{\c}‬\N‫{\c&H00FFFF&}چرا، معلومه که هست{\c}‬
Dialogue: 0,0:14:47.91,0:14:50.47,Standard,,0,0,0,,‫{\c&H00FF00&}پول یه متریال بی‌نظیره{\c}‬
Dialogue: 0,0:14:50.55,0:14:52.91,Standard,,0,0,0,,‫{\c&H00FF00&}پویا، اصیل، زنده{\c}‬
Dialogue: 0,0:14:54.03,0:14:55.27,Standard,,0,0,0,,‫{\c&H00FF00&}می‌بینی؟{\c}‬
Dialogue: 0,0:14:55.35,0:14:56.47,Standard,,0,0,0,,‫{\c&H00FF00&}اونجا رو{\c}‬
Dialogue: 0,0:14:56.63,0:15:00.15,Standard,,0,0,0,,‫{\c&H00FF00&}چروک‌های ریز، تغییر رنگ‌ها{\c}‬\N‫{\c&H00FF00&}تاخوردگی‌ها، خط‌خطی‌ها...{\c}‬
Dialogue: 0,0:15:02.03,0:15:04.95,Standard,,0,0,0,,‫{\c&H00FF00&}هر اسکناس هزاران داستان{\c}‬\N‫{\c&H00FF00&}برای گفتن داره{\c}‬
Dialogue: 0,0:15:07.63,0:15:09.99,Standard,,0,0,0,,‫{\c&H00FF00&}خدای من، پول واقعی چقدر قشنگه{\c}‬
Dialogue: 1,0:15:13.59,0:15:24.59,InfoBox,,0,0,0,,{\b1}ausflippen{\b0}\N{\c&H00FFFF&}سکته می‌کنه{\c}
Dialogue: 0,0:15:13.59,0:15:16.15,Standard,,0,0,0,,‫{\c&H00FFFF&}لیسا، زنِ دیدی، اگه بفهمه‬\N‫{\u1}سکته می‌کنه{\u0}‬\N‫{\c}‬
Dialogue: 0,0:15:17.19,0:15:20.31,Standard,,0,0,0,,‫{\c&H00FFFF&}به نظرشون کفر...{\c}‬\N‫{\c&H00FFFF&}آره، کفرگویی محسوب می‌شه{\c}‬
Dialogue: 0,0:15:20.35,0:15:21.63,Standard,,0,0,0,,‫{\c&H00FF00&}چرا آخه؟{\c}‬
Dialogue: 0,0:15:21.79,0:15:24.87,Standard,,0,0,0,,‫{\c&H00FF00&}توی کلیسا{\c}‬\N‫{\c&H00FF00&}پر از صلیب‌های طلاییه{\c}‬
Dialogue: 0,0:15:24.99,0:15:27.35,Standard,,0,0,0,,‫{\c&H00FF00&}اونم به نظرش کفر میاد؟{\c}‬
Dialogue: 0,0:15:27.47,0:15:29.99,Standard,,0,0,0,,‫{\c&H00FFFF&}از این زاویه که نگاه کنی... راست می‌گی، یه چیزی توش هست{\c}‬
Dialogue: 0,0:15:31.35,0:15:34.55,Standard,,0,0,0,,‫{\c&H00FF00&}قبول دارم،{\c}‬\N‫{\c&H00FF00&}پول متریال ارزونی نیست{\c}‬
Dialogue: 0,0:15:35.71,0:15:38.83,Standard,,0,0,0,,‫{\c&H00FF00&}واسه مجسمه «داوود» میکل‌آنژ هم{\c}‬\N‫{\c&H00FF00&}کسی نمی‌پرسید:{\c}‬
Dialogue: 0,0:15:38.91,0:15:43.03,Standard,,0,0,0,,‫{\c&H00FF00&}«حتماً باید این مرمر گرون‌قیمت می‌بود؟{\c}‬\N‫{\c&H00FF00&}با گچ نمی‌شد؟»{\c}‬
Dialogue: 0,0:15:43.15,0:15:44.79,Standard,,0,0,0,,‫{\c&H00FF00&}من عاشق هنر واسه همینم{\c}‬
Dialogue: 0,0:15:44.91,0:15:47.99,Standard,,0,0,0,,‫{\c&H00FF00&}هنر بدون هیچ ملاحظه‌ای{\c}‬\N‫{\c&H00FF00&}از همه چیز عبور می‌کنه،{\c}‬
Dialogue: 0,0:15:48.11,0:15:50.63,Standard,,0,0,0,,‫{\c&H00FF00&}از هر چی که معمولی و سطحیه{\c}‬
Dialogue: 0,0:15:51.23,0:15:54.03,Standard,,0,0,0,,‫{\c&H00FFFF&}حالا چیِ کارِ اسکواتی{\c}‬\N‫{\c&H00FFFF&}این‌قدر غیرمعموله؟{\c}‬
Dialogue: 0,0:15:54.87,0:15:57.15,Standard,,0,0,0,,‫{\c&H00FFFF&}خب آره، ایده‌ش بد نیست{\c}‬
Dialogue: 0,0:15:57.19,0:16:00.39,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی من خودم همچین صلیبی رو{\c}‬\N‫{\c&H00FFFF&}تو سه ساعت برات ردیف می‌کنم{\c}‬
Dialogue: 0,0:16:00.55,0:16:03.47,Standard,,0,0,0,,‫{\c&H00FF00&}هنر رو که{\c}‬\N‫{\c&H00FF00&}بر اساس دستمزد ساعتی نمی‌سنجن{\c}‬
Dialogue: 0,0:16:03.51,0:16:04.87,Standard,,0,0,0,,‫{\c&H00FFFF&}این که معلومه{\c}‬
Dialogue: 0,0:16:04.95,0:16:06.27,Standard,,0,0,0,,‫{\c&H00FFFF&}و منم می‌دونم{\c}‬
Dialogue: 0,0:16:06.39,0:16:10.83,Standard,,0,0,0,,‫{\c&H00FFFF&}که ارزش یه اثر هنری{\c}‬\N‫{\c&H00FFFF&}به این راحتی‌ها مشخص نمی‌شه{\c}‬
Dialogue: 0,0:16:10.95,0:16:13.75,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی مثلاً...{\c}‬\N‫{\c&H00FFFF&}یه تابلویی مثل...{\c}‬
Dialogue: 0,0:16:14.31,0:16:16.03,Standard,,0,0,0,,‫{\c&H00FFFF&}همین مونا لیزا{\c}‬
Dialogue: 0,0:16:16.19,0:16:17.47,Standard,,0,0,0,,‫{\c&H00FF00&}دویست میلیون{\c}‬
Dialogue: 0,0:16:17.59,0:16:20.75,Standard,,0,0,0,,‫{\c&H00FFFF&}چی گفتی؟{\c}‬\N‫{\c&H00FF00&}ارزش بازار فعلیشه{\c}‬\N‫{\c&H00FFFF&}یا خدا{\c}‬
Dialogue: 0,0:16:21.27,0:16:23.19,Standard,,0,0,0,,‫{\c&H00FFFF&}این یکی هنوز یه جوری تو کتم می‌ره{\c}‬
Dialogue: 0,0:16:23.35,0:16:25.27,Standard,,0,0,0,,‫{\c&H00FFFF&}بالاخره تابلوی خفنیه{\c}‬
Dialogue: 0,0:16:25.47,0:16:28.55,Standard,,0,0,0,,‫{\c&H00FFFF&}اینکه دویست میلیون می‌ارزه یا نه{\c}‬\N‫{\c&H00FFFF&}دیگه نمی‌دونم{\c}‬
Dialogue: 0,0:16:28.71,0:16:30.71,Standard,,0,0,0,,‫{\c&H00FFFF&}در هر صورت خوب نقاشی شده{\c}‬
Dialogue: 0,0:16:31.63,0:16:34.19,Standard,,0,0,0,,‫{\c&H00FFFF&}خب، اگه زن بود{\c}‬\N‫{\c&H00FFFF&}سلیقه من نبود{\c}‬
Dialogue: 0,0:16:34.27,0:16:38.11,Standard,,0,0,0,,‫{\c&H00FFFF&}خیلی سر به زیره - و به نظر هم{\c}‬\N‫{\c&H00FFFF&}نمیاد آدم خوش‌مشربی باشه{\c}‬
Dialogue: 0,0:16:38.51,0:16:41.07,Standard,,0,0,0,,‫{\c&H00FFFF&}حداقلش اینه که تکه{\c}‬
Dialogue: 0,0:16:42.35,0:16:46.63,Standard,,0,0,0,,‫{\c&H00FFFF&}واسه همینه که انقدر گرونه، چون{\c}‬\N‫{\c&H00FFFF&}کس دیگه‌ای نمی‌تونه اینو بکشه{\c}‬\N‫{\c&H00FF00&}اصلاً اینطور نیست{\c}‬
Dialogue: 0,0:16:46.75,0:16:49.59,Standard,,0,0,0,,‫{\c&H00FF00&}الان می‌شه جوری کپی‌اش کرد{\c}‬\N‫{\c&H00FF00&}که مو لای درزش نره{\c}‬
Dialogue: 0,0:16:49.75,0:16:54.19,Standard,,0,0,0,,‫{\c&H00FF00&}که کارشناس‌ها باید روزها وقت بذارن{\c}‬\N‫{\c&H00FF00&}تا بفهمن کدوم اصله کدوم کپی{\c}‬
Dialogue: 0,0:16:54.31,0:16:57.75,Standard,,0,0,0,,‫{\c&H00FF00&}هر موزه‌ای می‌تونه{\c}‬\N‫{\c&H00FF00&}مونا لیزای مخصوص خودشو داشته باشه{\c}‬
Dialogue: 0,0:16:58.91,0:17:01.55,Standard,,0,0,0,,‫{\c&H00FFFF&}آره، اگه{\c}‬\N‫{\c&H00FFFF&}آدم بخواد اصلشو ببینه{\c}‬
Dialogue: 0,0:17:01.63,0:17:04.71,Standard,,0,0,0,,‫{\c&H00FF00&}دقیقاً، داوینچی اصل{\c}‬\N‫{\c&H00FF00&}اسکولاتی اصل{\c}‬
Dialogue: 0,0:17:05.31,0:17:08.31,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی فرقش سرِ پوله{\c}‬\N‫{\c&H00FFFF&}که یه نفر یه ایده‌ای داشته{\c}‬
Dialogue: 0,0:17:08.39,0:17:10.11,Standard,,0,0,0,,‫{\c&H00FFFF&}یه ایده‌ای داشته{\c}‬
Dialogue: 0,0:17:10.59,0:17:14.31,Standard,,0,0,0,,‫{\c&H00FFFF&}بعد تونسته یه لابی براش جور کنه{\c}‬\N‫{\c&H00FFFF&}که همه ازش تعریف کنن{\c}‬
Dialogue: 0,0:17:14.47,0:17:16.63,Standard,,0,0,0,,‫{\c&H00FFFF&}یهو شد یه شاهکار هنری{\c}‬
Dialogue: 0,0:17:17.07,0:17:19.63,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی بدون لابی، هیچی ازش نمی‌مونه{\c}‬
Dialogue: 0,0:17:19.71,0:17:24.07,Standard,,0,0,0,,‫{\c&H00FFFF&}در مورد مونا لیزا حداقل{\c}‬\N‫{\c&H00FFFF&}یه نقاشی فوق‌العاده می‌مونه{\c}‬
Dialogue: 0,0:17:24.15,0:17:25.95,Standard,,0,0,0,,‫{\c&H00FFFF&}که آدمو میخکوب می‌کنه{\c}‬
Dialogue: 0,0:17:26.67,0:17:28.51,Standard,,0,0,0,,‫{\c&H00FFFF&}چون نقاشی‌ش خیلی عالیه{\c}‬
Dialogue: 0,0:17:28.63,0:17:30.63,Standard,,0,0,0,,‫{\c&H00FF00&}همین‌طوری الکی؟{\c}‬\N‫{\c&H00FFFF&}آره، همین‌طوری الکی{\c}‬
Dialogue: 0,0:17:30.71,0:17:34.43,Standard,,0,0,0,,‫{\c&H00FF00&}اگه تا حالا اسم مونا لیزا{\c}‬\N‫{\c&H00FF00&}به گوشت نخورده بود...{\c}‬
Dialogue: 0,0:17:34.55,0:17:38.11,Standard,,0,0,0,,‫{\c&H00FF00&}توی یه موزه بین اون همه تابلو{\c}‬\N‫{\c&H00FF00&}فکر می‌کنی{\c}‬
Dialogue: 0,0:17:38.23,0:17:42.67,Standard,,0,0,0,,‫{\c&H00FF00&}مثل برق‌گرفته‌ها دقیقاً{\c}‬\N‫{\c&H00FF00&}جلوی مونا لیزا میخکوب می‌شدی؟{\c}‬
Dialogue: 0,0:17:42.71,0:17:47.11,Standard,,0,0,0,,‫{\c&H00FF00&}همون لحظه می‌فهمیدی{\c}‬\N‫{\c&H00FF00&}که این تابلو چه ابعادی داره؟{\c}‬
Dialogue: 0,0:17:47.19,0:17:48.59,Standard,,0,0,0,,‫{\c&H00FF00&}همین‌طوری الکی؟{\c}‬
Dialogue: 0,0:17:48.67,0:17:51.51,Standard,,0,0,0,,‫{\c&H00FFFF&}خب، شاید نه{\c}‬\N‫{\c&H00FFFF&}تمام ابعادشو{\c}‬
Dialogue: 0,0:17:51.63,0:17:53.63,Standard,,0,0,0,,‫{\c&H00FF00&}شما از کنارش رد می‌شدید {\c}‬\N‫{\c&H00FFFF&}آره{\c}‬
Dialogue: 0,0:18:00.23,0:18:03.59,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی در واقع{\c}‬\N‫{\c&H00FFFF&}مونالیزا اونقدرها هم مالی نیست؟{\c}‬
Dialogue: 0,0:18:03.63,0:18:06.19,Standard,,0,0,0,,‫{\c&H00FFFF&}فقط چون همه میگن خوبه،{\c}‬\N‫{\c&H00FFFF&}ما هم فکر می‌کنیم خوبه؟{\c}‬
Dialogue: 0,0:18:06.27,0:18:09.19,Standard,,0,0,0,,‫{\c&H00FF00&}در حال حاضر شاید{\c}‬\N‫{\c&H00FF00&}۱۱۶ نفر باشن که بتونن{\c}‬
Dialogue: 0,0:18:09.23,0:18:13.43,Standard,,0,0,0,,‫{\c&H00FF00&}با دلیل و مدرک بگن{\c}‬\N‫{\c&H00FF00&}چرا اون یه شاهکاره{\c}‬
Dialogue: 0,0:18:14.87,0:18:16.31,Standard,,0,0,0,,‫{\c&H00FFFF&}مثل قضیه سونیا{\c}‬
Dialogue: 0,0:18:16.55,0:18:17.75,Standard,,0,0,0,,‫{\c&H00FF00&}چی؟{\c}‬
Dialogue: 0,0:18:18.75,0:18:20.31,Standard,,0,0,0,,‫{\c&H00FFFF&}همون زنِ رولاند{\c}‬
Dialogue: 0,0:18:20.39,0:18:24.55,Standard,,0,0,0,,‫{\c&H00FFFF&}وقتی مجرد بود، تو یه مهمونی{\c}‬\N‫{\c&H00FFFF&}نزدیک بود با هم...{\c}‬
Dialogue: 0,0:18:24.63,0:18:27.55,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی اون موقع به نظرم{\c}‬\N‫{\c&H00FFFF&}خیلی جذاب نیومد{\c}‬
Dialogue: 0,0:18:27.71,0:18:30.71,Standard,,0,0,0,,‫{\c&H00FFFF&}گفتم شاید{\c}‬\N‫{\c&H00FFFF&}یه چیز بهتر گیرم بیاد{\c}‬
Dialogue: 0,0:18:30.99,0:18:34.91,Standard,,0,0,0,,‫{\c&H00FFFF&}فرداش رولاند اومد{\c}‬\N‫{\c&H00FFFF&}و حسابی عاشقش شده بود{\c}‬
Dialogue: 0,0:18:35.83,0:18:39.27,Standard,,0,0,0,,‫{\c&H00FFFF&}می‌گفت اون قشنگ‌ترین زنیه{\c}‬\N‫{\c&H00FFFF&}که تا حالا دیده{\c}‬
Dialogue: 0,0:18:39.35,0:18:42.51,Standard,,0,0,0,,‫{\c&H00FFFF&}منم با خودم گفتم{\c}‬\N‫{\c&H00FFFF&}اون که بهتر از این گیرش نمیاد{\c}‬
Dialogue: 0,0:18:42.63,0:18:46.91,Standard,,0,0,0,,‫{\c&H00FFFF&}دیدی ازم پرسید رولاند چطوری{\c}‬\N‫{\c&H00FFFF&}مخ این دخترِ تیکه رو زده{\c}‬
Dialogue: 1,0:18:47.83,0:18:58.83,InfoBox,,0,0,0,,{\b1}Mörderbraut{\b0}\N{\c&H00FFFF&}جیگر{\c}
Dialogue: 0,0:18:47.83,0:18:51.75,Standard,,0,0,0,,‫{\c&H00FFFF&}فریدو هم می‌گفت{\c}‬\N‫{\c&H00FFFF&}سونیا عجب‬\N‫{\u1}جیگر{\u0}‬\N‫یه{\c}‬
Dialogue: 0,0:18:52.47,0:18:55.31,Standard,,0,0,0,,‫{\c&H00FFFF&}از اون موقع به بعد{\c}‬\N‫{\c&H00FFFF&}منم به نظرم خیلی خوشگله{\c}‬
Dialogue: 0,0:18:56.71,0:18:59.55,Standard,,0,0,0,,‫{\c&H00FF00&}هیچ‌کس از نظر دیگران{\c}‬\N‫{\c&H00FF00&}مستقل نیست{\c}‬
Dialogue: 0,0:18:59.71,0:19:01.07,Standard,,0,0,0,,‫{\c&H00FFFF&}در مورد مرله که هست{\c}‬
Dialogue: 0,0:19:01.27,0:19:04.07,Standard,,0,0,0,,‫{\c&H00FFFF&}مرله قشنگ‌ترین زن{\c}‬\N‫{\c&H00FFFF&}توی کل دنیاست{\c}‬
Dialogue: 0,0:19:04.11,0:19:07.95,Standard,,0,0,0,,‫{\c&H00FFFF&}من جزو اون ۱۱۶ نفری‌ام که{\c}‬\N‫{\c&H00FFFF&}می‌تونن با دلیل بگن که...{\c}‬
Dialogue: 0,0:19:08.75,0:19:11.83,Standard,,0,0,0,,‫{\c&H00FFFF&}این قضیه ۱۱۶ نفر{\c}‬\N‫{\c&H00FFFF&}ربطی به...{\c}‬
Dialogue: 0,0:19:14.07,0:19:16.07,Standard,,0,0,0,,‫{\c&H00FF00&}به خوابیدن داره؟ {\c}‬\N‫{\c&H00FFFF&}نه، خب آره{\c}‬
Dialogue: 0,0:19:16.43,0:19:18.95,Standard,,0,0,0,,‫{\c&H00FFFF&}ببین، در مورد مرله من تنها کسی‌ام{\c}‬
Dialogue: 0,0:19:19.15,0:19:22.15,Standard,,0,0,0,,‫{\c&H00FFFF&}که می‌تونه ببینه{\c}‬\N‫{\c&H00FFFF&}اون واقعاً چقدر قشنگه{\c}‬
Dialogue: 0,0:19:22.79,0:19:24.47,Standard,,0,0,0,,‫{\c&H00FF00&}اسپیتس‌وگ دوست داری؟{\c}‬
Dialogue: 0,0:19:25.23,0:19:26.99,Standard,,0,0,0,,‫{\c&H00FFFF&}فعلاً نه، مرسی{\c}‬
Dialogue: 0,0:19:28.43,0:19:29.79,Standard,,0,0,0,,‫{\c&H00FFFF&}مرله‌ی عزیزم{\c}‬
Dialogue: 0,0:19:29.87,0:19:33.15,Standard,,0,0,0,,‫{\c&H00FFFF&}با... با این نقاشی{\c}‬\N‫{\c&H00FFFF&}می‌خوام بهت نشون بدم...{\c}‬
Dialogue: 0,0:19:34.03,0:19:36.47,Standard,,0,0,0,,‫{\c&H00FFFF&}...که تو... که تو برای من...{\c}‬
Dialogue: 0,0:19:36.95,0:19:38.75,Standard,,0,0,0,,‫{\c&H00FFFF&}مرله، یه نگاه به این بنداز{\c}‬
Dialogue: 0,0:19:39.15,0:19:40.35,Standard,,0,0,0,,‫{\c&H00FFFF&}این که دیگه...{\c}‬
Dialogue: 0,0:19:40.87,0:19:41.95,Standard,,0,0,0,,‫{\c&H00FFFF&}برش می‌دارم{\c}‬
Dialogue: 0,0:19:42.03,0:19:43.19,Standard,,0,0,0,,‫{\c&H00FF00&}اوه{\c}‬
Dialogue: 0,0:19:43.31,0:19:47.83,Standard,,0,0,0,,‫{\c&H00FFFF&}کلاً زده بالا از بودجه‌ام،{\c}‬\N‫{\c&H00FFFF&}ولی خب مرله هم زده بالا از...{\c}‬
Dialogue: 0,0:19:47.91,0:19:50.27,Standard,,0,0,0,,‫{\c&H00FFFF&}اگه اینو ببینه غش می‌کنه{\c}‬
Dialogue: 0,0:19:50.39,0:19:52.03,Standard,,0,0,0,,‫{\c&H00FFFF&}بهتره ببریمش تو تخت، نه؟{\c}‬
Dialogue: 0,0:19:52.11,0:19:53.75,Standard,,0,0,0,,‫{\c&H00FFFF&}بی‌خیال، برش می‌دارم{\c}‬
Dialogue: 0,0:19:53.83,0:19:57.67,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی جوری بسته‌بندیش کن{\c}‬\N‫{\c&H00FFFF&}که روش نوشته باشه «گالری راون‌باخ»{\c}‬
Dialogue: 0,0:19:57.79,0:20:00.35,Standard,,0,0,0,,‫{\c&H00FFFF&}که همون لحظه بفهمه:{\c}‬\N‫{\c&H00FFFF&}این یه اثر هنریه{\c}‬
Dialogue: 0,0:20:01.71,0:20:04.27,Standard,,0,0,0,,‫{\c&H00FF00&}آقای کیرشهلیش{\c}‬\N‫{\c&H00FF00&}همین الان فوت کرد{\c}‬
Dialogue: 0,0:20:04.35,0:20:06.47,Standard,,0,0,0,,‫{\c&H00FFFF&}خیلی متاسفم، این...{\c}‬
Dialogue: 0,0:20:06.71,0:20:09.43,Standard,,0,0,0,,‫{\c&H00FF00&}این وضعیتِ{\c}‬\N‫{\c&H00FF00&}تابلو رو عوض می‌کنه{\c}‬
Dialogue: 0,0:20:09.59,0:20:12.95,Standard,,0,0,0,,‫{\c&H00FFFF&}لازم نیست اینو{\c}‬\N‫{\c&H00FFFF&}بکوبم تو صورت مرله{\c}‬
Dialogue: 0,0:20:13.19,0:20:15.43,Standard,,0,0,0,,‫{\c&H00FF00&}الان قیمتش ۵۰۰۰ یوروئه{\c}‬
Dialogue: 0,0:20:17.15,0:20:18.27,Standard,,0,0,0,,‫{\c&H00FF00&}تا الان که اینطوره{\c}‬
Dialogue: 0,0:20:18.31,0:20:22.15,Standard,,0,0,0,,‫{\c&H00FFFF&}یه هنرمند مرده{\c}‬\N‫{\c&H00FFFF&}بیشتر از یه زنده‌اش ارزش داره؟{\c}‬
Dialogue: 0,0:20:23.11,0:20:26.75,Standard,,0,0,0,,‫{\c&H00FF00&}به خاطر این تراژدی، تابلو{\c}‬\N‫{\c&H00FF00&}جذابیت دیگه‌ای پیدا کرده{\c}‬
Dialogue: 0,0:20:27.03,0:20:29.55,Standard,,0,0,0,,‫{\c&H00FFFF&}با بدبختی می‌شه پول بیشتری درآورد{\c}‬
Dialogue: 0,0:20:29.59,0:20:31.95,Standard,,0,0,0,,‫{\c&H00FF00&}من که تقصیری تو این ماجرا ندارم{\c}‬
Dialogue: 0,0:20:31.99,0:20:35.31,Standard,,0,0,0,,‫{\c&H00FF00&}ولی مطمئناً طبق خواسته{\c}‬\N‫{\c&H00FF00&}آقای کیرشهلیش بود{\c}‬
Dialogue: 0,0:20:35.39,0:20:38.11,Standard,,0,0,0,,‫{\c&H00FF00&}که میراثش رو{\c}‬\N‫{\c&H00FF00&}خوب بفروشم{\c}‬
Dialogue: 0,0:20:38.43,0:20:43.07,Standard,,0,0,0,,‫{\c&H00FFFF&}بیشتر از همه طبق خواسته‌اش بود{\c}‬\N‫{\c&H00FFFF&}که یکی از دیدن تابلو لذت ببره{\c}‬
Dialogue: 0,0:20:43.19,0:20:46.39,Standard,,0,0,0,,‫{\c&H00FFFF&}مثل مرله{\c}‬\N‫{\c&H00FF00&}پس باید مجانی می‌دادش{\c}‬
Dialogue: 0,0:20:46.59,0:20:47.87,Standard,,0,0,0,,‫{\c&H00FFFF&}ها؟{\c}‬
Dialogue: 0,0:20:48.55,0:20:49.95,Standard,,0,0,0,,‫{\c&H00FFFF&}آره{\c}‬
Dialogue: 0,0:20:52.75,0:20:56.67,Standard,,0,0,0,,‫{\c&H00FFFF&}اسپری زدم{\c}‬\N‫{\c&H00FFFF&}باید بیست دقیقه بمونه تا اثر کنه{\c}‬
Dialogue: 0,0:20:57.35,0:21:00.19,Standard,,0,0,0,,‫{\c&H00FFFF&}من برم یه سوسیس بزنم{\c}‬\N‫{\c&H00FF00&}حتماً، بفرمایید{\c}‬
Dialogue: 0,0:21:00.71,0:21:02.19,Standard,,0,0,0,,‫{\c&H00FF00&}در رو هم ببند!{\c}‬
Dialogue: 0,0:21:03.03,0:21:05.31,Standard,,0,0,0,,‫{\c&H00FF00&}وگرنه زندگی میاد تو{\c}‬
Dialogue: 0,0:21:05.71,0:21:07.03,Standard,,0,0,0,,‫{\c&H00FFFF&}ها؟{\c}‬
Dialogue: 0,0:21:07.59,0:21:08.71,Standard,,0,0,0,,‫{\c&H00FFFF&}آره{\c}‬
Dialogue: 0,0:21:11.15,0:21:12.27,Standard,,0,0,0,,‫{\c&HFFFF00&}چهار و شصت{\c}‬
Dialogue: 0,0:21:12.35,0:21:14.55,Standard,,0,0,0,,‫{\c&H00FFFF&}اگه الان حساب کنم چی؟{\c}‬\N‫{\c&HFFFF00&}چهار و شصت{\c}‬
Dialogue: 0,0:21:14.59,0:21:15.83,Standard,,0,0,0,,‫{\c&H00FFFF&}بقیه پولش مال خودت{\c}‬
Dialogue: 0,0:21:20.67,0:21:23.23,Standard,,0,0,0,,‫{\c&HFFFF00&}این که روش خط‌خطی شده{\c}‬\N‫{\c&H00FFFF&}جدی؟{\c}‬\N‫{\c&HFFFF00&}آره، اینجا{\c}‬
Dialogue: 0,0:21:23.35,0:21:27.51,Standard,,0,0,0,,‫{\c&H00FFFF&}اصلاً متوجه نشدم{\c}‬\N‫{\c&HFFFF00&}دیگه نداری؟{\c}‬\N‫{\c&H00FFFF&}همینم قبوله{\c}‬
Dialogue: 0,0:21:31.03,0:21:33.59,Standard,,0,0,0,,‫{\c&HFFFF00&}تازه از اون گالری اومدی؟{\c}‬
Dialogue: 0,0:21:33.63,0:21:37.35,Standard,,0,0,0,,‫{\c&HFFFF00&}یکی اونجا کشته شده، نه؟{\c}‬\N‫{\c&H00FFFF&}فکر کنم یه اتفاقی بود{\c}‬
Dialogue: 0,0:21:37.99,0:21:41.43,Standard,,0,0,0,,‫{\c&HFFFF00&}تو هم هنرمندی؟{\c}‬\N‫{\c&H00FFFF&}نه! من پاک‌کننده صحنه جرمم{\c}‬
Dialogue: 0,0:21:41.79,0:21:44.63,Standard,,0,0,0,,‫{\c&H00FFFF&}کار من اونجایی شروع میشه{\c}‬\N‫{\c&H00FFFF&}که بقیه...{\c}‬
Dialogue: 0,0:21:44.91,0:21:48.71,Standard,,0,0,0,,‫{\c&H00FFFF&}وقتی قتلی اتفاق میفته{\c}‬\N‫{\c&H00FFFF&}من میرم خون‌ها رو پاک می‌کنم{\c}‬
Dialogue: 0,0:21:48.83,0:21:50.51,Standard,,0,0,0,,‫{\c&HFFFF00&}یه مرد که کارش تمیزکاریه؟{\c}‬
Dialogue: 0,0:21:51.15,0:21:52.35,Standard,,0,0,0,,‫{\c&H00FFFF&}می‌تونی خودت ببینی{\c}‬
Dialogue: 0,0:21:52.43,0:21:54.75,Standard,,0,0,0,,‫{\c&HFFFF00&}واقعاً تمیزش می‌کنی؟{\c}‬\N‫{\c&H00FFFF&}آره، حتماً{\c}‬
Dialogue: 0,0:21:54.83,0:21:59.15,Standard,,0,0,0,,‫{\c&HFFFF00&}می‌تونی ماشینمو تمیز کنی؟{\c}‬\N‫{\c&H00FFFF&}خب این بیشتر از یه کاری‌ورست برام آب می‌خوره{\c}‬
Dialogue: 0,0:21:59.27,0:22:01.15,Standard,,0,0,0,,‫{\c&HFFFF00&}خوب درمیاری؟{\c}‬\N‫{\c&H00FFFF&}۳۱ و پنجاه{\c}‬
Dialogue: 0,0:22:01.71,0:22:04.71,Standard,,0,0,0,,‫{\c&HFFFF00&}باورم نمیشه{\c}‬\N‫{\c&HFFFF00&}ساعتی ۳۱ و پنجاه؟{\c}‬
Dialogue: 0,0:22:05.43,0:22:08.43,Standard,,0,0,0,,‫{\c&HFFFF00&}زمانی که من نظافت می‌کردم{\c}‬\N‫{\c&HFFFF00&}۶ و پنجاه می‌گرفتم{\c}‬
Dialogue: 0,0:22:09.87,0:22:11.87,Standard,,0,0,0,,‫{\c&HFFFF00&}منم بد تمیز نمی‌کنم{\c}‬
Dialogue: 0,0:22:12.23,0:22:15.67,Standard,,0,0,0,,‫{\c&H00FFFF&}اون تو یه تابلو هست که با پول واقعی درست شده{\c}‬\N‫{\c&H00FFFF&}۱۲۰ هزار یورو{\c}‬
Dialogue: 0,0:22:15.75,0:22:17.55,Standard,,0,0,0,,‫{\c&H00FFFF&}یه میلیون می‌ارزه{\c}‬\N‫{\c&HFFFF00&}جدی؟{\c}‬
Dialogue: 0,0:22:18.43,0:22:20.63,Standard,,0,0,0,,‫{\c&H00FFFF&}تحت تأثیر قرار نگرفتی؟{\c}‬\N‫{\c&HFFFF00&}نه{\c}‬
Dialogue: 0,0:22:21.39,0:22:24.83,Standard,,0,0,0,,‫{\c&HFFFF00&}هر چیزی بالای ۵۰۰ یورو{\c}‬\N‫{\c&HFFFF00&}اصلاً واسه من وجود خارجی نداره{\c}‬
Dialogue: 0,0:22:24.95,0:22:27.75,Standard,,0,0,0,,‫{\c&HFFFF00&}۱۵ هزار یا ۵۰۰ هزار یورو{\c}‬\N‫{\c&HFFFF00&}برام فرقی نداره{\c}‬
Dialogue: 0,0:22:27.79,0:22:31.51,Standard,,0,0,0,,‫{\c&HFFFF00&}ماشین رو دارم{\c}‬\N‫{\c&HFFFF00&}پسره هم به یه جایی رسیده{\c}‬
Dialogue: 0,0:22:31.59,0:22:33.03,Standard,,0,0,0,,‫{\c&HFFFF00&}حیف که مرده رفته{\c}‬
Dialogue: 0,0:22:33.95,0:22:35.67,Standard,,0,0,0,,‫{\c&HFFFF00&}ولی خب، سالمم{\c}‬
Dialogue: 0,0:22:37.07,0:22:40.59,Standard,,0,0,0,,‫{\c&H00FFFF&}اون یه تابلوی توی گالری رو{\c}‬\N‫{\c&H00FFFF&}خیلی دلم می‌خواد داشته باشمش{\c}‬
Dialogue: 0,0:22:40.67,0:22:42.75,Standard,,0,0,0,,‫{\c&H00FFFF&}اولاً که به نظرم قشنگه{\c}‬
Dialogue: 0,0:22:42.99,0:22:45.99,Standard,,0,0,0,,‫{\c&H00FFFF&}دوماً می‌تونم باهاش{\c}‬\N‫{\c&H00FFFF&}یه زنی رو تحت تأثیر قرار بدم{\c}‬
Dialogue: 0,0:22:46.11,0:22:48.03,Standard,,0,0,0,,‫{\c&HFFFF00&}خب خودت براش یه چیزی بکش{\c}‬
Dialogue: 0,0:22:49.95,0:22:52.23,Standard,,0,0,0,,‫{\c&HFFFF00&}مهم اینه که از ته دل باشه{\c}‬
Dialogue: 0,0:22:52.27,0:22:54.19,Standard,,0,0,0,,‫{\c&H00FFFF&}مثل اون سوسیسه، نه؟{\c}‬\N‫{\c&HFFFF00&}دقیقاً{\c}‬
Dialogue: 0,0:22:54.99,0:22:56.43,Standard,,0,0,0,,‫{\c&H00FFFF&}هنوز نون داری؟{\c}‬
Dialogue: 0,0:22:59.11,0:23:01.71,Standard,,0,0,0,,‫{\c&HFFFF00&}نوش جانت، حسابی حالشو ببر{\c}‬
Dialogue: 0,0:23:08.11,0:23:10.75,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی شاد *{\c}‬
Dialogue: 0,0:23:46.59,0:23:47.95,Standard,,0,0,0,,‫{\c&HFFFFFF&}* صدای خش‌خش *{\c}‬
Dialogue: 0,0:24:06.07,0:24:08.63,Standard,,0,0,0,,‫{\c&H00FF00&}اون پنج‌تایی از ست اسکولاتی، آره!{\c}‬
Dialogue: 0,0:24:08.67,0:24:12.03,Standard,,0,0,0,,‫{\c&H00FF00&}امروز کلی آدم{\c}‬\N‫{\c&H00FF00&}اومدن و رفتن{\c}‬
Dialogue: 0,0:24:12.23,0:24:16.67,Standard,,0,0,0,,‫{\c&H00FF00&}شاید از دستش در رفته{\c}‬\N‫{\c&H00FF00&}و یه نفر کش رفته{\c}‬
Dialogue: 0,0:24:17.71,0:24:19.79,Standard,,0,0,0,,‫{\c&H00FF00&}تو! الاناس که برسه!{\c}‬
Dialogue: 0,0:24:22.99,0:24:25.63,Standard,,0,0,0,,‫{\c&H00FFFF&}یه پنج تومنی گفتین؟{\c}‬\N‫{\c&H00FFFF&}اسکناس پنج یورویی؟{\c}‬
Dialogue: 0,0:24:26.03,0:24:28.39,Standard,,0,0,0,,‫{\c&H00FFFF&}نه، اصلاً... حواسم نبود{\c}‬
Dialogue: 0,0:24:28.55,0:24:30.31,Standard,,0,0,0,,‫{\c&H00FFFF&}من چیزی...{\c}‬
Dialogue: 0,0:24:30.59,0:24:32.59,Standard,,0,0,0,,‫{\c&H00FFFF&}چی‌اش این‌قدر خاصه؟{\c}‬
Dialogue: 0,0:24:32.63,0:24:35.91,Standard,,0,0,0,,‫{\c&H00FF00&}یکی از منسجم‌ترین کارهای{\c}‬\N‫{\c&H00FF00&}اسکولاتیه{\c}‬
Dialogue: 0,0:24:35.99,0:24:37.91,Standard,,0,0,0,,‫{\c&H00FF00&}یه مجموعه پولِ امضا شده{\c}‬
Dialogue: 0,0:24:37.99,0:24:40.99,Standard,,0,0,0,,‫{\c&H00FF00&}ولی ارزشش{\c}‬\N‫{\c&H00FF00&}به خاطر کل مجموعه‌ست{\c}‬
Dialogue: 0,0:24:41.07,0:24:43.27,Standard,,0,0,0,,‫{\c&H00FF00&}بدون اون پنج تومنی، هیچی نمی‌ارزه{\c}‬
Dialogue: 0,0:24:43.51,0:24:46.19,Standard,,0,0,0,,‫{\c&H00FFFF&}و با اون پنج تومنی...؟{\c}‬\N‫{\c&H00FF00&}۱۴۲ هزار تا{\c}‬
Dialogue: 0,0:24:46.95,0:24:48.95,Standard,,0,0,0,,‫{\c&H00FF00&}و همین الانم میان ببرنش{\c}‬
Dialogue: 0,0:24:49.07,0:24:50.43,Standard,,0,0,0,,‫{\c&HFFFFFF&}* صدای زنگ تلفن *{\c}‬
Dialogue: 0,0:24:51.39,0:24:52.75,Standard,,0,0,0,,‫{\c&H00FF00&}بله! بفرمایید!{\c}‬
Dialogue: 0,0:24:52.83,0:24:56.19,Standard,,0,0,0,,‫{\c&H00FF00&}نه، پیدا نشده!{\c}‬\N‫{\c&H00FF00&}نمی‌دونم!{\c}‬
Dialogue: 0,0:24:57.95,0:25:00.95,Standard,,0,0,0,,‫{\c&H00FF00&}آره، شاید{\c}‬\N‫{\c&H00FF00&}بهتره یه فکری بکنی!{\c}‬
Dialogue: 0,0:25:06.03,0:25:09.59,Standard,,0,0,0,,‫{\c&H00FFFF&}من اون پنج تومنی رو لازم دارم!{\c}‬\N‫{\c&HFFFF00&}فقط در ازای کوری‌ورست!{\c}‬
Dialogue: 0,0:25:09.63,0:25:11.63,Standard,,0,0,0,,‫{\c&H00FFFF&}شوخی نمی‌کنم، لازمش دارم!{\c}‬
Dialogue: 0,0:25:11.83,0:25:15.71,Standard,,0,0,0,,‫{\c&H00FFFF&}باقیشو بعداً می‌گیرم{\c}‬\N‫{\c&HFFFF00&}نه، می‌تونم یکی دیگه بهت بدم{\c}‬
Dialogue: 0,0:25:15.79,0:25:19.95,Standard,,0,0,0,,‫{\c&H00FFFF&}نه، همونی که روش خط‌خطی داره!{\c}‬\N‫{\c&HFFFF00&}چرا؟{\c}‬\N‫{\c&H00FFFF&}بعداً برات می‌گم! بجنب!{\c}‬
Dialogue: 0,0:25:23.47,0:25:24.79,Standard,,0,0,0,,‫{\c&HFFFF00&}نچ{\c}‬\N‫{\c&H00FFFF&}چی؟{\c}‬
Dialogue: 0,0:25:24.95,0:25:27.91,Standard,,0,0,0,,‫{\c&HFFFF00&}خردش کردم دادم رفت{\c}‬\N‫{\c&H00FFFF&}چی؟! به کی دادی؟!{\c}‬
Dialogue: 0,0:25:29.55,0:25:32.27,Standard,,0,0,0,,‫{\c&HFFFF00&}همین چند لحظه پیش یکی{\c}‬\N‫{\c&HFFFF00&}با یه بیست تومنی حساب کرد{\c}‬
Dialogue: 0,0:25:32.59,0:25:34.75,Standard,,0,0,0,,‫{\c&H00FFFF&}کدوم طرفی رفت؟{\c}‬\N‫{\c&HFFFF00&}اون طرف{\c}‬
Dialogue: 0,0:25:37.47,0:25:39.15,Standard,,0,0,0,,‫{\c&H00FFFF&}چی تنش بود؟!{\c}‬
Dialogue: 0,0:25:39.31,0:25:40.91,Standard,,0,0,0,,‫{\c&HFFFF00&}کت، شلوار، معمولی{\c}‬
Dialogue: 0,0:25:43.95,0:25:45.47,Standard,,0,0,0,,‫{\c&H00FFFF&}چیز مشکوکی نبود؟{\c}‬
Dialogue: 0,0:25:45.91,0:25:47.19,Standard,,0,0,0,,‫{\c&HFFFF00&}موتور{\c}‬
Dialogue: 0,0:25:56.51,0:25:57.99,Standard,,0,0,0,,‫{\c&H00FFFF&}ای بابا، گندش بزنه{\c}‬
Dialogue: 0,0:25:58.47,0:26:00.19,Standard,,0,0,0,,‫{\c&H00FFFF&}اوه، چه گندی{\c}‬
Dialogue: 0,0:26:01.27,0:26:02.55,Standard,,0,0,0,,‫{\c&H00FFFF&}یه گندِ حسابی{\c}‬
Dialogue: 0,0:26:03.11,0:26:05.11,Standard,,0,0,0,,‫{\c&H00FFFF&}گندش بزنه، گندش بزنه، گندش بزنه{\c}‬
Dialogue: 0,0:26:05.79,0:26:07.75,Standard,,0,0,0,,‫{\c&H00FFFF&}ای بابا، عجب گندکاری‌ایه{\c}‬
Dialogue: 0,0:26:08.03,0:26:09.55,Standard,,0,0,0,,‫{\c&H00FFFF&}لعنت به این گندکاری{\c}‬
Dialogue: 1,0:26:10.31,0:26:21.31,InfoBox,,0,0,0,,{\b1}Scheißdreck{\b0}\N{\c&H00FFFF&}آشغالِ عوضی{\c}
Dialogue: 0,0:26:10.31,0:26:11.75,Standard,,0,0,0,,‫{\c&H00FFFF&}‬\N‫{\u1}آشغالِ عوضی{\u0}‬\N‫{\c}‬
Dialogue: 0,0:26:13.43,0:26:14.91,Standard,,0,0,0,,‫{\c&H00FFFF&}ای وای، گندش بزنه{\c}‬
Dialogue: 0,0:26:17.11,0:26:18.83,Standard,,0,0,0,,‫{\c&H00FFFF&}فکر کنم باید...{\c}‬
Dialogue: 0,0:26:21.07,0:26:23.91,Standard,,0,0,0,,‫{\c&H00FFFF&}باید یه اعترافی بکنم -{\c}‬\N‫{\c&H00FFFF&}در مورد اون اسکناس پنج تومنی{\c}‬
Dialogue: 0,0:26:24.87,0:26:28.71,Standard,,0,0,0,,‫{\c&H00FF00&}پیدا شد {\c}‬\N‫{\c&H00FFFF&}چی؟!{\c}‬\N‫{\c&H00FF00&}افتاده بود زیر پیشخوان{\c}‬
Dialogue: 0,0:26:28.83,0:26:30.27,Standard,,0,0,0,,‫{\c&H00FFFF&}آره ولی... اون...{\c}‬
Dialogue: 0,0:26:30.39,0:26:32.39,Standard,,0,0,0,,‫{\c&H00FFFF&}این... {\c}‬\N‫{\c&H00FF00&}خیلی شانس آوردی{\c}‬
Dialogue: 0,0:26:33.31,0:26:35.67,Standard,,0,0,0,,‫{\c&H00FF00&}فکر کردم دزدیده شده{\c}‬
Dialogue: 0,0:26:41.07,0:26:43.15,Standard,,0,0,0,,‫{\c&H00FF00&}استراحتتون تموم شد؟{\c}‬
Dialogue: 0,0:26:44.03,0:26:45.19,Standard,,0,0,0,,‫{\c&H00FFFF&}آره{\c}‬
Dialogue: 0,0:26:45.27,0:26:46.43,Standard,,0,0,0,,‫{\c&H00FFFF&}سلام{\c}‬
Dialogue: 0,0:26:46.63,0:26:47.95,Standard,,0,0,0,,‫{\c&H00FF00&}خب{\c}‬
Dialogue: 0,0:26:48.19,0:26:50.83,Standard,,0,0,0,,‫{\c&H00FF00&}باید اینو امضا کنید{\c}‬\N‫{\c&H00FF00&}که تحویل گرفتید{\c}‬
Dialogue: 0,0:26:50.91,0:26:53.99,Standard,,0,0,0,,‫{\c&H00FF00&}و سلب مسئولیت رو هم{\c}‬\N‫{\c&H00FF00&}تایید کنید{\c}‬
Dialogue: 0,0:26:55.27,0:26:57.63,Standard,,0,0,0,,‫{\c&H00FF00&}واقعاً هدیه خاصیه{\c}‬
Dialogue: 0,0:26:57.67,0:26:59.59,Standard,,0,0,0,,‫{\c&H00FF00&}شوهرتون کلی ذوق می‌کنه{\c}‬
Dialogue: 0,0:26:59.63,0:27:03.79,Standard,,0,0,0,,‫{\c&HFFFFFF&}وگرنه دوباره یه زیرسیگاری{\c}‬\N‫{\c&HFFFFFF&}گیرش میاد، مثل هر سال{\c}‬
Dialogue: 0,0:27:03.95,0:27:05.75,Standard,,0,0,0,,‫{\c&HFFFFFF&}خداحافظ {\c}‬\N‫{\c&H00FF00&}خداحافظ{\c}‬
Dialogue: 0,0:27:11.87,0:27:13.03,Standard,,0,0,0,,‫{\c&H00FFFF&}خانم راون‌باخ؟{\c}‬
Dialogue: 0,0:27:13.15,0:27:15.43,Standard,,0,0,0,,‫{\c&H00FFFF&}من... من دیگه رفع زحمت می‌کنم، خب؟{\c}‬
Dialogue: 0,0:27:17.11,0:27:18.43,Standard,,0,0,0,,‫{\c&H00FF00&}صبر کنید{\c}‬
Dialogue: 0,0:27:20.03,0:27:22.59,Standard,,0,0,0,,‫{\c&H00FF00&}بفرمایید {\c}‬\N‫{\c&H00FFFF&}اوه، ممنون{\c}‬
Dialogue: 0,0:27:23.43,0:27:27.75,Standard,,0,0,0,,‫{\c&H00FFFF&}خوشبختانه اون اسکناس پنج‌تومنی اسکالاتی{\c}‬\N‫{\c&H00FFFF&}برگشت {\c}‬\N‫{\c&H00FF00&}دقیقاً همین‌طوره{\c}‬
Dialogue: 0,0:27:27.83,0:27:30.35,Standard,,0,0,0,,‫{\c&H00FFFF&}وگرنه به دردسر می‌افتادید{\c}‬
Dialogue: 0,0:27:30.67,0:27:34.31,Standard,,0,0,0,,‫{\c&H00FF00&}کسی که اون رو دزدیده بود،{\c}‬\N‫{\c&H00FF00&}به دردسر می‌افتاد{\c}‬
Dialogue: 0,0:27:36.67,0:27:39.51,Standard,,0,0,0,,‫{\c&H00FFFF&}در هر صورت{\c}‬\N‫{\c&H00FFFF&}کلی چیز یاد گرفتم{\c}‬
Dialogue: 0,0:27:39.55,0:27:41.55,Standard,,0,0,0,,‫{\c&H00FFFF&}درباره هنر و اصل بودن کارها...{\c}‬
Dialogue: 0,0:27:41.59,0:27:45.59,Standard,,0,0,0,,‫{\c&H00FFFF&}این قشنگیِ کار منه:{\c}‬\N‫{\c&H00FFFF&}آدم همیشه یه چیزی یاد می‌گیره{\c}‬
Dialogue: 0,0:27:45.67,0:27:48.19,Standard,,0,0,0,,‫{\c&H00FFFF&}شاید یه روز یه کتاب نوشتم{\c}‬
Dialogue: 0,0:27:48.31,0:27:49.55,Standard,,0,0,0,,‫{\c&H00FF00&}راستی:{\c}‬
Dialogue: 0,0:27:49.63,0:27:52.99,Standard,,0,0,0,,‫{\c&H00FF00&}اون تابلویی که بهش{\c}‬\N‫{\c&H00FF00&}علاقه داری... {\c}‬\N‫{\c&H00FFFF&}بله؟{\c}‬
Dialogue: 0,0:27:53.11,0:27:56.23,Standard,,0,0,0,,‫{\c&H00FF00&}نمی‌خوام از مرگ کیرشرلیش{\c}‬\N‫{\c&H00FF00&}پولی به جیب بزنم{\c}‬
Dialogue: 0,0:27:56.35,0:27:59.91,Standard,,0,0,0,,‫{\c&H00FFFF&}عجیبه برام{\c}‬\N‫{\c&H00FF00&}با ۵ یورو می‌تونی صاحبش بشی{\c}‬
Dialogue: 0,0:28:00.11,0:28:01.39,Standard,,0,0,0,,‫{\c&H00FFFF&}قبوله، برداشتمش{\c}‬
Dialogue: 0,0:28:02.59,0:28:04.95,Standard,,0,0,0,,‫{\c&HFFFF00&}بیا! شانس آوردی که!{\c}‬
Dialogue: 0,0:28:05.11,0:28:08.95,Standard,,0,0,0,,‫{\c&HFFFF00&}اون یارو با موتور برگشت،{\c}‬\N‫{\c&HFFFF00&}منم دنبالش دویدم...{\c}‬
Dialogue: 0,0:28:09.19,0:28:11.63,Standard,,0,0,0,,‫{\c&H00FFFF&}کدوم موتور؟ چی داری می‌گی؟{\c}‬
Dialogue: 0,0:28:11.87,0:28:13.27,Standard,,0,0,0,,‫{\c&HFFFF00&}همون موتورسواره!{\c}‬
Dialogue: 0,0:28:13.39,0:28:15.91,Standard,,0,0,0,,‫{\c&HFFFF00&}با اون پنج‌تومنی...{\c}‬\N‫{\c&H00FFFF&}من اصلاً موتور ندارم!{\c}‬
Dialogue: 0,0:28:17.19,0:28:20.83,Standard,,0,0,0,,‫{\c&HFFFF00&}همین الان گفتی...{\c}‬\N‫{\c&H00FFFF&}موتور رو می‌خوام چیکار آخه؟!{\c}‬
Dialogue: 0,0:28:21.11,0:28:22.35,Standard,,0,0,0,,‫{\c&H00FFFF&}همین چند لحظه پیش هم گفتی{\c}‬
Dialogue: 0,0:28:22.43,0:28:24.87,Standard,,0,0,0,,‫{\c&H00FFFF&}موتور، موتور، من موتور نمی‌خوام!{\c}‬
Dialogue: 0,0:28:26.07,0:28:29.71,Standard,,0,0,0,,‫{\c&HFFFF00&}شما همین الان...{\c}‬\N‫{\c&H00FFFF&}بد متوجه شدی{\c}‬
Dialogue: 0,0:28:29.79,0:28:32.15,Standard,,0,0,0,,‫{\c&H00FFFF&}انگار باید واضح‌تر بگم{\c}‬
Dialogue: 0,0:28:33.67,0:28:35.75,Standard,,0,0,0,,‫{\c&H00FFFF&}تو اصلاً تیپ من نیستی!{\c}‬
Dialogue: 0,0:28:36.03,0:28:37.55,Standard,,0,0,0,,‫{\c&H00FFFF&}لطفاً برو بیرون{\c}‬
Dialogue: 0,0:28:39.59,0:28:42.11,Standard,,0,0,0,,‫{\c&HFFFF00&}اما...{\c}‬\N‫{\c&H00FFFF&}من خریدنی نیستم{\c}‬
Dialogue: 0,0:28:42.23,0:28:43.67,Standard,,0,0,0,,‫{\c&H00FF00&}اجازه هست؟{\c}‬\N‫{\c&H00FFFF&}نه{\c}‬
Dialogue: 0,0:28:44.83,0:28:47.79,Standard,,0,0,0,,‫{\c&H00FF00&}شبیه امضای{\c}‬\N‫{\c&H00FF00&}اسکولاتی به نظر میاد{\c}‬
Dialogue: 0,0:28:47.87,0:28:49.83,Standard,,0,0,0,,‫{\c&H00FFFF&}چی؟! امکان نداره{\c}‬
Dialogue: 0,0:28:49.95,0:28:52.07,Standard,,0,0,0,,‫{\c&H00FFFF&}این... واقعاً...{\c}‬
Dialogue: 0,0:28:52.63,0:28:56.07,Standard,,0,0,0,,‫{\c&H00FFFF&}این... پس باید{\c}‬\N‫{\c&H00FFFF&}یه جعل باشه{\c}‬
Dialogue: 0,0:28:56.71,0:29:00.07,Standard,,0,0,0,,‫{\c&H00FFFF&}اصلِ اسکولاتی که...{\c}‬\N‫{\c&H00FF00&}توی اون ست شیشه‌ایه{\c}‬
Dialogue: 0,0:29:00.31,0:29:02.23,Standard,,0,0,0,,‫{\c&H00FF00&}آره، این یه جله{\c}‬
Dialogue: 0,0:29:02.91,0:29:05.07,Standard,,0,0,0,,‫{\c&H00FF00&}اونم یه جعلِ ناشیانه{\c}‬
Dialogue: 0,0:29:05.19,0:29:07.35,Standard,,0,0,0,,‫{\c&H00FF00&}خودت جعلش کردی؟{\c}‬\N‫{\c&HFFFF00&}من؟!{\c}‬
Dialogue: 0,0:29:07.43,0:29:09.27,Standard,,0,0,0,,‫{\c&HFFFF00&}من اصلاً...{\c}‬
Dialogue: 0,0:29:09.31,0:29:11.95,Standard,,0,0,0,,‫{\c&H00FF00&}سعی نکن یه اسکولاتیِ{\c}‬\N‫{\c&H00FF00&}جعلی رو{\c}‬
Dialogue: 0,0:29:12.03,0:29:14.87,Standard,,0,0,0,,‫{\c&H00FF00&}با نیت کلاهبرداری{\c}‬\N‫{\c&H00FF00&}بفروشی{\c}‬
Dialogue: 0,0:29:15.07,0:29:18.55,Standard,,0,0,0,,‫{\c&HFFFF00&}گوشام اشتباه می‌شنوه، من...{\c}‬\N‫{\c&H00FF00&}خداحافظ{\c}‬
