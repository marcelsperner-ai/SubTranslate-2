Dialogue: 0,0:00:32.57,0:00:35.78,Standard,,0,0,0,,‫نمی‌خوام بگم‬\N‫حقش بود‬
Dialogue: 0,0:00:36.41,0:00:38.62,Standard,,0,0,0,,‫ولی دلم هم براش نمی‌سوزه‬
Dialogue: 1,0:00:38.70,0:00:49.70,InfoBox,,0,0,0,,{\b1}so 'ne Anständige{\b0}\N{\c&H00FFFF&}خیلی خانم محترم و خوبیه{\c}
Dialogue: 0,0:00:38.70,0:00:42.45,Standard,,0,0,0,,‫خانم دانویچ که اینجا زندگی می‌کنه‬\N‫{\u1}خیلی خانم محترم و خوبیه{\u0}‬
Dialogue: 0,0:00:43.66,0:00:45.45,Standard,,0,0,0,,‫همین‌جوری هم کلی بدبختی داره‬
Dialogue: 0,0:00:45.83,0:00:50.08,Standard,,0,0,0,,‫بعد یه نفر می‌خواد ازش دزدی کنه‬\N‫و شاید کارهای بدتر‬
Dialogue: 0,0:00:50.46,0:00:55.21,Standard,,0,0,0,,‫دلسوزیم رو نگه می‌دارم برای‬\N‫کسی که واقعاً ارزشش رو داشته باشه‬
Dialogue: 0,0:00:56.68,0:00:58.89,Standard,,0,0,0,,‫مثلاً همین، این آقا‬
Dialogue: 0,0:00:59.05,0:01:01.19,Standard,,0,0,0,,‫- شوهر خانم دانویچ؟‬\N‫- پسرش‬
Dialogue: 1,0:01:01.24,0:01:12.24,InfoBox,,0,0,0,,{\b1}Donnerwetter{\b0}\N{\c&H00FFFF&}عجب{\c}
Dialogue: 0,0:01:01.24,0:01:03.42,Standard,,0,0,0,,‫-‬\N‫{\u1}عجب{\u0}‬\N‫- ماتیس‬
Dialogue: 0,0:01:03.61,0:01:05.03,Standard,,0,0,0,,‫فقط ۳۴ سالش بود‬
Dialogue: 0,0:01:05.08,0:01:06.60,Standard,,0,0,0,,‫<i>این</i> یه تراژدیه‬
Dialogue: 0,0:01:06.85,0:01:10.97,Standard,,0,0,0,,‫ولی یه دزد که حین کار تصادف کرده‬\N‫اشک منو درنمیاره‬
Dialogue: 0,0:01:11.08,0:01:16.03,Standard,,0,0,0,,‫بذار این‌طوری بگم: اگه فقط‬\N‫پاش شکسته بود...‬
Dialogue: 0,0:01:16.32,0:01:19.68,Standard,,0,0,0,,‫اینکه سرش ضربه دیده‬\N‫خب بدشانسی بوده‬
Dialogue: 0,0:01:20.03,0:01:24.49,Standard,,0,0,0,,‫شاید حقش نبوده، ولی به نظر من‬\N‫تراژدی هم نیست‬
Dialogue: 0,0:01:25.00,0:01:28.03,Standard,,0,0,0,,‫تازه این دزدی‌ها هم‬\N‫روز به روز بدتر می‌شه‬
Dialogue: 0,0:01:28.12,0:01:33.15,Standard,,0,0,0,,‫می‌گن جوون‌ها هم که‬\N‫هیچ آینده‌ای ندارن‬
Dialogue: 0,0:01:33.20,0:01:35.90,Standard,,0,0,0,,‫و همه‌شون هم‬\N‫یه بچگیِ داغون داشتن‬
Dialogue: 0,0:01:36.07,0:01:41.09,Standard,,0,0,0,,‫ولی اگه مسابقه «بچگیِ داغون» باشه‬\N‫منم می‌تونم شرکت کنم‬
Dialogue: 1,0:01:41.18,0:01:52.18,InfoBox,,0,0,0,,{\b1}aus mir ist was geworden{\b0}\N{\c&H00FFFF&}من بالاخره یه چیزی شدم{\c}
Dialogue: 0,0:01:41.18,0:01:43.15,Standard,,0,0,0,,‫ولی‬\N‫{\u1}من بالاخره یه چیزی شدم{\u0}‬
Dialogue: 0,0:01:43.42,0:01:46.97,Standard,,0,0,0,,‫اصلاً کارِ دقیقِ یه پاک‌کننده صحنه جرم‬\N‫چی هست؟‬
Dialogue: 0,0:01:53.32,0:01:54.82,Standard,,0,0,0,,‫امروز چت شده؟‬
Dialogue: 0,0:01:54.87,0:01:56.55,Standard,,0,0,0,,‫یه قاشق، به خاطر من‬
Dialogue: 0,0:01:57.41,0:02:00.76,Standard,,0,0,0,,‫یه قاشق دیگه هم برای‬\N‫آقای رایشرت از بیمه درمانی‬
Dialogue: 0,0:02:00.81,0:02:04.23,Standard,,0,0,0,,‫تا بلکه یه کمک‌هزینه برای‬\N‫یه وانِ درست و حسابی بدن‬
Dialogue: 0,0:02:07.46,0:02:09.27,Standard,,0,0,0,,‫و یه قاشق دیگه!‬
Dialogue: 0,0:02:11.24,0:02:13.57,Standard,,0,0,0,,‫تغذیه اصلیش‬\N‫از طریق لوله انجام می‌شه‬
Dialogue: 0,0:02:13.65,0:02:17.31,Standard,,0,0,0,,‫ولی شاید هنوز‬\N‫حس چشایی داشته باشه‬
Dialogue: 1,0:02:17.57,0:02:28.57,InfoBox,,0,0,0,,{\b1}Milchpampe{\b0}\N{\c&H00FFFF&}فرنیِ شیر{\c}
Dialogue: 0,0:02:17.57,0:02:19.59,Standard,,0,0,0,,‫بعد شما بهش‬\N‫{\u1}فرنیِ شیر{\u0}‬\N‫می‌دین؟‬
Dialogue: 0,0:02:20.39,0:02:22.55,Standard,,0,0,0,,‫اوه! این دیگه چه کاریه؟‬
Dialogue: 0,0:02:22.63,0:02:26.47,Standard,,0,0,0,,‫می‌خوای به سینه‌ام دست بزنی؟‬\N‫اصلاً خوشم نمیاد‬
Dialogue: 0,0:02:30.28,0:02:33.08,Standard,,0,0,0,,‫خب، دو تا قاشق دیگه، دهنت رو باز کن!‬
Dialogue: 0,0:02:34.52,0:02:36.22,Standard,,0,0,0,,‫خیلی وقته این‌طوریه؟‬
Dialogue: 0,0:02:36.33,0:02:39.59,Standard,,0,0,0,,‫شش ساله، ولی من چهار ساله می‌شناسمش‬
Dialogue: 0,0:02:39.82,0:02:42.48,Standard,,0,0,0,,‫خیلی زمان طولانیه، نه؟‬
Dialogue: 0,0:02:44.14,0:02:45.80,Standard,,0,0,0,,‫تنهایی با قایق رفته بود بیرون،‬
Dialogue: 0,0:02:45.85,0:02:48.23,Standard,,0,0,0,,‫ظاهراً پاش لیز خورده،‬\N‫سرش خورده به جایی‬
Dialogue: 0,0:02:48.31,0:02:51.33,Standard,,0,0,0,,‫تازه فرداش‬\N‫قایق رو پیدا کردن‬
Dialogue: 1,0:02:52.74,0:03:03.74,InfoBox,,0,0,0,,{\b1}banal{\b0}\N{\c&H00FFFF&}خیلی مسخره‌ست{\c}
Dialogue: 0,0:02:52.74,0:02:54.27,Standard,,0,0,0,,‫{\u1}خیلی مسخره‌ست{\u0}‬\N‫، نه؟‬
Dialogue: 0,0:02:54.56,0:02:57.53,Standard,,0,0,0,,‫پات لیز بخوره، بیفتی،‬\N‫دیگه هیچی مثل قبل نشه‬
Dialogue: 0,0:02:57.63,0:02:59.21,Standard,,0,0,0,,‫حرف آدم رو می‌فهمه؟‬
Dialogue: 0,0:02:59.33,0:03:02.07,Standard,,0,0,0,,‫دکترا میگن‬\N‫غیرممکنه‬
Dialogue: 0,0:03:02.40,0:03:05.91,Standard,,0,0,0,,‫مامانش قسم می‌خوره که همه‌چی رو می‌فهمه،‬\N‫داداشش میگه اصلاً این‌طور نیست‬
Dialogue: 0,0:03:05.96,0:03:11.73,Standard,,0,0,0,,‫یه انرژی‌درمانگر می‌خواست‬\N‫از طریق ارتعاشات متا باهاش ارتباط بگیره‬
Dialogue: 0,0:03:13.10,0:03:14.35,Standard,,0,0,0,,‫نظر شما چیه؟‬
Dialogue: 0,0:03:14.44,0:03:19.03,Standard,,0,0,0,,‫اون بیشتر از گلدون‌های اتاق من‬\N‫از دنیا چیزی نمی‌فهمه‬
Dialogue: 0,0:03:19.62,0:03:22.46,Standard,,0,0,0,,‫ولی طوری باهاش حرف می‌زنی که انگار...‬
Dialogue: 0,0:03:22.69,0:03:24.50,Standard,,0,0,0,,‫انگار که حرفت رو می‌فهمه‬
Dialogue: 0,0:03:24.58,0:03:28.87,Standard,,0,0,0,,‫من با گلدون‌هام هم حرف می‌زنم‬\N‫انتظار جواب هم ندارم‬
Dialogue: 0,0:03:29.37,0:03:32.36,Standard,,0,0,0,,‫هر موجود زنده‌ای دوست داره‬\N‫که باهاش حرف بزنن‬
Dialogue: 0,0:03:32.41,0:03:35.03,Standard,,0,0,0,,‫آقای دانویچ هم که زنده‌ست‬
Dialogue: 1,0:03:35.08,0:03:46.08,InfoBox,,0,0,0,,{\b1}Vertun{\b0}\N{\c&H00FFFF&}اشتباه که نمیشه کرد{\c}
Dialogue: 0,0:03:35.08,0:03:37.07,Standard,,0,0,0,,‫{\u1}اشتباه که نمیشه کرد{\u0}‬\N‫، نه؟‬
Dialogue: 0,0:03:40.34,0:03:42.71,Standard,,0,0,0,,‫همه‌چی میاد بیرون‬
Dialogue: 0,0:03:43.34,0:03:45.23,Standard,,0,0,0,,‫یه قاشق دیگه‬
Dialogue: 0,0:03:45.82,0:03:47.78,Standard,,0,0,0,,‫می‌گم...‬
Dialogue: 0,0:03:48.23,0:03:52.35,Standard,,0,0,0,,‫ببرمت تو گلخونه‬\N‫که ویو به آب داشته باشی‬
Dialogue: 0,0:03:52.58,0:03:54.87,Standard,,0,0,0,,‫الان... مده‬
Dialogue: 0,0:03:55.50,0:03:58.23,Standard,,0,0,0,,‫شاید‬\N‫بتونی یکی دو تا ماهی ببینی‬
Dialogue: 1,0:04:00.36,0:04:11.36,InfoBox,,0,0,0,,{\b1}Joa{\b0}\N{\c&H00FFFF&}آره{\c}
Dialogue: 0,0:04:00.36,0:04:04.15,Standard,,0,0,0,,‫- نیم ساعت دیگه اینجایی، نه؟‬\N‫-‬\N‫{\u1}آره{\u0}‬\N‫، حتماً‬
Dialogue: 0,0:04:04.54,0:04:05.99,Standard,,0,0,0,,‫پس یه ساعت شد‬
Dialogue: 1,0:04:06.09,0:04:17.09,InfoBox,,0,0,0,,{\b1}Kopp{\b0}\N{\c&H00FFFF&}سر{\c}
Dialogue: 0,0:04:06.09,0:04:08.00,Standard,,0,0,0,,‫عالیه، من باید یه‬\N‫{\u1}سر{\u0}‬\N‫برم بیرون‬
Dialogue: 0,0:04:08.74,0:04:11.27,Standard,,0,0,0,,‫آقای دانویچ رو گذاشتم‬\N‫توی گلخونه‬
Dialogue: 0,0:04:11.32,0:04:14.47,Standard,,0,0,0,,‫فقط باید‬\N‫حواست بهش باشه‬
Dialogue: 0,0:04:14.65,0:04:17.19,Standard,,0,0,0,,‫من که بلد نیستم‬\N‫با همچین آدمی...‬
Dialogue: 0,0:04:17.24,0:04:21.71,Standard,,0,0,0,,‫- اگه اتفاقی بیفته چی؟‬\N‫- هیچی نمیشه، توروخدا‬
Dialogue: 0,0:04:23.30,0:04:26.07,Standard,,0,0,0,,‫فقط اگه بالا بیاره‬\N‫خطرناکه‬
Dialogue: 0,0:04:26.46,0:04:29.83,Standard,,0,0,0,,‫اون‌وقت بچرخونش به پهلو‬\N‫و به اورژانس زنگ بزن‬
Dialogue: 0,0:04:30.03,0:04:32.59,Standard,,0,0,0,,‫فقط به کارت برس‬
Dialogue: 0,0:04:41.32,0:04:43.03,Standard,,0,0,0,,‫و باهاش حرف بزن!‬
Dialogue: 0,0:04:44.40,0:04:45.83,Standard,,0,0,0,,‫خب؟‬
Dialogue: 0,0:04:57.67,0:04:59.67,Standard,,0,0,0,,‫پس تو متیسی؟‬
Dialogue: 0,0:05:00.80,0:05:04.21,Standard,,0,0,0,,‫یه متیس می‌شناختم‬\N‫که اسمش... متیس بود‬
Dialogue: 0,0:05:04.44,0:05:06.22,Standard,,0,0,0,,‫چشم‌هاش ضعیف بود‬
Dialogue: 0,0:05:07.95,0:05:10.20,Standard,,0,0,0,,‫اذیتش می‌کرد، نه؟‬
Dialogue: 0,0:05:10.59,0:05:13.27,Standard,,0,0,0,,‫ولی بعدش تونست‬\N‫خوب باهاش کنار بیاد‬
Dialogue: 0,0:05:17.23,0:05:18.86,Standard,,0,0,0,,‫آخه داشت...‬
Dialogue: 0,0:05:18.94,0:05:20.40,Standard,,0,0,0,,‫عینک‬
Dialogue: 0,0:05:23.65,0:05:24.79,Standard,,0,0,0,,‫آره...‬
Dialogue: 0,0:05:25.20,0:05:27.44,Standard,,0,0,0,,‫آدم خیلی باحالی بود، اون متیس‬
Dialogue: 0,0:05:32.06,0:05:34.92,Standard,,0,0,0,,‫امشب میرم مسابقه کشتی تو گل‌ولای‬
Dialogue: 0,0:05:35.14,0:05:37.47,Standard,,0,0,0,,‫امشب بکی بیچ مسابقه کشتی داره‬
Dialogue: 0,0:05:40.38,0:05:43.71,Standard,,0,0,0,,‫یه سوئدی بلوند‬\N‫سایز سینه اف‬
Dialogue: 0,0:05:53.11,0:05:54.35,Standard,,0,0,0,,‫جدی؟‬
Dialogue: 1,0:06:41.40,0:06:52.40,InfoBox,,0,0,0,,{\b1}Horror{\b0}\N{\c&H00FFFF&}افتضاحه{\c}
Dialogue: 0,0:06:41.40,0:06:42.98,Standard,,0,0,0,,‫{\u1}افتضاحه{\u0}‬\N‫، بهت میگم‬
Dialogue: 0,0:06:43.06,0:06:44.56,Standard,,0,0,0,,‫مثل زامبی می‌مونه‬
Dialogue: 1,0:06:44.69,0:06:55.69,InfoBox,,0,0,0,,{\b1}Gemüse{\b0}\N{\c&H00FFFF&}یه تیکه گوشت شده{\c}
Dialogue: 0,0:06:44.69,0:06:47.11,Standard,,0,0,0,,‫- فقط‬\N‫{\u1}یه تیکه گوشت شده{\u0}‬\N‫<i>- سبزیجات می‌خوره؟</i>‬
Dialogue: 0,0:06:47.16,0:06:49.85,Standard,,0,0,0,,‫نه، خودش تبدیل به سبزیجات شده‬
Dialogue: 0,0:06:49.93,0:06:52.83,Standard,,0,0,0,,‫حتی وقتی از بکی بیچ گفتم‬\N‫هیچ واکنشی نشون نداد‬
Dialogue: 0,0:06:52.88,0:06:55.96,Standard,,0,0,0,,‫<i>بعداً خیلی حال میده</i>‬
Dialogue: 0,0:06:56.75,0:06:58.78,Standard,,0,0,0,,‫واقعاً آدم دلش براش می‌سوزه‬
Dialogue: 1,0:06:58.90,0:07:09.90,InfoBox,,0,0,0,,{\b1}arme Sau{\b0}\N{\c&H00FFFF&}بدبخت بیچاره‌ست{\c}
Dialogue: 0,0:06:58.90,0:07:01.27,Standard,,0,0,0,,‫-‬\N‫{\u1}بدبخت بیچاره‌ست{\u0}‬\N‫<i>- خب با خودت بیارش!</i>‬
Dialogue: 1,0:07:01.55,0:07:12.55,InfoBox,,0,0,0,,{\b1}Alter{\b0}\N{\c&H00FFFF&}پسر{\c}
Dialogue: 0,0:07:01.55,0:07:05.48,Standard,,0,0,0,,‫{\u1}پسر{\u0}‬\N‫، اون تو کماست!‬\N‫یه لحظه گوش کن چی میگم‬
Dialogue: 0,0:07:05.88,0:07:08.44,Standard,,0,0,0,,‫شش ساله که‬\N‫هیچی از دور و برش نمی‌فهمه‬
Dialogue: 0,0:07:08.54,0:07:10.95,Standard,,0,0,0,,‫<i>خب می‌ذاریمش پیش فریدون</i>‬
Dialogue: 0,0:07:13.09,0:07:16.35,Standard,,0,0,0,,‫- وصیت‌نامه پزشکی داری؟‬\N‫<i>- واسه چی؟ خطرناکه؟</i>‬
Dialogue: 0,0:07:16.40,0:07:20.60,Standard,,0,0,0,,‫نه، جدی میگم‬\N‫یه برگه که توش نوشته باشه‬
Dialogue: 0,0:07:20.84,0:07:25.20,Standard,,0,0,0,,‫نمی‌خوای با دستگاه زنده نگه‌ت دارن‬\N‫اگه به حالتی رسیدی‬
Dialogue: 0,0:07:25.30,0:07:28.52,Standard,,0,0,0,,‫که دیگه نتونی تصمیم بگیری‬
Dialogue: 1,0:07:28.76,0:07:39.76,InfoBox,,0,0,0,,{\b1}Bahncard{\b0}\N{\c&H00FFFF&}کارت مترو{\c}
Dialogue: 0,0:07:28.76,0:07:31.36,Standard,,0,0,0,,‫<i>من حتی‬\N‫{\u1}کارت مترو{\u0}‬\N‫هم ندارم</i>‬
Dialogue: 0,0:07:31.77,0:07:34.83,Standard,,0,0,0,,‫امشب حتماً چک می‌کنم‬\N‫ببینم چطوری باید نوشت‬
Dialogue: 0,0:07:34.99,0:07:37.12,Standard,,0,0,0,,‫<i>امشب مسابقه اف‌سی دیتره!</i>‬
Dialogue: 0,0:07:37.23,0:07:39.68,Standard,,0,0,0,,‫- می‌تونم تو رو معرفی کنم؟‬\N‫<i>- کجا؟</i>‬
Dialogue: 0,0:07:39.87,0:07:42.99,Standard,,0,0,0,,‫- تو وصیت‌نامه پزشکی‌ام!‬\N‫<i>- واسه چی آخه؟</i>‬
Dialogue: 0,0:07:43.04,0:07:46.43,Standard,,0,0,0,,‫که تو تصمیم بگیری‬\N‫کی دستگاه رو از برق بکشن‬
Dialogue: 0,0:07:46.48,0:07:49.44,Standard,,0,0,0,,‫<i>معلومه، حله‬\N‫پس ساعت هفت و نیم اوبرزی؟</i>‬
Dialogue: 0,0:07:49.53,0:07:50.80,Standard,,0,0,0,,‫<i>بعداً می‌بینمت</i>‬
Dialogue: 0,0:08:05.20,0:08:07.56,Standard,,0,0,0,,‫اصلاً به فوتبال علاقه داری؟‬
Dialogue: 0,0:08:10.42,0:08:12.99,Standard,,0,0,0,,‫وقت اضافه، شورله از جناحین میره‬
Dialogue: 0,0:08:13.04,0:08:16.31,Standard,,0,0,0,,‫گوتزه توپ رو می‌فرسته‬\N‫و می‌کوبه تو کنج دروازه! گل‬
Dialogue: 1,0:08:16.37,0:08:27.37,InfoBox,,0,0,0,,{\b1}wer das verpasst hat{\b0}\N{\c&H00FFFF&}هر کی اون صحنه رو ندیده{\c}
Dialogue: 0,0:08:16.37,0:08:20.10,Standard,,0,0,0,,‫و ما قهرمان جهان شدیم!‬\N‫پسر،‬\N‫{\u1}هر کی اون صحنه رو ندیده{\u0}‬
Dialogue: 1,0:08:22.96,0:08:33.96,InfoBox,,0,0,0,,{\b1}Boah{\b0}\N{\c&H00FFFF&}واقعاً که{\c}
Dialogue: 0,0:08:22.96,0:08:24.70,Standard,,0,0,0,,‫{\u1}واقعاً که{\u0}‬\N‫خیلی حیف شد‬
Dialogue: 0,0:08:27.04,0:08:30.08,Standard,,0,0,0,,‫من امشب‬\N‫وصیت‌نامه‌ام رو می‌نویسم‬
Dialogue: 0,0:08:30.73,0:08:33.60,Standard,,0,0,0,,‫تو حتی نمی‌تونی‬\N‫خلاصه‌ش رو هم ببینی‬
Dialogue: 0,0:08:33.70,0:08:36.00,Standard,,0,0,0,,‫پسر، عجب صحنه‌ای بود‬
Dialogue: 0,0:08:36.09,0:08:39.42,Standard,,0,0,0,,‫وقتی شورله از کنار میره‬\N‫و گوتزه میاد وسط‬
Dialogue: 0,0:08:39.50,0:08:42.11,Standard,,0,0,0,,‫سانتر میکنه،‬\N‫با سینه کنترل می‌کنه و...‬
Dialogue: 0,0:08:58.64,0:09:00.52,Standard,,0,0,0,,‫- سلام؟‬\N‫- سلام؟‬
Dialogue: 0,0:09:05.79,0:09:07.76,Standard,,0,0,0,,‫- سلام؟‬\N‫- این‌طرفم‬
Dialogue: 0,0:09:15.55,0:09:16.96,Standard,,0,0,0,,‫بیا تو‬
Dialogue: 0,0:09:21.57,0:09:23.80,Standard,,0,0,0,,‫من... اصلاً نمی‌دونم...‬
Dialogue: 0,0:09:23.93,0:09:25.84,Standard,,0,0,0,,‫چطور به اینجا رسیدم‬
Dialogue: 0,0:09:27.36,0:09:30.27,Standard,,0,0,0,,‫و اینجا چه... اتفاقی افتاده...‬
Dialogue: 0,0:09:30.94,0:09:34.48,Standard,,0,0,0,,‫خب... یه چیزی اینجا...‬\N‫اصلاً حس خوبی نداره‬
Dialogue: 0,0:09:34.64,0:09:36.03,Standard,,0,0,0,,‫تو توی ذهن منی‬
Dialogue: 0,0:09:36.42,0:09:37.83,Standard,,0,0,0,,‫توی ذهن تو‬
Dialogue: 0,0:09:38.35,0:09:41.28,Standard,,0,0,0,,‫- چطور اومدم اینجا؟‬\N‫- نمی‌دونم‬
Dialogue: 1,0:09:41.62,0:09:52.62,InfoBox,,0,0,0,,{\b1}empathisch{\b0}\N{\c&H00FFFF&}احساساتی{\c}
Dialogue: 0,0:09:41.62,0:09:43.99,Standard,,0,0,0,,‫شاید یه لحظه‬\N‫{\u1}احساساتی{\u0}‬\N‫شدی‬
Dialogue: 0,0:09:44.04,0:09:45.80,Standard,,0,0,0,,‫نه، قطعاً نه‬
Dialogue: 0,0:09:46.13,0:09:48.96,Standard,,0,0,0,,‫اگه کسی باشه که لحظات‬\N‫احساساتی نداشته باشه، اون منم‬
Dialogue: 0,0:09:49.03,0:09:51.01,Standard,,0,0,0,,‫می‌تونی از دوست‌دخترهای سابقم بپرسی‬
Dialogue: 0,0:09:51.12,0:09:54.16,Standard,,0,0,0,,‫می‌خوام برم بیرون‬\N‫همین الان‬
Dialogue: 0,0:09:54.27,0:09:56.99,Standard,,0,0,0,,‫اگه به همین سادگی بود که خوب بود‬
Dialogue: 0,0:09:57.42,0:09:59.64,Standard,,0,0,0,,‫می‌خوام برم بیرون‬
Dialogue: 0,0:10:03.71,0:10:06.52,Standard,,0,0,0,,‫داد زدن فایده‌ای نداره،‬\N‫حرفم رو باور کن‬
Dialogue: 0,0:10:07.44,0:10:10.36,Standard,,0,0,0,,‫- و تو...؟‬\N‫- پاک‌کننده صحنه جرم‬
Dialogue: 1,0:10:10.61,0:10:21.61,InfoBox,,0,0,0,,{\b1}klaustrophobisch{\b0}\N{\c&H00FFFF&}کلاستروفوبیا{\c}
Dialogue: 0,0:10:10.61,0:10:13.55,Standard,,0,0,0,,‫من حتی توی شرایط عادی هم‬\N‫{\u1}کلاستروفوبیا{\u0}‬\N‫می‌گیرم‬
Dialogue: 0,0:10:13.60,0:10:16.62,Standard,,0,0,0,,‫و این چیزی که اینجا هست... اصلاً‬
Dialogue: 0,0:10:16.70,0:10:18.15,Standard,,0,0,0,,‫"عادی" نیست‬
Dialogue: 0,0:10:18.20,0:10:19.78,Standard,,0,0,0,,‫این...‬
Dialogue: 0,0:10:20.15,0:10:22.00,Standard,,0,0,0,,‫باشه، آروم باش‬
Dialogue: 0,0:10:22.83,0:10:24.57,Standard,,0,0,0,,‫الان درست میشه‬
Dialogue: 0,0:10:24.75,0:10:25.83,Standard,,0,0,0,,‫همه چی دوباره خوب میشه‬
Dialogue: 0,0:10:26.53,0:10:29.01,Standard,,0,0,0,,‫نمی‌دونم می‌تونم بهت‬\N‫امیدی بدم یا نه‬
Dialogue: 0,0:10:30.54,0:10:32.63,Standard,,0,0,0,,‫شاید هم دارم‬\N‫میرم توی کما‬
Dialogue: 0,0:10:33.84,0:10:36.03,Standard,,0,0,0,,‫خدای من، حالم داره بد میشه‬
Dialogue: 0,0:10:36.11,0:10:38.15,Standard,,0,0,0,,‫شاید سکته مغزی کردم‬
Dialogue: 0,0:10:38.80,0:10:40.87,Standard,,0,0,0,,‫اون‌وقت توی ذهن خودت بودی‬
Dialogue: 0,0:10:40.92,0:10:43.27,Standard,,0,0,0,,‫آره، امیدوارم‬\N‫این که خیلی بهتره‬
Dialogue: 0,0:10:49.32,0:10:50.48,Standard,,0,0,0,,‫اینجا‬
Dialogue: 0,0:10:50.90,0:10:53.11,Standard,,0,0,0,,‫- اینا رو می‌شناسی؟‬\N‫- نه‬
Dialogue: 0,0:10:53.16,0:10:55.71,Standard,,0,0,0,,‫حلزون‌های تریفلان‬\N‫تا حالا جایی دیدیشون؟‬
Dialogue: 0,0:10:57.31,0:10:59.36,Standard,,0,0,0,,‫- نه!‬\N‫- ولی من دیدم‬
Dialogue: 0,0:10:59.57,0:11:02.00,Standard,,0,0,0,,‫بچگی‌هام توی هایگنسوند‬\N‫جمعشون می‌کردم‬
Dialogue: 0,0:11:02.15,0:11:05.84,Standard,,0,0,0,,‫اگه تو نمی‌شناسیشون،‬\N‫پس باید توی ذهن من باشی‬
Dialogue: 0,0:11:06.70,0:11:09.71,Standard,,0,0,0,,‫چرا باید توی ذهن کسی باشم؟!‬
Dialogue: 0,0:11:20.80,0:11:23.80,Standard,,0,0,0,,‫- این خیلی مسخره‌ست--‬\N‫- هیس‬
Dialogue: 0,0:11:32.36,0:11:34.00,Standard,,0,0,0,,‫این دیگه چیه؟‬
Dialogue: 0,0:11:37.72,0:11:39.12,Standard,,0,0,0,,‫آره، دقیقاً‬
Dialogue: 0,0:11:39.24,0:11:43.12,Standard,,0,0,0,,‫اینکه فکر کنی ممکنه‬\N‫توی ذهن کس دیگه‌ای باشی‬
Dialogue: 0,0:11:43.20,0:11:45.23,Standard,,0,0,0,,‫<i>معلومه، این اتفاقا میفته!</i>‬
Dialogue: 1,0:11:45.34,0:11:56.34,InfoBox,,0,0,0,,{\b1}Flokati{\b0}\N{\c&H00FFFF&}پشم{\c}
Dialogue: 0,0:11:45.34,0:11:49.86,Standard,,0,0,0,,‫<i>یه بار سوار یه کورسای مدل ۸۲ بودم،‬\N‫روکش‌های صندلی‌اش از‬\N‫{\u1}پشم{\u0}‬\N‫قهوه‌ای بود.</i>‬
Dialogue: 0,0:11:50.12,0:11:56.04,Standard,,0,0,0,,‫<i>کل مسیر تا برونزبوتل‬\N‫توی اون پشم‌های قهوه‌ایِ لعنتی.</i>‬
Dialogue: 0,0:11:56.34,0:11:58.95,Standard,,0,0,0,,‫<i>انگار وسط روده بزرگ نشسته بودم.</i>‬
Dialogue: 0,0:11:59.36,0:12:01.52,Standard,,0,0,0,,‫من در مورد ماشین حرف نمی‌زنم!‬
Dialogue: 0,0:12:01.65,0:12:05.88,Standard,,0,0,0,,‫ظاهراً من‬\N‫توی سرِ یه نفر دیگه‌ام!‬
Dialogue: 0,0:12:06.44,0:12:08.87,Standard,,0,0,0,,‫و این خیلی خطرناکه...‬
Dialogue: 0,0:12:09.35,0:12:12.47,Standard,,0,0,0,,‫<i>بستگی داره - گواهینامه داره؟</i>‬
Dialogue: 0,0:12:16.77,0:12:17.91,Standard,,0,0,0,,‫بیا، بشین.‬
Dialogue: 0,0:12:43.52,0:12:46.44,Standard,,0,0,0,,‫- آروم باش، همه‌چی خوبه.‬\N‫- آره.‬
Dialogue: 0,0:12:47.08,0:12:50.28,Standard,,0,0,0,,‫می‌دونی که تصادف کردی؟‬
Dialogue: 0,0:12:53.06,0:12:56.12,Standard,,0,0,0,,‫یه چیزی بود در مورد... قایق؟‬
Dialogue: 0,0:12:57.25,0:12:58.23,Standard,,0,0,0,,‫آره.‬
Dialogue: 0,0:12:58.31,0:13:01.24,Standard,,0,0,0,,‫پرستارت می‌گه‬\N‫که سرت خورده زمین.‬
Dialogue: 0,0:13:02.44,0:13:06.32,Standard,,0,0,0,,‫و قایق رو هم تازه‬\N‫روز بعدش پیدا کردن.‬
Dialogue: 0,0:13:12.36,0:13:13.91,Standard,,0,0,0,,‫و اون کی بود؟‬
Dialogue: 0,0:13:13.99,0:13:15.31,Standard,,0,0,0,,‫اون مالِ...‬
Dialogue: 0,0:13:15.64,0:13:17.24,Standard,,0,0,0,,‫شش سال پیش بود.‬
Dialogue: 0,0:13:18.04,0:13:19.84,Standard,,0,0,0,,‫شش سال...‬
Dialogue: 0,0:13:20.30,0:13:22.76,Standard,,0,0,0,,‫و... و این خیلی طولانیه، مگه نه؟‬
Dialogue: 0,0:13:23.32,0:13:25.99,Standard,,0,0,0,,‫به نظر من که هست.‬\N‫این یعنی یک و نیم دوره جام جهانی فوتبال.‬
Dialogue: 1,0:13:26.41,0:13:37.41,InfoBox,,0,0,0,,{\b1}krass{\b0}\N{\c&H00FFFF&}عجیبه{\c}
Dialogue: 0,0:13:26.41,0:13:30.95,Standard,,0,0,0,,‫- دوباره قهرمان جهان شدیم؟‬\N‫- آره.‬\N‫{\u1}عجیبه{\u0}‬\N‫، نه؟‬
Dialogue: 0,0:13:32.39,0:13:34.11,Standard,,0,0,0,,‫عجب.‬
Dialogue: 0,0:13:37.04,0:13:38.48,Standard,,0,0,0,,‫آلمان.‬
Dialogue: 0,0:13:43.07,0:13:46.69,Standard,,0,0,0,,‫از اولین روزهای بعد از تصادف‬\N‫چیز زیادی یادم نمیاد.‬
Dialogue: 0,0:13:47.20,0:13:49.64,Standard,,0,0,0,,‫اون موقع فقط رنگ می‌دیدم.‬
Dialogue: 0,0:13:50.20,0:13:53.43,Standard,,0,0,0,,‫اما نه اون رنگ‌هایی که‬\N‫قبلاً می‌شناختم.‬
Dialogue: 0,0:13:53.82,0:13:56.47,Standard,,0,0,0,,‫یه جورایی متفاوت بودن. مثلاً‬
Dialogue: 0,0:13:56.95,0:14:00.20,Standard,,0,0,0,,‫یه آبی... که شبیه زرد به نظر می‌رسید.‬
Dialogue: 0,0:14:00.34,0:14:02.52,Standard,,0,0,0,,‫اما با این حال آبی بود.‬
Dialogue: 0,0:14:03.43,0:14:07.39,Standard,,0,0,0,,‫انگار که چیزی کشیده باشی.‬\N‫اما با این حال کاملاً متفاوت بود.‬
Dialogue: 0,0:14:07.97,0:14:09.68,Standard,,0,0,0,,‫و بعد صداهایی می‌شنیدم.‬
Dialogue: 0,0:14:09.76,0:14:12.24,Standard,,0,0,0,,‫مادرم، دوست‌دخترم...‬
Dialogue: 0,0:14:13.06,0:14:15.08,Standard,,0,0,0,,‫دوست‌دختر اون موقع‌ام. و...‬
Dialogue: 0,0:14:15.39,0:14:17.36,Standard,,0,0,0,,‫آدم‌های دیگه، احتمالاً دکترها.‬
Dialogue: 0,0:14:17.48,0:14:19.08,Standard,,0,0,0,,‫اون موقع خیالم راحت بود.‬
Dialogue: 0,0:14:19.19,0:14:22.52,Standard,,0,0,0,,‫مطمئن بودم‬\N‫که منو از اون وضعیت درمیارن.‬
Dialogue: 0,0:14:22.86,0:14:26.69,Standard,,0,0,0,,‫هنوز که زنده بودم،‬\N‫بالاخره یه فکری به حالش می‌کردن.‬
Dialogue: 0,0:14:26.86,0:14:30.15,Standard,,0,0,0,,‫فقط روی‬\N‫نفس کشیدنم تمرکز کرده بودم.‬
Dialogue: 0,0:14:30.74,0:14:35.60,Standard,,0,0,0,,‫و بعد دکتر به مادرم گفت‬\N‫که وضعیت من...‬
Dialogue: 0,0:14:36.41,0:14:38.27,Standard,,0,0,0,,‫آره، که همین‌طوری می‌مونه.‬
Dialogue: 1,0:14:38.32,0:14:49.32,InfoBox,,0,0,0,,{\b1}Weichei{\b0}\N{\c&H00FFFF&}آدم سوسول{\c}
Dialogue: 0,0:14:38.32,0:14:40.72,Standard,,0,0,0,,‫من‬\N‫{\u1}آدم سوسول{\u0}‬\N‫یا این‌جور چیزا نیستم‬
Dialogue: 0,0:14:41.04,0:14:44.78,Standard,,0,0,0,,‫ولی اونجا فقط جیغ می‌کشیدم،‬\N‫خدا می‌دونه چقدر طول کشید‬
Dialogue: 0,0:14:45.20,0:14:46.64,Standard,,0,0,0,,‫واقعاً وحشت کرده بودم‬
Dialogue: 0,0:14:47.09,0:14:49.31,Standard,,0,0,0,,‫فقط می‌خواستم همه‌چیز تموم شه‬
Dialogue: 0,0:14:50.99,0:14:55.32,Standard,,0,0,0,,‫بعد تمرکزم رو گذاشتم رو نقطه مقابلش‬\N‫رو نفس نکشیدن‬
Dialogue: 0,0:14:56.80,0:14:58.15,Standard,,0,0,0,,‫جواب نداد؟‬
Dialogue: 0,0:14:58.94,0:15:01.84,Standard,,0,0,0,,‫معلومه که نه،‬\N‫تو که وصلی به دستگاه‬
Dialogue: 0,0:15:02.46,0:15:06.11,Standard,,0,0,0,,‫هرچقدرم بخوای بمیری،‬\N‫اون دستگاه زورش بیشتره‬
Dialogue: 1,0:15:06.23,0:15:17.23,InfoBox,,0,0,0,,{\b1}Beklemmungen{\b0}\N{\c&H00FFFF&}خفه می‌شم{\c}
Dialogue: 0,0:15:06.23,0:15:08.92,Standard,,0,0,0,,‫ول کن، دارم‬\N‫{\u1}خفه می‌شم{\u0}‬
Dialogue: 0,0:15:11.94,0:15:14.59,Standard,,0,0,0,,‫آدم همیشه فکر می‌کنه،‬\N‫یه روزی، بالاخره...‬
Dialogue: 0,0:15:15.12,0:15:18.32,Standard,,0,0,0,,‫یه وصیت‌نامه پزشکی‬\N‫واسه خودش جور می‌کنه‬
Dialogue: 0,0:15:18.92,0:15:20.24,Standard,,0,0,0,,‫ولی...‬
Dialogue: 0,0:15:20.45,0:15:22.68,Standard,,0,0,0,,‫این «یه روزی»...‬
Dialogue: 0,0:15:22.84,0:15:25.87,Standard,,0,0,0,,‫همیشه همون «یه روزی» می‌مونه‬
Dialogue: 0,0:15:26.01,0:15:28.63,Standard,,0,0,0,,‫یعنی همیشه همون «یه روزی» باقی می‌مونه‬
Dialogue: 0,0:15:29.15,0:15:33.75,Standard,,0,0,0,,‫کی میاد بی‌دلیل‬\N‫یه روز یکشنبه تعطیل بشینه‬
Dialogue: 0,0:15:33.85,0:15:37.28,Standard,,0,0,0,,‫و بالاخره با خیال راحت‬\N‫وصیت‌نامه‌اش رو بنویسه‬
Dialogue: 0,0:15:37.41,0:15:38.72,Standard,,0,0,0,,‫من‬
Dialogue: 0,0:15:40.07,0:15:42.31,Standard,,0,0,0,,‫- جدی؟ تو داری؟‬\N‫- آره، یه همچین چیزی‬
Dialogue: 1,0:15:42.62,0:15:53.62,InfoBox,,0,0,0,,{\b1}verschüttgegangen{\b0}\N{\c&H00FFFF&}گم و گور شده{\c}
Dialogue: 0,0:15:42.62,0:15:45.44,Standard,,0,0,0,,‫ولی فکر کنم‬\N‫{\u1}گم و گور شده{\u0}‬
Dialogue: 0,0:15:46.02,0:15:47.44,Standard,,0,0,0,,‫حالا چی؟‬
Dialogue: 0,0:15:47.82,0:15:49.99,Standard,,0,0,0,,‫می‌ترسم‬\N‫یکی پیداش کنه‬
Dialogue: 0,0:15:53.11,0:15:54.83,Standard,,0,0,0,,‫شش سال؟‬
Dialogue: 0,0:15:55.16,0:15:57.84,Standard,,0,0,0,,‫پس الان... ۳۴ سالمه!‬
Dialogue: 0,0:15:59.41,0:16:00.80,Standard,,0,0,0,,‫هنوزم خوبه‬
Dialogue: 0,0:16:01.80,0:16:04.19,Standard,,0,0,0,,‫هنوز می‌تونم‬\N‫تشکیل خانواده بدم‬
Dialogue: 1,0:16:06.56,0:16:17.56,InfoBox,,0,0,0,,{\b1}Marlspieker{\b0}\N{\c&H00FFFF&}پیچ‌گوشتی{\c}
Dialogue: 0,0:16:06.56,0:16:08.92,Standard,,0,0,0,,‫اون‬\N‫{\u1}پیچ‌گوشتی{\u0}‬\N‫رو بده به من‬
Dialogue: 0,0:16:13.47,0:16:15.19,Standard,,0,0,0,,‫این پیچ‌گوشتیه‬
Dialogue: 0,0:16:16.16,0:16:17.88,Standard,,0,0,0,,‫خودم می‌دونم‬
Dialogue: 0,0:16:19.35,0:16:21.12,Standard,,0,0,0,,‫- اینو می‌گی دیگه؟‬\N‫- آره‬
Dialogue: 0,0:16:25.19,0:16:27.64,Standard,,0,0,0,,‫- تو هم می‌خوابی؟‬\N‫- آره، معلومه که می‌خوابم!‬
Dialogue: 0,0:16:28.07,0:16:31.12,Standard,,0,0,0,,‫و وقتی بیدار می‌شی...‬\N‫منظورم اینه که...‬
Dialogue: 0,0:16:31.36,0:16:33.04,Standard,,0,0,0,,‫فکر می‌کنی...‬
Dialogue: 0,0:16:33.32,0:16:34.84,Standard,,0,0,0,,‫«به‌به، چه خوب خوابیدم»؟‬
Dialogue: 0,0:16:34.92,0:16:38.44,Standard,,0,0,0,,‫«اول برم نون بگیرم و‬\N‫برم سر کار -‬
Dialogue: 0,0:16:38.51,0:16:40.74,Standard,,0,0,0,,‫«آخ لعنتی، من که تو کُما هستم»‬
Dialogue: 0,0:16:40.95,0:16:44.43,Standard,,0,0,0,,‫یعنی نه نون گرفتن‬\N‫نه سر کار رفتن‬
Dialogue: 0,0:16:44.52,0:16:46.80,Standard,,0,0,0,,‫نه فوتبال، نه بکیِ عوضی...‬
Dialogue: 0,0:16:47.42,0:16:50.71,Standard,,0,0,0,,‫با یه زنِ خوشگل‬\N‫یه شبِ عالی داشتن‬
Dialogue: 0,0:16:50.76,0:16:53.64,Standard,,0,0,0,,‫یا سیب‌زمینی سرخ‌کرده‌ی مشتی‬\N‫با کچاپ و مایونز خوردن!‬
Dialogue: 0,0:16:56.00,0:17:00.16,Standard,,0,0,0,,‫اصلاً خوردن، نوشیدن،‬\N‫جشن گرفتن، راه رفتن، رانندگی کردن‬
Dialogue: 0,0:17:00.35,0:17:04.41,Standard,,0,0,0,,‫با خط ۳ مترو از لاندونگس‌بروکن رد شدن‬\N‫دوچرخه‌سواری کردن‬
Dialogue: 0,0:17:04.51,0:17:09.20,Standard,,0,0,0,,‫ذوق کردن واسه یه آبجو‬\N‫وقتی فکر می‌کردی دیگه هیچی نمونده‬
Dialogue: 0,0:17:09.28,0:17:13.24,Standard,,0,0,0,,‫بعدش با پروژکتور بازی لیگ قهرمانان رو دیدن!‬\N‫پسر، تو دیگه اینا رو نداری‬
Dialogue: 0,0:17:13.34,0:17:16.75,Standard,,0,0,0,,‫در واقع تو همین الانشم مردی،‬\N‫باید وحشتناک باشه‬
Dialogue: 0,0:17:18.44,0:17:20.08,Standard,,0,0,0,,‫متاسفم‬
Dialogue: 0,0:17:23.41,0:17:25.16,Standard,,0,0,0,,‫اوایلش همین‌طوری بود‬
Dialogue: 0,0:17:25.29,0:17:27.76,Standard,,0,0,0,,‫ولی خودم باید یه کاری می‌کردم‬
Dialogue: 1,0:17:27.84,0:17:38.84,InfoBox,,0,0,0,,{\b1}Rumjammern{\b0}\N{\c&H00FFFF&}ناله کردن{\c}
Dialogue: 0,0:17:27.84,0:17:30.55,Standard,,0,0,0,,‫{\u1}ناله کردن{\u0}‬\N‫و ول کردن خود؟ نه‬
Dialogue: 0,0:17:30.67,0:17:32.16,Standard,,0,0,0,,‫من این‌طوری نیستم‬
Dialogue: 0,0:17:32.30,0:17:35.76,Standard,,0,0,0,,‫با خودم گفتم‬\N‫بذار همه اینا رو مرتب کنم‬
Dialogue: 0,0:17:35.88,0:17:40.32,Standard,,0,0,0,,‫شبکه‌ها رو به هم وصل کنم،‬\N‫اتصالات رو ترمیم کنم‬
Dialogue: 0,0:17:40.72,0:17:42.63,Standard,,0,0,0,,‫تا یه کاری واسه انجام دادن داشته باشم‬
Dialogue: 0,0:17:43.51,0:17:47.15,Standard,,0,0,0,,‫و یهو حس کردم‬\N‫پلک چشم چپم تکون خورد‬
Dialogue: 0,0:17:47.80,0:17:50.59,Standard,,0,0,0,,‫داشتم از خوشحالی سکته می‌کردم‬\N‫می‌تونی تصور کنی، نه؟‬
Dialogue: 0,0:17:50.67,0:17:52.07,Standard,,0,0,0,,‫آره‬
Dialogue: 0,0:17:52.72,0:17:54.54,Standard,,0,0,0,,‫- نه، نمی‌تونی‬\N‫- نمی‌تونم‬
Dialogue: 0,0:17:54.62,0:17:56.23,Standard,,0,0,0,,‫نه، واقعاً هم نمی‌تونی‬
Dialogue: 0,0:17:56.44,0:17:58.00,Standard,,0,0,0,,‫- نه‬\N‫- آره‬
Dialogue: 0,0:17:58.86,0:18:02.96,Standard,,0,0,0,,‫هرچی بیشتر ترمیم می‌کنم،‬\N‫اوضاع بهتر می‌شه‬
Dialogue: 0,0:18:03.24,0:18:07.68,Standard,,0,0,0,,‫نه اینکه عالی باشه‬\N‫و بتونم پلکم رو کامل تکون بدم‬
Dialogue: 0,0:18:08.08,0:18:10.48,Standard,,0,0,0,,‫ولی تو مسیر درستی‌ام‬
Dialogue: 0,0:18:13.24,0:18:17.32,Standard,,0,0,0,,‫واو، همه‌ش واسه‬\N‫یه ذره حس توی پلک چشم‬
Dialogue: 1,0:18:18.22,0:18:29.22,InfoBox,,0,0,0,,{\b1}über den Daumen gepeilt{\b0}\N{\c&H00FFFF&}سرانگشتی حساب کنم{\c}
Dialogue: 0,0:18:18.22,0:18:22.77,Standard,,0,0,0,,‫اگه بخوام‬\N‫{\u1}سرانگشتی حساب کنم{\u0}‬\N‫،‬\N‫می‌شه حدود ۲۵۰ هزار تا گره‬
Dialogue: 0,0:18:24.72,0:18:27.42,Standard,,0,0,0,,‫یه بار خوندم که‬\N‫توی یه مغز سالم‬
Dialogue: 0,0:18:27.53,0:18:30.09,Standard,,0,0,0,,‫میلیاردها اتصال وجود داره‬
Dialogue: 0,0:18:30.22,0:18:31.69,Standard,,0,0,0,,‫تو همه‌شون رو لازم نداری،‬\N‫حتی نابغه‌ها هم لازم ندارن‬
Dialogue: 0,0:18:31.79,0:18:35.80,Standard,,0,0,0,,‫من فقط می‌خوام یه زندگی معمولی داشته باشم‬
Dialogue: 0,0:18:36.97,0:18:38.35,Standard,,0,0,0,,‫راه رفتن،‬
Dialogue: 0,0:18:38.46,0:18:42.15,Standard,,0,0,0,,‫با قایق رفتن بیرون،‬\N‫دیدن دوستا واسه کباب درست کردن‬
Dialogue: 0,0:18:43.33,0:18:47.44,Standard,,0,0,0,,‫ولی هدف بعدی‌ام‬\N‫فعلاً فقط همون پلک چشممه‬
Dialogue: 1,0:18:47.60,0:18:58.60,InfoBox,,0,0,0,,{\b1}halbe Miete{\b0}\N{\c&H00FFFF&}نصف راهه{\c}
Dialogue: 0,0:18:47.60,0:18:50.08,Standard,,0,0,0,,‫همین خودش‬\N‫{\u1}نصف راهه{\u0}‬
Dialogue: 0,0:18:50.42,0:18:53.63,Standard,,0,0,0,,‫اون‌وقت حداقل می‌تونی دوباره مخ بزنی‬
Dialogue: 0,0:19:10.44,0:19:14.07,Standard,,0,0,0,,‫یه لیست از کارایی که قراره بکنم‬\N‫وقتی بیدار بشم‬
Dialogue: 0,0:19:14.45,0:19:16.67,Standard,,0,0,0,,‫اگه دکتر راست بگه...‬
Dialogue: 0,0:19:18.76,0:19:22.60,Standard,,0,0,0,,‫- اگه قبل از اینکه بیدار بشم بمیرم چی؟‬\N‫- آره‬
Dialogue: 0,0:19:23.09,0:19:25.75,Standard,,0,0,0,,‫اون زندگی‌ای نبود‬\N‫که آدم آرزوش رو داشت‬
Dialogue: 0,0:19:26.33,0:19:28.19,Standard,,0,0,0,,‫ولی بدترین هم نبود‬
Dialogue: 0,0:19:29.62,0:19:34.16,Standard,,0,0,0,,‫من دردی ندارم،‬\N‫همیشه از وصل کردن شبکه‌ها خوشم می‌اومد‬
Dialogue: 0,0:19:35.46,0:19:37.11,Standard,,0,0,0,,‫من رئیس خودمم‬
Dialogue: 0,0:19:37.16,0:19:38.44,Standard,,0,0,0,,‫این یه نعمته‬
Dialogue: 0,0:19:38.54,0:19:41.36,Standard,,0,0,0,,‫این رو کسی میگه که حتی‬\N‫نمیتونه پلک بزنه‬
Dialogue: 0,0:19:41.44,0:19:43.84,Standard,,0,0,0,,‫ولی حداقل حسش رو داره‬
Dialogue: 0,0:19:43.95,0:19:46.32,Standard,,0,0,0,,‫من واسه این خیلی زحمت کشیدم‬
Dialogue: 0,0:19:46.66,0:19:48.05,Standard,,0,0,0,,‫بهش افتخار می‌کنم‬
Dialogue: 0,0:19:48.15,0:19:50.40,Standard,,0,0,0,,‫من رئیس خودمم چون...‬
Dialogue: 0,0:19:50.75,0:19:53.67,Standard,,0,0,0,,‫توی کله‌ام همه چی‬\N‫همون‌طوری که می‌خوام پیش میره‬
Dialogue: 0,0:19:54.61,0:19:58.99,Standard,,0,0,0,,‫اگه قرار باشه همین‌طوری بمونم‬\N‫حداقل می‌خوام بتونم بگم:‬
Dialogue: 0,0:19:59.04,0:20:00.87,Standard,,0,0,0,,‫بهترین استفاده رو ازش کردم‬
Dialogue: 0,0:20:04.03,0:20:05.60,Standard,,0,0,0,,‫تو چی؟‬
Dialogue: 0,0:20:06.85,0:20:09.95,Standard,,0,0,0,,‫اصلاً می‌دونی چی می‌خوای؟‬
Dialogue: 1,0:20:10.66,0:20:21.66,InfoBox,,0,0,0,,{\b1}profan{\b0}\N{\c&H00FFFF&}پیش‌پا افتاده{\c}
Dialogue: 0,0:20:10.66,0:20:13.02,Standard,,0,0,0,,‫الان یه چیز خیلی‬\N‫{\u1}پیش‌پا افتاده{\u0}‬
Dialogue: 0,0:20:13.09,0:20:14.67,Standard,,0,0,0,,‫باید برم دستشویی‬
Dialogue: 0,0:20:15.33,0:20:17.83,Standard,,0,0,0,,‫خودمم می‌دونم عجیبه‬\N‫ولی خب همینه‬
Dialogue: 0,0:20:18.21,0:20:21.04,Standard,,0,0,0,,‫ولی نمی‌دونم چطوری‬
Dialogue: 0,0:20:21.15,0:20:23.15,Standard,,0,0,0,,‫یا کجا‬
Dialogue: 0,0:20:26.55,0:20:29.15,Standard,,0,0,0,,‫که نمی‌تونم همین‌طوری‬\N‫توی کله‌ات جیش کنم‬
Dialogue: 0,0:20:38.84,0:20:41.26,Standard,,0,0,0,,‫تولدت مبارک متیس‬
Dialogue: 0,0:20:41.47,0:20:43.24,Standard,,0,0,0,,‫برای منه؟‬
Dialogue: 0,0:20:48.04,0:20:49.95,Standard,,0,0,0,,‫ایول، مرسی بابا‬
Dialogue: 0,0:20:51.60,0:20:53.73,Standard,,0,0,0,,‫هفتمین تولد‬
Dialogue: 0,0:20:59.34,0:21:02.23,Standard,,0,0,0,,‫نمیدونم تو کله‌ام چی‌ها هست‬
Dialogue: 0,0:21:02.52,0:21:04.63,Standard,,0,0,0,,‫چه چیزایی ممکنه بیاد بالا‬
Dialogue: 0,0:21:05.05,0:21:08.20,Standard,,0,0,0,,‫جسدهای نیمه‌پوسیده، جعبه‌های پیتزا‬
Dialogue: 1,0:21:08.51,0:21:19.51,InfoBox,,0,0,0,,{\b1}rumnörgelt{\b0}\N{\c&H00FFFF&}غر می‌زنه{\c}
Dialogue: 0,0:21:08.51,0:21:12.42,Standard,,0,0,0,,‫مادرم که فقط‬\N‫{\u1}غر می‌زنه{\u0}‬\N‫چون از هیچی راضی نیست‬
Dialogue: 0,0:21:12.51,0:21:15.44,Standard,,0,0,0,,‫ولی مطمئنم اونجا‬\N‫هیچ پدری با پسرش بازی نمی‌کنه‬
Dialogue: 0,0:21:15.50,0:21:17.48,Standard,,0,0,0,,‫اون باهات فوتبال بازی می‌کرد؟‬
Dialogue: 0,0:21:17.61,0:21:19.44,Standard,,0,0,0,,‫خوش‌شانس بودی‬
Dialogue: 0,0:21:22.06,0:21:26.32,Standard,,0,0,0,,‫شاید یه پسر همسایه‬\N‫اتفاقی از اونجا رد می‌شده؟‬
Dialogue: 0,0:21:29.25,0:21:30.53,Standard,,0,0,0,,‫چی؟ نه‬
Dialogue: 0,0:21:30.61,0:21:32.51,Standard,,0,0,0,,‫اونجا هیچ پسر همسایه‌ای نبود‬
Dialogue: 0,0:21:34.71,0:21:37.57,Standard,,0,0,0,,‫یا یه پسری که‬\N‫اتفاقی اون اطراف بوده‬
Dialogue: 0,0:21:37.68,0:21:41.72,Standard,,0,0,0,,‫که دیگه نمی‌تونسته‬\N‫توی خونه‌اش بمونه‬
Dialogue: 0,0:21:41.83,0:21:44.04,Standard,,0,0,0,,‫اگه بود من می‌فهمیدم‬
Dialogue: 0,0:21:44.13,0:21:47.92,Standard,,0,0,0,,‫- یه پسری که می‌خواسته با بقیه--‬\N‫- نه، شرمنده‬
Dialogue: 0,0:21:48.39,0:21:51.77,Standard,,0,0,0,,‫توی خاطرات من‬\N‫فقط من بودم و بابام‬
Dialogue: 0,0:21:51.91,0:21:53.59,Standard,,0,0,0,,‫یه تولد خیلی قشنگ‬
Dialogue: 0,0:21:54.60,0:21:56.92,Standard,,0,0,0,,‫هیچ پسر دیگه‌ای اونجا نبود‬
Dialogue: 0,0:22:21.59,0:22:23.84,Standard,,0,0,0,,‫اون موقع هیچ دوستی نداشتم‬
Dialogue: 0,0:22:24.40,0:22:28.89,Standard,,0,0,0,,‫یه خرگوش داشتم که حتی اونم‬\N‫از من خوشش نمی‌اومد‬
Dialogue: 0,0:22:28.94,0:22:30.51,Standard,,0,0,0,,‫یعنی این اصلاً کار من نبود--‬
Dialogue: 0,0:22:31.97,0:22:33.52,Standard,,0,0,0,,‫نه! نه!‬
Dialogue: 0,0:22:39.12,0:22:41.07,Standard,,0,0,0,,‫نه، لطفاً نه، نه‬
Dialogue: 0,0:22:41.12,0:22:42.68,Standard,,0,0,0,,‫اوه، نه‬
Dialogue: 1,0:22:45.79,0:22:56.79,InfoBox,,0,0,0,,{\b1}Scheiße{\b0}\N{\c&H00FFFF&}گندی زدم{\c}
Dialogue: 0,0:22:45.79,0:22:48.16,Standard,,0,0,0,,‫اوه، چه‬\N‫{\u1}گندی زدم{\u0}‬
Dialogue: 0,0:22:48.32,0:22:51.11,Standard,,0,0,0,,‫حس پلکم از بین رفته‬
Dialogue: 0,0:22:51.16,0:22:54.56,Standard,,0,0,0,,‫- شرمنده‌ام‬\N‫- و همیشه وقتی فکر می‌کنم که دیگه...‬
Dialogue: 0,0:22:54.90,0:22:56.97,Standard,,0,0,0,,‫دیگه داره بهتر می‌شه...‬
Dialogue: 0,0:22:58.10,0:23:00.43,Standard,,0,0,0,,‫دوباره برمی‌گردم سر خونه اول‬
Dialogue: 0,0:23:03.50,0:23:05.28,Standard,,0,0,0,,‫بعضی وقتا می‌خوام بیخیال شم‬
Dialogue: 0,0:23:05.38,0:23:08.34,Standard,,0,0,0,,‫ولی نه الان! اون وقت اون--‬
Dialogue: 0,0:23:12.72,0:23:14.71,Standard,,0,0,0,,‫مگه نمی‌گی‬\N‫خودت رئیس مغز خودتی‬
Dialogue: 1,0:23:14.81,0:23:25.81,InfoBox,,0,0,0,,{\b1}Sensenmann{\b0}\N{\c&H00FFFF&}عزرائیل{\c}
Dialogue: 0,0:23:14.81,0:23:18.88,Standard,,0,0,0,,‫پس چطور یه‬\N‫{\u1}عزرائیل{\u0}‬\N‫مسخره‬\N‫همه چی رو خراب می‌کنه؟‬
Dialogue: 0,0:23:19.14,0:23:21.12,Standard,,0,0,0,,‫- بندازش بیرون!‬\N‫- چطوری؟‬
Dialogue: 0,0:23:21.23,0:23:24.57,Standard,,0,0,0,,‫- هزار بار امتحان کردم‬\N‫- اصلاً چرا اونجاست؟‬
Dialogue: 0,0:23:25.88,0:23:27.49,Standard,,0,0,0,,‫چون می‌ترسم،‬\N‫دیگه چرا؟!‬
Dialogue: 0,0:23:27.58,0:23:30.03,Standard,,0,0,0,,‫- چون وحشت مرگ دارم!‬\N‫- خب معلومه‬
Dialogue: 0,0:23:30.12,0:23:34.16,Standard,,0,0,0,,‫ولی چرا اون رو‬\N‫اینقدر قدیمی تصور می‌کنی؟‬
Dialogue: 0,0:23:34.96,0:23:37.08,Standard,,0,0,0,,‫شاید یه جایی‬\N‫دیدمش‬
Dialogue: 0,0:23:37.24,0:23:39.72,Standard,,0,0,0,,‫توی عکس یا کتاب‬
Dialogue: 0,0:23:40.12,0:23:42.72,Standard,,0,0,0,,‫- یادت میاد چه کتابی بود؟‬\N‫- نه‬
Dialogue: 0,0:23:43.53,0:23:47.60,Standard,,0,0,0,,‫- شاید... یه کتاب قصه بوده‬\N‫- ممکنه‬
Dialogue: 0,0:23:47.77,0:23:49.32,Standard,,0,0,0,,‫یه کتاب قصه‬
Dialogue: 0,0:23:50.52,0:23:54.12,Standard,,0,0,0,,‫- چه شکلی بود؟‬\N‫- حتی نمی‌دونم که...‬
Dialogue: 0,0:23:54.20,0:23:57.24,Standard,,0,0,0,,‫شاید جلدش آبی بوده؟‬
Dialogue: 0,0:23:58.88,0:24:02.52,Standard,,0,0,0,,‫- ممکنه‬\N‫- پس یه کتاب قصه با جلد آبی‬
Dialogue: 0,0:24:03.95,0:24:05.77,Standard,,0,0,0,,‫اسم کتاب چی بود؟‬
Dialogue: 0,0:24:06.24,0:24:07.53,Standard,,0,0,0,,‫نمی‌دونم‬
Dialogue: 0,0:24:07.63,0:24:11.04,Standard,,0,0,0,,‫اسمش بود‬\N‫«چطور ماتیس مرگ رو گول زد»‬
Dialogue: 0,0:24:11.32,0:24:15.39,Standard,,0,0,0,,‫- این واقعاً کتاب قصه بوده؟‬\N‫- خب تو هم همکاری کن‬
Dialogue: 0,0:24:16.50,0:24:21.32,Standard,,0,0,0,,‫و شاید‬\N‫یه بازی هم توش بوده‬
Dialogue: 0,0:24:21.60,0:24:23.11,Standard,,0,0,0,,‫- بازی؟‬\N‫- آره دیگه‬
Dialogue: 0,0:24:25.87,0:24:29.80,Standard,,0,0,0,,‫«و وقتی مرگ دوباره‬\N‫همه چی رو به گند کشید،‬
Dialogue: 0,0:24:30.09,0:24:32.15,Standard,,0,0,0,,‫«یه جعبه پیدا کرد‬
Dialogue: 0,0:24:32.63,0:24:35.38,Standard,,0,0,0,,‫«توی اون جعبه‬\N‫یه دستگاه جادویی بود‬
Dialogue: 0,0:24:35.49,0:24:39.22,Standard,,0,0,0,,‫«توی اون دستگاه جادویی‬\N‫یه بازی ذخیره شده بود،‬
Dialogue: 0,0:24:39.30,0:24:41.27,Standard,,0,0,0,,‫«که اسمش بود 'گایراستون وان'»‬
Dialogue: 0,0:24:43.11,0:24:44.92,Standard,,0,0,0,,‫توی قسمت «بازی‌ها»!‬
Dialogue: 0,0:24:45.12,0:24:48.16,Standard,,0,0,0,,‫«هر کی یه بار‬\N‫'گایراستون وان' رو شروع کنه...»‬
Dialogue: 1,0:24:48.22,0:24:59.22,InfoBox,,0,0,0,,{\b1}Quatsch{\b0}\N{\c&H00FFFF&}چرت و پرته{\c}
Dialogue: 0,0:24:48.22,0:24:49.73,Standard,,0,0,0,,‫-‬\N‫{\u1}چرت و پرته{\u0}‬\N‫- خب صبر کن دیگه‬
Dialogue: 0,0:24:49.84,0:24:51.32,Standard,,0,0,0,,‫این دیگه مسخره‌ست‬
Dialogue: 0,0:24:51.52,0:24:54.03,Standard,,0,0,0,,‫انگار که مرگ‬\N‫با یه بازی کامپیوتری--‬
Dialogue: 0,0:24:55.92,0:24:57.76,Standard,,0,0,0,,‫ممکن بود جواب بده‬
Dialogue: 0,0:24:57.85,0:25:01.55,Standard,,0,0,0,,‫اعتیادش مثل کوکائینه،‬\N‫نزدیک بود کارمو از دست بدم‬
Dialogue: 0,0:25:01.62,0:25:03.05,Standard,,0,0,0,,‫اوه نه‬\N‫نه، نه، نه‬
Dialogue: 0,0:25:03.14,0:25:08.07,Standard,,0,0,0,,‫«و با اینکه مرگ‬\N‫خیلی قدرتمند و ترسناک بود،‬
Dialogue: 0,0:25:08.12,0:25:10.96,Standard,,0,0,0,,‫«اما اغلب احساس تنهایی می‌کرد‬
Dialogue: 0,0:25:11.68,0:25:14.75,Standard,,0,0,0,,‫«یا بهتره بگم، تنهاییِ سگی‬
Dialogue: 0,0:25:14.80,0:25:19.24,Standard,,0,0,0,,‫«چون همه جا مردم‬\N‫فقط ازش فرار می‌کردن‬
Dialogue: 0,0:25:19.47,0:25:24.47,Standard,,0,0,0,,‫«هیچ‌وقت به جشن تولد دعوت نمی‌شد،‬\N‫دوستی هم نداشت‬
Dialogue: 0,0:25:24.60,0:25:28.19,Standard,,0,0,0,,‫«حتی خرگوش‌ها هم نمی‌خواستن‬\N‫بذارن نوازششون کنه‬
Dialogue: 0,0:25:28.55,0:25:35.00,Standard,,0,0,0,,‫«اون فقط می‌خواست با بقیه‬\N‫راحت و بی‌خیال فوتبال بازی کنه‬
Dialogue: 0,0:25:35.48,0:25:38.36,Standard,,0,0,0,,‫«چون یه طرفدار دوآتیشه فوتبال بود‬
Dialogue: 0,0:25:39.20,0:25:42.19,Standard,,0,0,0,,‫«بیشتر از همه دوست داشت دروازه‌بان باشه»‬
Dialogue: 0,0:25:44.20,0:25:45.15,Standard,,0,0,0,,‫اتفاقاً شد‬
Dialogue: 0,0:25:46.88,0:25:48.11,Standard,,0,0,0,,‫- شد‬\N‫- شد‬
Dialogue: 0,0:26:16.32,0:26:18.67,Standard,,0,0,0,,‫دقیقاً همون‌جا رفت تو‬
Dialogue: 0,0:26:29.96,0:26:33.36,Standard,,0,0,0,,‫«و مرگ فهمید‬\N‫که باخته‬
Dialogue: 1,0:26:33.85,0:26:44.85,InfoBox,,0,0,0,,{\b1}wech{\b0}\N{\c&H00FFFF&}پی کارش{\c}
Dialogue: 0,0:26:33.85,0:26:35.56,Standard,,0,0,0,,‫«و رفت‬\N‫{\u1}پی کارش{\u0}‬\N‫»‬
Dialogue: 0,0:26:39.87,0:26:43.00,Standard,,0,0,0,,‫خودم به عقل جن هم نمی‌رسید‬
Dialogue: 0,0:26:43.14,0:26:46.80,Standard,,0,0,0,,‫- فکر می‌کنی واقع‌بینانه‌ست؟‬\N‫- مهم اینه که جواب بده‬
Dialogue: 0,0:26:47.13,0:26:52.28,Standard,,0,0,0,,‫«و بعد مرگ‬\N‫رفت دنبال یه شغل دیگه، فروشندگی‬
Dialogue: 0,0:26:54.82,0:26:58.47,Standard,,0,0,0,,‫«و یه ابزارفروشی باز کرد‬\N‫توی هنیگزدورف»‬
Dialogue: 0,0:26:59.68,0:27:00.77,Standard,,0,0,0,,‫خب...‬
Dialogue: 0,0:27:00.85,0:27:05.93,Standard,,0,0,0,,‫هرچی بیشتر فکر می‌کنم: ممکنه‬\N‫که اون موقع توی تولد‬
Dialogue: 0,0:27:06.02,0:27:07.98,Standard,,0,0,0,,‫یه پسر همسایه هم بوده باشه‬
Dialogue: 0,0:27:08.76,0:27:11.64,Standard,,0,0,0,,‫وگرنه کی می‌خواست اون کتابو بهت کادو بده؟‬
Dialogue: 0,0:27:27.80,0:27:30.40,Standard,,0,0,0,,‫عالیه، هرچی می‌خوام توش هست‬
Dialogue: 0,0:27:30.50,0:27:33.92,Standard,,0,0,0,,‫بعد فوتبال‬\N‫رفتیم دنبال گنج‬
Dialogue: 0,0:27:34.05,0:27:37.39,Standard,,0,0,0,,‫و من همه‌ی اون سکه‌های شکلاتی نوقایی رو پیدا کردم‬
Dialogue: 0,0:27:37.51,0:27:39.63,Standard,,0,0,0,,‫نه، اون من بودم‬
Dialogue: 0,0:27:39.88,0:27:43.11,Standard,,0,0,0,,‫- نه، من بودم‬\N‫- تو که اون قایق بادبانی‬
Dialogue: 0,0:27:43.20,0:27:45.04,Standard,,0,0,0,,‫کوچیک رو پیدا کردی‬
Dialogue: 0,0:27:45.13,0:27:47.64,Standard,,0,0,0,,‫- یادت نمیاد؟‬\N‫- حالا که می‌گی...‬
Dialogue: 0,0:27:47.88,0:27:50.51,Standard,,0,0,0,,‫همونی که دکمه‌ش از زیر...‬
Dialogue: 0,0:29:06.22,0:29:09.60,Standard,,0,0,0,,‫- برگشتم، همه چی روبه‌راهه؟‬\N‫- آره، همه چی خوبه‬
Dialogue: 0,0:29:09.68,0:29:12.75,Standard,,0,0,0,,‫۲۰ دقیقه دیگه منم می‌زنم به چاک‬
Dialogue: 0,0:29:12.88,0:29:14.04,Standard,,0,0,0,,‫خوبه‬
Dialogue: 0,0:29:14.17,0:29:15.88,Standard,,0,0,0,,‫خب، آقای دانویچ،‬
Dialogue: 0,0:29:15.99,0:29:18.64,Standard,,0,0,0,,‫بریم خلط‌ها رو ساکشن کنیم؟‬