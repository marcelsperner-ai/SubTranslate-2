Dialogue: 0,0:24:53.80,0:24:56.00,Standard,,0,0,0,,‫{\c&H00FF00&}تو اینجا چیکار می‌کنی؟‬\N‫هیچی{\c}‬
Dialogue: 0,0:24:56.16,0:24:58.16,Standard,,0,0,0,,‫{\c&HFFFFFF&}اخراج شدم‬\N‫چی شدی؟{\c}‬
Dialogue: 0,0:24:58.32,0:25:01.48,Standard,,0,0,0,,‫{\c&H00FF00&}فکر کردم داری از فریدا مراقبت می‌کنی‬\N‫اندی کمکم کرد{\c}‬
Dialogue: 0,0:25:01.64,0:25:04.88,Standard,,0,0,0,,‫{\c&H00FF00&}پس اون قراری که گذاشتیم چی شد؟‬\N‫فریدا اینجا خوشحاله{\c}‬
Dialogue: 0,0:25:04.92,0:25:06.88,Standard,,0,0,0,,‫{\c&HFFFF00&}اون عاشق اندیه‬\N‫منم عاشق فریدام{\c}‬
Dialogue: 0,0:25:07.04,0:25:08.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}(فریدا) اندی{\c}‬
Dialogue: 0,0:25:11.88,0:25:13.84,Standard,,0,0,0,,‫{\c&HFFFF00&}تو این سن فقط یه چیزایی بلغور می‌کنن{\c}‬
Dialogue: 0,0:25:13.88,0:25:16.16,Standard,,0,0,0,,‫{\c&HFFFF00&}فقط شبیه این بود که گفت...‬\N‫اندی{\c}‬
Dialogue: 0,0:25:16.84,0:25:19.64,Standard,,0,0,0,,‫{\c&H00FFFF&}قشنگ داره میگه «اندی»‬\N‫دمت گرم، تئو{\c}‬
Dialogue: 0,0:25:19.68,0:25:23.44,Standard,,0,0,0,,‫{\c&H00FF00&}چون تو حواست بهش نبود‬\N‫اولین کلمه فریدا شد «اندی»{\c}‬
Dialogue: 0,0:25:23.60,0:25:25.20,Standard,,0,0,0,,‫{\c&H00FFFF&}کجاش بده مگه؟{\c}‬
Dialogue: 0,0:25:25.36,0:25:28.12,Standard,,0,0,0,,‫{\c&H00FF00&}بهتره به بچه خودت برسی‬\N‫من دیگه بچه نیستم{\c}‬
Dialogue: 0,0:25:28.16,0:25:30.12,Standard,,0,0,0,,‫{\c&H00FF00&}منظورم این نبود{\c}‬
Dialogue: 0,0:25:30.28,0:25:33.08,Standard,,0,0,0,,‫{\c&HFFFF00&}بیا بگیم‬\N‫اولین کلمه‌اش «مامان» بوده{\c}‬
Dialogue: 0,0:25:33.24,0:25:36.64,Standard,,0,0,0,,‫{\c&HFFFF00&}یا مثلاً «سلام» که خنثی باشه‬\N‫روکو یه همستر گرفته{\c}‬
Dialogue: 0,0:25:36.80,0:25:38.76,Standard,,0,0,0,,‫{\c&HFFFFFF&}فلکی دوباره مرده‬\N‫ها؟{\c}‬
Dialogue: 0,0:25:38.92,0:25:41.52,Standard,,0,0,0,,‫{\c&H00FF00&}بذار برم پیش فریدا‬\N‫هر وقت آروم شدی{\c}‬
Dialogue: 0,0:25:41.56,0:25:44.76,Standard,,0,0,0,,‫{\c&H00FFFF&}استرس براش خوب نیست‬\N‫دخترمون رو پس بده{\c}‬
Dialogue: 0,0:25:44.80,0:25:47.24,Standard,,0,0,0,,‫{\c&H00FF00&}دختر شما؟{\c}‬\N‫{\c&HFFFF00&}عزیزم، منظورم دختر خودمون بود{\c}‬
Dialogue: 1,0:25:47.40,0:25:58.40,InfoBox,,0,0,0,,{\b1}jemanden fragen, ob er sie noch alle hat{\b0}\N{\c&H00FFFF&}مخ‌ت تاب برداشته؟{\c}
Dialogue: 0,0:25:47.40,0:25:50.48,Standard,,0,0,0,,‫{\c&H00FFFF&}به یه جورایی دختر ما هم هست{\c}‬\N‫{\c&H00FF00&}‬\N‫{\u1}مخ‌ت تاب برداشته؟{\u0}‬\N‫{\c}‬
Dialogue: 1,0:25:50.52,0:26:01.52,InfoBox,,0,0,0,,{\b1}spinnen{\b0}\N{\c&H00FFFF&}رد دادن / دیوانه بودن{\c}
Dialogue: 0,0:25:50.52,0:25:53.56,Standard,,0,0,0,,‫{\c&H00FF00&}شماها دیگه‬\N‫{\u1}رد دادین{\u0}‬\N‫{\c}‬\N‫{\c&H00FFFF&}ما روزا یه جورایی خانواده‌ایم{\c}‬
Dialogue: 0,0:25:53.60,0:25:55.08,Standard,,0,0,0,,‫{\c&H00FF00&}داری چی میگی اندی؟{\c}‬
Dialogue: 0,0:25:55.24,0:25:59.16,Standard,,0,0,0,,‫{\c&H00FFFF&}ما کلی مراقبش بودیم، چند روز{\c}‬\N‫{\c&H00FFFF&}تو اصلاً خبر نداری{\c}‬
Dialogue: 0,0:25:59.20,0:26:00.92,Standard,,0,0,0,,‫{\c&H00FF00&}بسه دیگه اندی{\c}‬\N‫{\c&H00FFFF&}این تئو...{\c}‬
Dialogue: 0,0:26:00.96,0:26:02.76,Standard,,0,0,0,,‫{\c&H00FF00&}اندی، برو کنار{\c}‬\N‫{\c&H00FFFF&}نه!{\c}‬
Dialogue: 0,0:26:02.80,0:26:04.28,Standard,,0,0,0,,‫{\c&H00FF00&}اندی، برو کنار{\c}‬
Dialogue: 0,0:26:04.44,0:26:06.32,Standard,,0,0,0,,‫{\c&HFFFFFF&}* هم‌زمان با هم حرف می‌زنند *{\c}‬\N‫{\c&HFFFFFF&}هیس{\c}‬
Dialogue: 0,0:26:08.88,0:26:10.88,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی ملایم *{\c}‬
Dialogue: 0,0:26:18.16,0:26:19.64,Standard,,0,0,0,,‫{\c&HFFFFFF&}همه چی مرتبه{\c}‬
Dialogue: 0,0:26:20.12,0:26:25.44,Standard,,0,0,0,,‫{\c&HFFFFFF&}♪ عزیزم، عسلم، موشی، بیبی{\c}‬
Dialogue: 0,0:26:26.28,0:26:31.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}اگه دنبال من می‌گردی{\c}‬
Dialogue: 0,0:26:32.32,0:26:39.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}من پایین{\c}‬\N‫{\c&HFFFFFF&}روی کاناپه زیرزمینم ♪{\c}‬
Dialogue: 0,0:26:40.92,0:26:42.92,Standard,,0,0,0,,‫{\c&HFFFFFF&}زیرنویس به سفارش زد‌دی‌اف،{\c}‬\N‫{\c&HFFFFFF&}۲۰۲۳{\c}‬