Dialogue: 0,0:23:41.00,0:23:45.56,Standard,,0,0,0,,‫{\c&H00FFFF&}چی... تو اینجا چیکار می‌کنی؟{\c}‬\N‫{\c&H00FFFF&}اصلاً اینجا کجاست؟{\c}‬
Dialogue: 0,0:23:49.20,0:23:50.88,Standard,,0,0,0,,‫{\c&H00FF00&}خیلی متاسفم{\c}‬
Dialogue: 0,0:23:51.40,0:23:52.64,Standard,,0,0,0,,‫{\c&H00FFFF&}واسه چی؟{\c}‬
Dialogue: 0,0:23:52.88,0:23:54.04,Standard,,0,0,0,,‫{\c&H00FF00&}همه چی{\c}‬
Dialogue: 0,0:23:54.24,0:23:56.40,Standard,,0,0,0,,‫{\c&H00FF00&}البته بیشترش واسه ما دوتا{\c}‬
Dialogue: 0,0:23:56.60,0:23:58.56,Standard,,0,0,0,,‫{\c&H00FFFF&}چی... منظورت چیه؟{\c}‬
Dialogue: 0,0:23:59.48,0:24:02.48,Standard,,0,0,0,,‫{\c&H00FF00&}همیشه امیدوار بودم{\c}‬\N‫{\c&H00FF00&}که دوباره برگردیم به هم{\c}‬
Dialogue: 0,0:24:02.92,0:24:03.92,Standard,,0,0,0,,‫{\c&H00FFFF&}منم همین‌طور{\c}‬
Dialogue: 0,0:24:04.44,0:24:06.16,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی اون جراح قلب...{\c}‬
Dialogue: 0,0:24:06.36,0:24:10.28,Standard,,0,0,0,,‫{\c&H00FF00&}همیشه می‌دونستم که اون{\c}‬\N‫{\c&H00FF00&}آدمش نبود{\c}‬\N‫{\c&H00FFFF&}آره، منم می‌دونستم{\c}‬
Dialogue: 0,0:24:10.72,0:24:12.92,Standard,,0,0,0,,‫{\c&H00FFFF&}چرا این‌قدر پیشش موندی؟{\c}‬
Dialogue: 0,0:24:12.96,0:24:14.48,Standard,,0,0,0,,‫{\c&H00FF00&}آدم همیشه فکر می‌کنه:{\c}‬
Dialogue: 0,0:24:14.84,0:24:17.36,Standard,,0,0,0,,‫{\c&H00FF00&}حتماً یه حکمتی توشه{\c}‬
Dialogue: 0,0:24:17.44,0:24:19.28,Standard,,0,0,0,,‫{\c&H00FF00&}تا اینکه می‌فهمی: صبر کن ببینم{\c}‬
Dialogue: 0,0:24:20.44,0:24:22.72,Standard,,0,0,0,,‫{\c&H00FF00&}من کلاً دارم طبق ساز بقیه می‌رقصم{\c}‬
Dialogue: 1,0:24:22.76,0:24:33.76,InfoBox,,0,0,0,,{\b1}den Mund aufmachen{\b0}\N{\c&H00FFFF&}دهن باز کنه{\c}
Dialogue: 0,0:24:22.76,0:24:26.40,Standard,,0,0,0,,‫{\c&H00FF00&}بعدش هم آدم جرئت نمی‌کنه{\c}‬\N‫{\c&H00FF00&}‬\N‫{\u1}دهن باز کنه{\u0}‬\N‫{\c}‬
Dialogue: 0,0:24:26.48,0:24:29.68,Standard,,0,0,0,,‫{\c&H00FF00&}یهو می‌بینی دیگه خیلی دیره{\c}‬\N‫{\c&H00FFFF&}هیچ‌وقت دیر نیست{\c}‬
Dialogue: 0,0:24:29.76,0:24:32.40,Standard,,0,0,0,,‫{\c&H00FFFF&}همین الان،{\c}‬\N‫{\c&H00FFFF&}بزن کات کن{\c}‬
Dialogue: 0,0:24:32.44,0:24:33.72,Standard,,0,0,0,,‫{\c&H00FFFF&}می‌تونم باهات بیام{\c}‬
Dialogue: 0,0:24:33.80,0:24:36.68,Standard,,0,0,0,,‫{\c&H00FFFF&}می‌تونم بهش بگم{\c}‬\N‫{\c&H00FF00&}کاش به همین سادگی بود{\c}‬
Dialogue: 0,0:24:36.72,0:24:39.56,Standard,,0,0,0,,‫{\c&H00FF00&}کلی جنگیدم{\c}‬\N‫{\c&H00FF00&}که بتونیم همدیگه رو ببینیم{\c}‬
Dialogue: 0,0:24:39.80,0:24:42.20,Standard,,0,0,0,,‫{\c&H00FFFF&}تهدیدت می‌کنه؟{\c}‬\N‫{\c&H00FF00&}چی؟ نه{\c}‬
Dialogue: 0,0:24:44.40,0:24:46.96,Standard,,0,0,0,,‫{\c&H00FF00&}هنوز خبر نداری؟{\c}‬\N‫{\c&H00FFFF&}چه خبری؟{\c}‬
Dialogue: 0,0:24:48.08,0:24:49.44,Standard,,0,0,0,,‫{\c&H00FF00&}همه چی تمومه{\c}‬
Dialogue: 0,0:24:50.60,0:24:53.96,Standard,,0,0,0,,‫{\c&H00FFFF&}خب این که عالیه!{\c}‬\N‫{\c&H00FFFF&}منم همین رو می‌گم{\c}‬
Dialogue: 0,0:24:54.04,0:24:55.36,Standard,,0,0,0,,‫{\c&H00FF00&}نه{\c}‬
Dialogue: 0,0:24:56.12,0:24:57.48,Standard,,0,0,0,,‫{\c&H00FF00&}منظورم این نیست{\c}‬
Dialogue: 0,0:24:57.88,0:25:00.40,Standard,,0,0,0,,‫{\c&H00FF00&}منظورم کل قضیه‌ست، همه چی داره تموم می‌شه{\c}‬
Dialogue: 0,0:25:00.60,0:25:03.36,Standard,,0,0,0,,‫{\c&H00FFFF&}چرت نگو، تازه اولشه!{\c}‬
Dialogue: 0,0:25:03.48,0:25:04.84,Standard,,0,0,0,,‫{\c&H00FF00&}طبقه ۳۲ وجود نداره{\c}‬
Dialogue: 0,0:25:06.20,0:25:07.68,Standard,,0,0,0,,‫{\c&H00FFFF&}چی؟ نه بابا{\c}‬
Dialogue: 0,0:25:08.08,0:25:11.16,Standard,,0,0,0,,‫{\c&H00FFFF&}عجیبه که حتی نمی‌شه{\c}‬\N‫{\c&H00FFFF&}رفت طبقه ۳۱!{\c}‬
Dialogue: 0,0:25:11.24,0:25:12.56,Standard,,0,0,0,,‫{\c&H00FF00&}دوستت دارم{\c}‬
Dialogue: 0,0:25:14.32,0:25:15.68,Standard,,0,0,0,,‫{\c&H00FFFF&}منم دوستت دارم!{\c}‬
Dialogue: 0,0:25:15.72,0:25:18.36,Standard,,0,0,0,,‫{\c&H00FFFF&}تو... تو{\c}‬\N‫{\c&H00FFFF&}عشق زندگی منی{\c}‬
Dialogue: 0,0:25:19.16,0:25:21.84,Standard,,0,0,0,,‫{\c&H00FF00&}خیلی دلم می‌خواست{\c}‬\N‫{\c&H00FF00&}بیشتر وقت داشتم باهات باشم{\c}‬
Dialogue: 0,0:25:22.28,0:25:26.80,Standard,,0,0,0,,‫{\c&H00FFFF&}خب این که دست خودته{\c}‬\N‫{\c&H00FF00&}نه! اتفاقاً اصلاً دست من نیست!{\c}‬
Dialogue: 0,0:25:27.00,0:25:29.56,Standard,,0,0,0,,‫{\c&H00FF00&}واقعاً کلی امید بسته بودم{\c}‬
Dialogue: 0,0:25:29.88,0:25:31.28,Standard,,0,0,0,,‫{\c&H00FF00&}چه گندی شد{\c}‬
Dialogue: 0,0:25:32.64,0:25:35.56,Standard,,0,0,0,,‫{\c&H00FFFF&}چی شده؟{\c}‬\N‫{\c&H00FFFF&}خیلی... خیلی عجیبی{\c}‬
Dialogue: 0,0:25:36.84,0:25:39.84,Standard,,0,0,0,,‫{\c&H00FF00&}آره، واسه همینم{\c}‬\N‫{\c&H00FF00&}کلی زحمت کشیدم{\c}‬
Dialogue: 0,0:25:40.16,0:25:42.68,Standard,,0,0,0,,‫{\c&H00FF00&}ولی خب واسه هیچ‌کس مهم نیست{\c}‬
Dialogue: 0,0:25:42.72,0:25:45.64,Standard,,0,0,0,,‫{\c&H00FF00&}همه فقط اون آدمِ{\c}‬\N‫{\c&H00FF00&}احساساتی رو می‌بینن{\c}‬
Dialogue: 0,0:25:45.72,0:25:48.28,Standard,,0,0,0,,‫{\c&H00FF00&}معلومه که می‌تونم{\c}‬\N‫{\c&H00FF00&}بامزه هم باشم{\c}‬
Dialogue: 0,0:25:58.40,0:26:01.04,Standard,,0,0,0,,‫{\c&H00FF00&}حتی رقصِ تپ رو هم{\c}‬\N‫{\c&H00FF00&}خودم یاد گرفتم{\c}‬
Dialogue: 0,0:26:01.08,0:26:02.92,Standard,,0,0,0,,‫{\c&H00FF00&}چون اولش گفتن که...{\c}‬
Dialogue: 0,0:26:03.04,0:26:05.56,Standard,,0,0,0,,‫{\c&H00FFFF&}اصلاً نمی‌دونم چی بگم{\c}‬
Dialogue: 0,0:26:05.72,0:26:08.28,Standard,,0,0,0,,‫{\c&H00FF00&}می‌گی که خب،{\c}‬\N‫{\c&H00FF00&}همینه که هست{\c}‬
Dialogue: 0,0:26:08.36,0:26:12.52,Standard,,0,0,0,,‫{\c&H00FF00&}و اینکه باید بابتِ وقتی که{\c}‬\N‫{\c&H00FF00&}با هم داشتیم شکرگزار باشیم{\c}‬
Dialogue: 0,0:26:14.44,0:26:16.68,Standard,,0,0,0,,‫{\c&H00FFFF&}چی؟ نه! اصلاً همچین چیزی نیست{\c}‬
Dialogue: 0,0:26:16.76,0:26:18.60,Standard,,0,0,0,,‫{\c&H00FFFF&}این اصلاً حقیقت نداره{\c}‬
Dialogue: 0,0:26:18.68,0:26:21.88,Standard,,0,0,0,,‫{\c&H00FFFF&}من می‌خوام که همه‌چی ادامه پیدا کنه{\c}‬\N‫{\c&H00FFFF&}بین ما، با تو{\c}‬
Dialogue: 1,0:26:22.12,0:26:33.12,InfoBox,,0,0,0,,{\b1}abhauen{\b0}\N{\c&H00FFFF&}زدی به چاک{\c}
Dialogue: 0,0:26:22.12,0:26:26.12,Standard,,0,0,0,,‫{\c&H00FFFF&}ما که اصلاً وقت نکردیم با هم باشیم،{\c}‬\N‫{\c&H00FFFF&}تو که‬\N‫{\u1}زدی به چاک{\u0}‬\N‫{\c}‬
Dialogue: 0,0:26:26.20,0:26:28.20,Standard,,0,0,0,,‫{\c&H00FF00&}اون تصمیمِ من نبود{\c}‬
Dialogue: 0,0:26:28.24,0:26:30.92,Standard,,0,0,0,,‫{\c&H00FFFF&}بعداً می‌تونی همه‌چیز رو{\c}‬\N‫{\c&H00FFFF&}با آرامش برام توضیح بدی{\c}‬
Dialogue: 0,0:26:30.96,0:26:33.48,Standard,,0,0,0,,‫{\c&H00FFFF&}فعلاً بیا بریم خونه من...{\c}‬
Dialogue: 0,0:26:33.84,0:26:35.00,Standard,,0,0,0,,‫{\c&H00FF00&}متاسفم{\c}‬
Dialogue: 0,0:26:40.68,0:26:42.32,Standard,,0,0,0,,‫{\c&HFFFF00&}چی؟ گلدون‌ها دیگه برای چی؟{\c}‬
Dialogue: 0,0:26:42.80,0:26:45.32,Standard,,0,0,0,,‫{\c&HFFFFFF&}این استعاره‌ی{\c}‬\N‫{\c&HFFFFFF&}جالب‌تریه{\c}‬
Dialogue: 0,0:26:45.48,0:26:47.16,Standard,,0,0,0,,‫{\c&H00FFFF&}بیا، بزنیم بیرون{\c}‬
Dialogue: 0,0:26:47.32,0:26:50.76,Standard,,0,0,0,,‫{\c&H00FFFF&}باید از اینجا بریم{\c}‬\N‫{\c&H00FF00&}شاتی، فایده‌ای نداره{\c}‬
Dialogue: 0,0:26:50.84,0:26:54.36,Standard,,0,0,0,,‫{\c&H00FFFF&}نه، بیخیال{\c}‬\N‫{\c&H00FF00&}ولم کن، نمی‌خوام دردسر درست شه{\c}‬
Dialogue: 0,0:26:54.80,0:26:57.56,Standard,,0,0,0,,‫{\c&H00FF00&}من حتی کلِ{\c}‬\N‫{\c&H00FF00&}سخنرانی رو هم حفظ کردم{\c}‬
Dialogue: 0,0:26:57.64,0:27:00.00,Standard,,0,0,0,,‫{\c&H00FFFF&}چه سخنرانی‌ای؟{\c}‬\N‫{\c&H00FF00&}درباره تو{\c}‬
Dialogue: 0,0:27:00.68,0:27:02.84,Standard,,0,0,0,,‫{\c&H00FFFF&}تو می‌خوای سخنرانی کنی؟ درباره من؟{\c}‬
Dialogue: 0,0:27:03.16,0:27:05.72,Standard,,0,0,0,,‫{\c&H00FF00&}نگران نباش،{\c}‬\N‫{\c&H00FF00&}فقط چیزای خوب می‌گم{\c}‬
Dialogue: 0,0:27:05.84,0:27:08.76,Standard,,0,0,0,,‫{\c&H00FF00&}و این سخنرانی{\c}‬\N‫{\c&H00FF00&}تنها اجرای بزرگِ منه{\c}‬
Dialogue: 0,0:27:08.80,0:27:11.16,Standard,,0,0,0,,‫{\c&H00FF00&}نمی‌خوام این فرصت رو{\c}‬\N‫{\c&H00FF00&}از دست بدم{\c}‬
Dialogue: 0,0:27:12.52,0:27:13.88,Standard,,0,0,0,,‫{\c&H00FF00&}می‌خوای بشنوی؟{\c}‬
Dialogue: 0,0:27:13.92,0:27:15.24,Standard,,0,0,0,,‫{\c&H00FFFF&}اِ... آره{\c}‬
Dialogue: 0,0:27:17.80,0:27:19.08,Standard,,0,0,0,,‫{\c&H00FF00&}خب، اِ...{\c}‬
Dialogue: 0,0:27:28.00,0:27:29.36,Standard,,0,0,0,,‫{\c&H00FF00&}(گلویش را صاف می‌کند){\c}‬
Dialogue: 0,0:27:34.32,0:27:35.68,Standard,,0,0,0,,‫{\c&H00FF00&}(گلویش را صاف می‌کند){\c}‬
Dialogue: 0,0:27:38.08,0:27:39.08,Standard,,0,0,0,,‫{\c&H00FF00&}هایکو عزیز{\c}‬
Dialogue: 0,0:27:40.76,0:27:43.92,Standard,,0,0,0,,‫{\c&H00FF00&}وقتی پریروز{\c}‬\N‫{\c&H00FF00&}اون خبر رو شنیدم{\c}‬
Dialogue: 0,0:27:44.00,0:27:47.80,Standard,,0,0,0,,‫{\c&H00FF00&}اولین چیزی که به ذهنم رسید این بود که{\c}‬\N‫{\c&H00FF00&}یه شوخی مسخره‌ست{\c}‬
Dialogue: 0,0:27:49.52,0:27:50.96,Standard,,0,0,0,,‫{\c&H00FF00&}یه اشتباه{\c}‬
Dialogue: 0,0:27:51.04,0:27:52.64,Standard,,0,0,0,,‫{\c&H00FF00&}خلاصه یه سوءتفاهم{\c}‬
Dialogue: 0,0:27:53.72,0:27:56.24,Standard,,0,0,0,,‫{\c&H00FF00&}و... واقعاً هم یه اشتباهه{\c}‬
Dialogue: 0,0:27:57.56,0:27:59.64,Standard,,0,0,0,,‫{\c&H00FF00&}یه اشتباه وحشتناک و بی‌معنی{\c}‬
Dialogue: 0,0:28:00.48,0:28:02.56,Standard,,0,0,0,,‫{\c&H00FF00&}با این حال... حقیقته{\c}‬
Dialogue: 0,0:28:03.40,0:28:04.68,Standard,,0,0,0,,‫{\c&H00FF00&}و این‌طوری...{\c}‬
Dialogue: 0,0:28:05.60,0:28:09.04,Standard,,0,0,0,,‫{\c&H00FF00&}امروز غم‌انگیزترین روز{\c}‬\N‫{\c&H00FF00&}زندگی منه{\c}‬
Dialogue: 0,0:28:09.08,0:28:10.32,Standard,,0,0,0,,‫{\c&H00FF00&}می‌خوام...{\c}‬
Dialogue: 0,0:28:10.40,0:28:13.60,Standard,,0,0,0,,‫{\c&H00FF00&}با خودم عهد کردم{\c}‬\N‫{\c&H00FF00&}که گریه نکنم{\c}‬
Dialogue: 0,0:28:13.72,0:28:16.64,Standard,,0,0,0,,‫{\c&H00FF00&}چون می‌دونم{\c}‬\N‫{\c&H00FF00&}تو اینو نمی‌خواستی{\c}‬
Dialogue: 0,0:28:17.04,0:28:20.24,Standard,,0,0,0,,‫{\c&H00FF00&}و اگه می‌دونستی{\c}‬\N‫{\c&H00FF00&}که تو دلیلِ{\c}‬
Dialogue: 0,0:28:21.04,0:28:24.04,Standard,,0,0,0,,‫{\c&H00FF00&}غمگین بودنِ این همه آدم{\c}‬\N‫{\c&H00FF00&}در امروز هستی{\c}‬
Dialogue: 0,0:28:24.16,0:28:27.36,Standard,,0,0,0,,‫{\c&H00FF00&}اولین نفری بودی که{\c}‬\N‫{\c&H00FF00&}سعی می‌کردی{\c}‬
Dialogue: 1,0:28:27.44,0:28:38.44,InfoBox,,0,0,0,,{\b1}die Stimmung auflockern{\b0}\N{\c&H00FFFF&}فضا رو عوض کنی{\c}
Dialogue: 0,0:28:27.44,0:28:29.60,Standard,,0,0,0,,‫{\c&H00FF00&}‬\N‫{\u1}فضا رو عوض کنی{\u0}‬\N‫{\c}‬
Dialogue: 0,0:28:32.16,0:28:35.08,Standard,,0,0,0,,‫{\c&H00FF00&}حالا یه نقل‌قول از خودت میارم{\c}‬\N‫{\c&H00FF00&}یه چیزی تو این مایه‌ها:{\c}‬
Dialogue: 0,0:28:35.84,0:28:39.28,Standard,,0,0,0,,‫{\c&H00FF00&}«وقتی مرگ میاد،{\c}‬\N‫{\c&H00FF00&}دیگه کار تمومه» یا یه همچین چیزی{\c}‬
Dialogue: 0,0:28:39.60,0:28:40.96,Standard,,0,0,0,,‫{\c&H00FFFF&}این مال منه؟{\c}‬
Dialogue: 0,0:28:41.16,0:28:43.60,Standard,,0,0,0,,‫{\c&H00FF00&}حداقلش که می‌تونه مال تو باشه{\c}‬
Dialogue: 0,0:28:44.16,0:28:45.52,Standard,,0,0,0,,‫{\c&H00FF00&}(گلویش را صاف می‌کند){\c}‬
Dialogue: 0,0:28:45.64,0:28:48.28,Standard,,0,0,0,,‫{\c&H00FF00&}تو هیچ‌وقت نمی‌خواستی{\c}‬\N‫{\c&H00FF00&}آدم خاصی باشی{\c}‬
Dialogue: 0,0:28:49.48,0:28:51.16,Standard,,0,0,0,,‫{\c&H00FF00&}ولی بودی{\c}‬
Dialogue: 0,0:28:52.72,0:28:56.88,Standard,,0,0,0,,‫{\c&H00FF00&}کمتر کسی می‌دونست که پشت{\c}‬\N‫{\c&H00FF00&}شاتیِ شوخ‌طبع و بذله‌گو{\c}‬
Dialogue: 0,0:28:58.04,0:29:00.84,Standard,,0,0,0,,‫{\c&H00FF00&}یه شاتیِ دیگه هم{\c}‬\N‫{\c&H00FF00&}قایم شده بود{\c}‬
Dialogue: 0,0:29:02.80,0:29:04.64,Standard,,0,0,0,,‫{\c&H00FF00&}یکی که خیلی جدی بود{\c}‬
Dialogue: 0,0:29:04.76,0:29:09.00,Standard,,0,0,0,,‫{\c&H00FF00&}که کلی فکر و خیال داشت و{\c}‬\N‫{\c&H00FF00&}در نهایت هم تنها بود{\c}‬
Dialogue: 0,0:29:09.56,0:29:10.80,Standard,,0,0,0,,‫{\c&H00FFFF&}چی؟{\c}‬
Dialogue: 0,0:29:11.00,0:29:14.00,Standard,,0,0,0,,‫{\c&H00FFFF&}من که اصلاً خبر ندارم{\c}‬\N‫{\c&H00FF00&}ولی خب، هست{\c}‬
Dialogue: 0,0:29:15.64,0:29:19.80,Standard,,0,0,0,,‫{\c&H00FF00&}درباره شغلت به عنوان پاک‌کننده صحنه جرم{\c}‬\N‫{\c&H00FF00&}گفته بودی:{\c}‬
Dialogue: 0,0:29:20.56,0:29:25.08,Standard,,0,0,0,,‫{\c&H00FF00&}«جایی که بقیه از وحشت{\c}‬\N‫{\c&H00FF00&}بالا میارن، کار من شروع می‌شه»{\c}‬
Dialogue: 0,0:29:26.64,0:29:30.20,Standard,,0,0,0,,‫{\c&H00FF00&}کاری که خیلی وقتا{\c}‬\N‫{\c&H00FF00&}برات آسون نبود{\c}‬
Dialogue: 0,0:29:30.40,0:29:35.24,Standard,,0,0,0,,‫{\c&H00FF00&}کاری که هر روز تو رو با{\c}‬\N‫{\c&H00FF00&}زودگذر بودن زندگی روبرو می‌کرد{\c}‬
Dialogue: 0,0:29:35.32,0:29:37.40,Standard,,0,0,0,,‫{\c&H00FF00&}با بی‌رحمیِ مرگ{\c}‬
Dialogue: 0,0:29:37.64,0:29:38.76,Standard,,0,0,0,,‫{\c&H00FF00&}و این سوال که:{\c}‬
Dialogue: 0,0:29:40.28,0:29:41.52,Standard,,0,0,0,,‫{\c&H00FF00&}چی باقی می‌مونه...{\c}‬
Dialogue: 0,0:29:42.80,0:29:44.36,Standard,,0,0,0,,‫{\c&H00FF00&}... وقتی یکی می‌میره؟{\c}‬
Dialogue: 0,0:29:45.64,0:29:49.64,Standard,,0,0,0,,‫{\c&H00FF00&}جوابِ همیشه بی‌خیالِ تو این بود:{\c}‬\N‫{\c&H00FF00&}«کار باقی می‌مونه{\c}‬
Dialogue: 0,0:29:49.84,0:29:54.56,Standard,,0,0,0,,‫{\c&H00FF00&}اگه کارمو خوب انجام داده باشم{\c}‬\N‫{\c&H00FF00&}دیگه هیچی باقی نمی‌مونه»{\c}‬
Dialogue: 0,0:29:56.44,0:29:57.84,Standard,,0,0,0,,‫{\c&H00FF00&}هایکو عزیز{\c}‬
Dialogue: 0,0:29:58.80,0:30:02.88,Standard,,0,0,0,,‫{\c&H00FF00&}من همیشه تو این مورد{\c}‬\N‫{\c&H00FF00&}با تو مخالف بودم...{\c}‬
Dialogue: 0,0:30:04.04,0:30:06.20,Standard,,0,0,0,,‫{\c&H00FF00&}... و الان هم هستم{\c}‬
Dialogue: 0,0:30:06.28,0:30:10.72,Standard,,0,0,0,,‫{\c&H00FF00&}ردپاهایی که یه آدم از خودش به جا می‌ذاره{\c}‬\N‫{\c&H00FF00&}با هیچ پاک‌کننده‌ای پاک نمی‌شه{\c}‬
Dialogue: 0,0:30:12.48,0:30:14.04,Standard,,0,0,0,,‫{\c&H00FF00&}اونا همیشه هستن{\c}‬
Dialogue: 0,0:30:15.16,0:30:19.20,Standard,,0,0,0,,‫{\c&H00FF00&}هر چیزی که انجام دادیم،‬\N‫زندگی کردیم، عاشق شدیم...{\c}‬
Dialogue: 0,0:30:21.36,0:30:23.28,Standard,,0,0,0,,‫{\c&H00FF00&}...همیشه باقی می‌مونه{\c}‬
Dialogue: 0,0:30:24.84,0:30:25.96,Standard,,0,0,0,,‫{\c&H00FF00&}یه جایی{\c}‬
Dialogue: 0,0:30:26.64,0:30:28.80,Standard,,0,0,0,,‫{\c&H00FF00&}کائنات هیچی رو از دست نمی‌ده{\c}‬
Dialogue: 0,0:30:30.28,0:30:34.44,Standard,,0,0,0,,‫{\c&H00FF00&}خاطره‌ت باقی می‌مونه،‬\N‫که تو توش زنده می‌مونی{\c}‬
Dialogue: 0,0:30:36.84,0:30:40.36,Standard,,0,0,0,,‫{\c&H00FF00&}قدردانی برای زمانی که‬\N‫با هم داشتیم باقی می‌مونه{\c}‬
Dialogue: 0,0:30:41.76,0:30:43.68,Standard,,0,0,0,,‫{\c&H00FF00&}و کلی عشق باقی می‌مونه{\c}‬
Dialogue: 0,0:30:44.16,0:30:46.68,Standard,,0,0,0,,‫{\c&H00FF00&}و... یه جای خالی باقی می‌مونه...{\c}‬
Dialogue: 0,0:30:48.20,0:30:50.12,Standard,,0,0,0,,‫{\c&H00FF00&}...که تو از خودت به جا گذاشتی{\c}‬
Dialogue: 0,0:30:51.32,0:30:53.04,Standard,,0,0,0,,‫{\c&H00FF00&}یه جای خالی دردناک{\c}‬
Dialogue: 0,0:30:53.08,0:30:56.64,Standard,,0,0,0,,‫{\c&H00FF00&}که هیچ‌کس و هیچ‌چیز‬\N‫نمی‌تونه پرش کنه{\c}‬
Dialogue: 0,0:30:58.32,0:30:59.60,Standard,,0,0,0,,‫{\c&H00FF00&}هایکو شوته:{\c}‬
Dialogue: 1,0:31:00.68,0:31:11.68,InfoBox,,0,0,0,,{\b1}ein feiner Kerl{\b0}\N{\c&H00FFFF&}آدم حسابی‌ای{\c}
Dialogue: 0,0:31:00.68,0:31:02.64,Standard,,0,0,0,,‫{\c&H00FF00&}تو‬\N‫{\u1}آدم حسابی‌ای{\u0}‬\N‫بودی{\c}‬
Dialogue: 0,0:31:02.92,0:31:06.48,Standard,,0,0,0,,‫{\c&H00FF00&}باشرف، کمک‌حال،‬\N‫با حس عدالت‌خواهی{\c}‬
Dialogue: 0,0:31:07.56,0:31:10.84,Standard,,0,0,0,,‫{\c&H00FF00&}تو دنیا رو‬\N‫یه ذره صادق‌تر کردی{\c}‬
Dialogue: 0,0:31:12.40,0:31:14.32,Standard,,0,0,0,,‫{\c&H00FF00&}تو دنیا رو شادتر کردی{\c}‬
Dialogue: 0,0:31:14.40,0:31:18.24,Standard,,0,0,0,,‫{\c&H00FF00&}و تازه تو...‬\N‫یه ذره هم تمیزترش کردی{\c}‬
Dialogue: 0,0:31:20.48,0:31:22.80,Standard,,0,0,0,,‫{\c&H00FF00&}حرفه‌ای و دقیق...{\c}‬
Dialogue: 0,0:31:24.20,0:31:25.80,Standard,,0,0,0,,‫{\c&H00FF00&}...توی کارت{\c}‬
Dialogue: 0,0:31:27.96,0:31:32.48,Standard,,0,0,0,,‫{\c&H00FF00&}بی‌غل‌وغش، دست‌ودلباز و‬\N‫رک و راست با اطرافیانت{\c}‬
Dialogue: 0,0:31:34.48,0:31:37.64,Standard,,0,0,0,,‫{\c&H00FF00&}یکی از اون اطرافیان...‬\N‫من بودم{\c}‬
Dialogue: 0,0:31:39.24,0:31:42.04,Standard,,0,0,0,,‫{\c&H00FF00&}و چقدر دلم می‌خواست‬\N‫بیشتر از اینا باشم{\c}‬
Dialogue: 0,0:31:42.32,0:31:43.88,Standard,,0,0,0,,‫{\c&H00FF00&}همدم زندگیت{\c}‬
Dialogue: 0,0:31:45.80,0:31:48.40,Standard,,0,0,0,,‫{\c&H00FF00&}دوستت. زنت{\c}‬
Dialogue: 0,0:31:49.72,0:31:54.08,Standard,,0,0,0,,‫{\c&H00FF00&}وای لعنتی، فکر نمی‌کردم{\c}‬\N‫{\c&H00FF00&}انقدر سخت باشه{\c}‬
Dialogue: 0,0:31:58.60,0:31:59.60,Standard,,0,0,0,,‫{\c&H00FFFF&}ببین...{\c}‬
Dialogue: 0,0:31:59.72,0:32:01.08,Standard,,0,0,0,,‫{\c&H00FFFF&}داری به من{\c}‬
Dialogue: 0,0:32:01.20,0:32:04.04,Standard,,0,0,0,,‫{\c&H00FFFF&}یه پیشنهاد ازدواج عجیب و غریب{\c}‬\N‫{\c&H00FFFF&}می‌دی؟{\c}‬
Dialogue: 0,0:32:04.28,0:32:07.72,Standard,,0,0,0,,‫{\c&H00FF00&}خداوکیلی، از چیزی که هست{\c}‬\N‫{\c&H00FF00&}سخت‌ترش نکن{\c}‬
Dialogue: 0,0:32:07.80,0:32:09.36,Standard,,0,0,0,,‫{\c&H00FF00&}بفهم دیگه:{\c}‬
Dialogue: 1,0:32:09.40,0:32:20.40,InfoBox,,0,0,0,,{\b1}Sense sein{\b0}\N{\c&H00FFFF&}ته خط{\c}
Dialogue: 0,0:32:09.40,0:32:11.32,Standard,,0,0,0,,‫{\c&H00FF00&}تموم شد، رفت،‬\N‫{\u1}ته خط{\u0}‬\N‫{\c}‬
Dialogue: 0,0:32:14.52,0:32:16.24,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی چی ته خط؟{\c}‬
Dialogue: 0,0:32:17.08,0:32:20.64,Standard,,0,0,0,,‫{\c&H00FF00&}الان باید اون لوستر{\c}‬\N‫{\c&H00FF00&}می‌افتاد پایین{\c}‬
Dialogue: 0,0:32:20.72,0:32:24.28,Standard,,0,0,0,,‫{\c&H00FF00&}ولی خب... انگار اینجا{\c}‬\N‫{\c&H00FF00&}دوباره تغییرش دادن{\c}‬
Dialogue: 0,0:32:24.36,0:32:27.16,Standard,,0,0,0,,‫{\c&HFFFF00&}و بالاخره یه جایی{\c}‬\N‫{\c&HFFFF00&}دیگه خیلی دیره{\c}‬
Dialogue: 0,0:32:43.16,0:32:46.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}هشدار، هشدار، این یه تله‌ست{\c}‬
Dialogue: 0,0:32:52.04,0:32:54.68,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی هیجان‌انگیز *{\c}‬
Dialogue: 0,0:33:07.32,0:33:09.64,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی سنگین *{\c}‬
Dialogue: 0,0:33:30.40,0:33:31.76,Standard,,0,0,0,,‫{\c&H00FFFF&}ممنون{\c}‬
Dialogue: 0,0:33:40.20,0:33:42.88,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی *{\c}‬
Dialogue: 0,0:33:55.04,0:33:56.72,Standard,,0,0,0,,‫{\c&H00FFFF&}اصلاً بهش فکر هم نمی‌کنم{\c}‬
Dialogue: 0,0:33:56.84,0:33:58.64,Standard,,0,0,0,,‫{\c&H00FFFF&}هنوز که نباید اینطوری باشه{\c}‬
Dialogue: 0,0:33:59.56,0:34:01.00,Standard,,0,0,0,,‫{\c&H00FFFF&}باید یه اشتباهی شده باشه{\c}‬
Dialogue: 0,0:34:11.36,0:34:13.76,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی *{\c}‬
Dialogue: 0,0:34:27.80,0:34:29.44,Standard,,0,0,0,,‫{\c&H00FFFF&}مگه چیکار کردم؟{\c}‬
Dialogue: 0,0:34:29.72,0:34:32.08,Standard,,0,0,0,,‫{\c&H00FFFF&}من که به کسی کاری نداشتم{\c}‬
Dialogue: 0,0:34:32.12,0:34:35.12,Standard,,0,0,0,,‫{\c&H00FFFF&}همیشه هم{\c}‬\N‫{\c&H00FFFF&}کارم رو خوب انجام دادم{\c}‬
Dialogue: 0,0:34:35.44,0:34:36.68,Standard,,0,0,0,,‫{\c&H00FFFF&}خب معلومه{\c}‬
Dialogue: 0,0:34:36.80,0:34:39.08,Standard,,0,0,0,,‫{\c&H00FFFF&}یه چیزایی این وسط بود{\c}‬
Dialogue: 0,0:34:39.16,0:34:40.80,Standard,,0,0,0,,‫{\c&H00FFFF&}ولی اوضاع که خوبه{\c}‬
Dialogue: 0,0:34:40.96,0:34:45.12,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی در کل اوضاع...‬\N‫همه چی خوبه{\c}‬
Dialogue: 0,0:34:47.96,0:34:49.20,Standard,,0,0,0,,‫{\c&H00FFFF&}چی...{\c}‬
Dialogue: 0,0:34:49.32,0:34:51.84,Standard,,0,0,0,,‫{\c&H00FFFF&}حتماً یه راه حلی هست{\c}‬
Dialogue: 0,0:34:53.04,0:34:55.12,Standard,,0,0,0,,‫{\c&H00FFFF&}یه جوری حل میشه{\c}‬
Dialogue: 0,0:34:56.08,0:34:58.16,Standard,,0,0,0,,‫{\c&H00FFFF&}همه چی درست میشه{\c}‬
Dialogue: 0,0:35:00.72,0:35:01.96,Standard,,0,0,0,,‫{\c&H00FFFF&}در نهایت...{\c}‬
Dialogue: 0,0:35:03.24,0:35:05.24,Standard,,0,0,0,,‫{\c&H00FFFF&}...همه چی خوبه{\c}‬
Dialogue: 0,0:35:06.64,0:35:09.92,Standard,,0,0,0,,‫{\c&H00FFFF&}اگه هنوز خوب نیست،‬\N‫پس... آره...{\c}‬
Dialogue: 0,0:35:11.44,0:35:14.52,Standard,,0,0,0,,‫{\c&H00FFFF&}پس... پس هنوز‬\N‫به آخرش نرسیدیم{\c}‬
Dialogue: 0,0:35:23.24,0:35:25.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی *{\c}‬
Dialogue: 0,0:36:22.56,0:36:24.72,Standard,,0,0,0,,‫{\c&HFF0000&}حق نشر زیرنویس: NDR 2018{\c}‬