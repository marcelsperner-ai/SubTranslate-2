Dialogue: 0,0:00:00.24,0:00:02.96,Standard,,0,0,0,,‫{\c&HFF0000&}زیرنویس:{\c}‬\N‫{\c&HFF0000&}شبکه نور دویچر روندفونک ۲۰۱۸{\c}‬
Dialogue: 0,0:00:21.04,0:00:23.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی پیانوی شاد *{\c}‬
Dialogue: 0,0:00:33.52,0:00:35.16,Standard,,0,0,0,,‫{\c&HFFFFFF&}* الو؟ * {\c}‬\N‫{\c&H00FFFF&}جانم؟ رئیس{\c}‬
Dialogue: 0,0:00:36.04,0:00:38.48,Standard,,0,0,0,,‫{\c&H00FFFF&}من الان رسیدم اینجا پیش اینا...{\c}‬
Dialogue: 0,0:00:38.64,0:00:40.36,Standard,,0,0,0,,‫{\c&H00FFFF&}آره، صداتون رو خوب دارم، آره{\c}‬
Dialogue: 0,0:00:40.60,0:00:42.44,Standard,,0,0,0,,‫{\c&H00FFFF&}من امم... من... الو؟{\c}‬
Dialogue: 0,0:00:42.68,0:00:43.88,Standard,,0,0,0,,‫{\c&HFFFFFF&}* الو؟ * {\c}‬\N‫{\c&H00FFFF&}الو{\c}‬
Dialogue: 0,0:00:44.68,0:00:46.04,Standard,,0,0,0,,‫{\c&H00FFFF&}الو، الو!{\c}‬
Dialogue: 0,0:00:46.88,0:00:48.04,Standard,,0,0,0,,‫{\c&H00FFFF&}الو... آره!{\c}‬
Dialogue: 0,0:00:48.12,0:00:50.56,Standard,,0,0,0,,‫{\c&H00FFFF&}اه، رئیس، الان... {\c}‬\N‫{\c&HFFFFFF&}* کی اونجاست؟ *{\c}‬
Dialogue: 0,0:00:50.96,0:00:54.24,Standard,,0,0,0,,‫{\c&H00FFFF&}آره، هایکو هستم{\c}‬\N‫{\c&H00FFFF&}الان رسیدم اینجا... الو؟{\c}‬
Dialogue: 0,0:00:54.36,0:00:55.64,Standard,,0,0,0,,‫{\c&H00FFFF&}آه...!{\c}‬
Dialogue: 0,0:01:07.92,0:01:09.72,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی *{\c}‬
Dialogue: 1,0:01:23.76,0:01:34.76,InfoBox,,0,0,0,,{\b1}Moin{\b0} {\fs32\c&HC0C0C0&}(norddeutsch){\r}\N{\c&H00FFFF&}سلام{\c}
Dialogue: 0,0:01:23.76,0:01:25.08,Standard,,0,0,0,,‫{\c&H00FFFF&}‬\N‫{\u1}سلام{\u0}‬\N‫{\c}‬
Dialogue: 1,0:01:29.20,0:01:40.20,InfoBox,,0,0,0,,{\b1}jemandem nichts sagen{\b0}\N{\c&H00FFFF&}چیزی بهم نمیگه{\c}
Dialogue: 0,0:01:29.20,0:01:32.04,Standard,,0,0,0,,‫{\c&H00FFFF&}فامیلیم شوته‌ست{\c}‬\N‫{\c&HFFFFFF&}متأسفانه‬\N‫{\u1}چیزی بهم نمیگه{\u0}‬\N‫{\c}‬
Dialogue: 0,0:01:32.12,0:01:35.60,Standard,,0,0,0,,‫{\c&H00FFFF&}شرکت لائوزن، صحنه جرم...{\c}‬\N‫{\c&HFFFFFF&}چیزی بهم نمیگه {\c}‬\N‫{\c&H00FFFF&}...پاکسازی{\c}‬
Dialogue: 0,0:01:35.68,0:01:37.16,Standard,,0,0,0,,‫{\c&H00FFFF&}اومدم اینجا تمیزکاری کنم{\c}‬
Dialogue: 0,0:01:37.24,0:01:39.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}اسمتون چی بود؟ {\c}‬\N‫{\c&H00FFFF&}هایکو شوته{\c}‬
Dialogue: 0,0:01:39.68,0:01:41.96,Standard,,0,0,0,,‫{\c&HFFFFFF&}قرار داشتید؟ {\c}‬\N‫{\c&H00FFFF&}آره، معلومه{\c}‬
Dialogue: 0,0:01:42.08,0:01:43.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}اسمشون رو پرسیدم{\c}‬
Dialogue: 0,0:01:43.16,0:01:47.28,Standard,,0,0,0,,‫{\c&H00FFFF&}گفتم که. هایکو شوته{\c}‬\N‫{\c&HFFFFFF&}با کی قرار دارید؟{\c}‬
Dialogue: 0,0:01:47.36,0:01:49.72,Standard,,0,0,0,,‫{\c&H00FFFF&}آره، امم...{\c}‬\N‫{\c&H00FFFF&}نمیدونم. من...{\c}‬
Dialogue: 0,0:01:49.84,0:01:52.76,Standard,,0,0,0,,‫{\c&HFFFFFF&}خیلی نمیتونم بهتون{\c}‬\N‫{\c&HFFFFFF&}امید بدم{\c}‬
Dialogue: 0,0:01:52.80,0:01:55.96,Standard,,0,0,0,,‫{\c&HFFFFFF&}بعداً دوباره امتحان کنید{\c}‬\N‫{\c&H00FFFF&}یعنی چی بعداً؟{\c}‬
Dialogue: 0,0:01:56.04,0:01:58.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه هفته دیگه. یا یه ماه دیگه{\c}‬
Dialogue: 0,0:01:58.84,0:02:01.00,Standard,,0,0,0,,‫{\c&H00FFFF&}یه ماه؟ {\c}‬\N‫{\c&HFFFFFF&}یا شاید یه سال دیگه{\c}‬
Dialogue: 0,0:02:01.08,0:02:02.28,Standard,,0,0,0,,‫{\c&H00FFFF&}ها؟{\c}‬
Dialogue: 1,0:02:02.36,0:02:13.36,InfoBox,,0,0,0,,{\b1}Mal langsam{\b0}\N{\c&H00FFFF&}یواش‌تر، آروم باش{\c}
Dialogue: 0,0:02:02.36,0:02:03.56,Standard,,0,0,0,,‫{\c&H00FFFF&}‬\N‫{\u1}یواش‌تر، آروم باش{\u0}‬\N‫{\c}‬
Dialogue: 0,0:02:03.64,0:02:06.72,Standard,,0,0,0,,‫{\c&H00FFFF&}اسم من شوته‌ست،{\c}‬\N‫{\c&H00FFFF&}از شرکت لائوزن{\c}‬
Dialogue: 0,0:02:06.84,0:02:10.92,Standard,,0,0,0,,‫{\c&H00FFFF&}یه سفارش دارم{\c}‬\N‫{\c&H00FFFF&}برای نظافت صحنه جرم{\c}‬
Dialogue: 0,0:02:11.00,0:02:13.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}آها! برای چی؟ {\c}‬\N‫{\c&H00FFFF&}نظافت صحنه جرم{\c}‬
Dialogue: 0,0:02:13.64,0:02:16.48,Standard,,0,0,0,,‫{\c&HFFFFFF&}آهان، خب شما؟{\c}‬\N‫{\c&H00FFFF&}نظافتچیِ صحنه جرمم{\c}‬
Dialogue: 1,0:02:16.92,0:02:27.92,InfoBox,,0,0,0,,{\b1}Na also{\b0}\N{\c&H00FFFF&}خب، پس حله{\c}
Dialogue: 0,0:02:16.92,0:02:19.00,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه چیزایی شنیدم {\c}‬\N‫{\c&H00FFFF&}‬\N‫{\u1}خب، پس حله{\u0}‬\N‫{\c}‬
Dialogue: 0,0:02:19.56,0:02:21.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}حالا می‌خوای کجا بری؟{\c}‬
Dialogue: 0,0:02:21.60,0:02:23.16,Standard,,0,0,0,,‫{\c&H00FFFF&}خب، معلومه... صحنه جرم{\c}‬
Dialogue: 0,0:02:23.28,0:02:27.28,Standard,,0,0,0,,‫{\c&H00FFFF&}باید یه تصادف یا قتلی{\c}‬\N‫{\c&H00FFFF&}رخ داده باشه {\c}‬\N‫{\c&HFFFFFF&}جدی؟{\c}‬
Dialogue: 0,0:02:27.44,0:02:29.36,Standard,,0,0,0,,‫{\c&H00FFFF&}این رو که دیگه باید خودت بدونی{\c}‬
Dialogue: 0,0:02:29.44,0:02:32.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}شاید طبقه ۳۱ باشه،{\c}‬\N‫{\c&HFFFFFF&}ولی مطمئن نیستم{\c}‬
Dialogue: 1,0:02:32.60,0:02:43.60,InfoBox,,0,0,0,,{\b1}etwas mitkriegen{\b0}\N{\c&H00FFFF&}بی‌خبره{\c}
Dialogue: 0,0:02:32.60,0:02:35.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}این پایین آدم{\c}‬\N‫{\c&HFFFFFF&}از خیلی چیزا‬\N‫{\u1}بی‌خبره{\u0}‬\N‫{\c}‬
Dialogue: 0,0:02:36.76,0:02:40.96,Standard,,0,0,0,,‫{\c&H00FFFF&}چطوره به یکی زنگ بزنی{\c}‬\N‫{\c&H00FFFF&}که بیشتر از تو در جریان باشه{\c}‬
Dialogue: 0,0:02:42.84,0:02:46.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}بابت مزاحمت عذر می‌خوام،{\c}‬\N‫{\c&HFFFFFF&}اما...{\c}‬
Dialogue: 0,0:02:47.16,0:02:49.36,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه آقایی به اسم شاتر اینجاست{\c}‬
Dialogue: 0,0:02:49.48,0:02:51.76,Standard,,0,0,0,,‫{\c&H00FFFF&}شوته. بدون «ر». مثل اسکاتلندی{\c}‬
Dialogue: 0,0:02:51.92,0:02:55.32,Standard,,0,0,0,,‫{\c&H00FFFF&}ش، و، ت، ه. {\c}‬\N‫{\c&H00FFFF&}شوته{\c}‬
Dialogue: 0,0:02:56.32,0:02:59.12,Standard,,0,0,0,,‫{\c&HFFFFFF&}امیل شوته {\c}‬\N‫{\c&H00FFFF&}نه، هایکو. {\c}‬\N‫{\c&HFFFFFF&}چرا اینو گفتی؟{\c}‬
Dialogue: 0,0:02:59.20,0:03:02.48,Standard,,0,0,0,,‫{\c&H00FFFF&}که سوءتفاهم نشه {\c}‬\N‫{\c&HFFFFFF&}امیل به جای هایکو؟{\c}‬
Dialogue: 0,0:03:02.52,0:03:04.32,Standard,,0,0,0,,‫{\c&H00FFFF&}«امیل» واسه حرف «اِ» توی شوته‌ست{\c}‬
Dialogue: 0,0:03:04.36,0:03:08.00,Standard,,0,0,0,,‫{\c&HFFFFFF&}پس هایکو چی؟ {\c}‬\N‫{\c&H00FFFF&}می‌تونم یه لحظه؟ {\c}‬\N‫{\c&HFFFFFF&}صبر کن، صبر کن{\c}‬
Dialogue: 0,0:03:09.48,0:03:10.76,Standard,,0,0,0,,‫{\c&HFFFFFF&}شوته{\c}‬
Dialogue: 0,0:03:12.04,0:03:13.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}اسم کوچیکش هایکوئه؟{\c}‬
Dialogue: 0,0:03:13.72,0:03:14.80,Standard,,0,0,0,,‫{\c&H00FFFF&}آره{\c}‬
Dialogue: 0,0:03:14.88,0:03:16.16,Standard,,0,0,0,,‫{\c&HFFFFFF&}آره، دقیقاً{\c}‬
Dialogue: 0,0:03:17.00,0:03:19.24,Standard,,0,0,0,,‫{\c&HFFFFFF&}چرا اینو زودتر نگفتید؟{\c}‬
Dialogue: 0,0:03:19.32,0:03:21.96,Standard,,0,0,0,,‫{\c&HFFFFFF&}درسته، پاک‌کننده صحنه جرمم‬\N‫آره، گرفتم چی شد{\c}‬
Dialogue: 0,0:03:22.20,0:03:24.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}حالا باید بره اتاق ۳۱؟{\c}‬
Dialogue: 0,0:03:24.88,0:03:25.96,Standard,,0,0,0,,‫{\c&HFFFFFF&}آهان، پس اینطور{\c}‬
Dialogue: 0,0:03:26.16,0:03:27.84,Standard,,0,0,0,,‫{\c&HFFFFFF&}یعنی اینکه...{\c}‬
Dialogue: 0,0:03:29.00,0:03:31.16,Standard,,0,0,0,,‫{\c&HFFFFFF&}باشه، بهش می‌گم{\c}‬
Dialogue: 0,0:03:32.08,0:03:35.44,Standard,,0,0,0,,‫{\c&HFFFFFF&}ظاهراً همه‌چیز درسته‬\N‫ولی هنوز کار داره{\c}‬
Dialogue: 0,0:03:35.56,0:03:38.12,Standard,,0,0,0,,‫{\c&HFFFFFF&}سر نحوه مرگش‬\N‫هنوز به توافق نرسیدن{\c}‬
Dialogue: 0,0:03:38.72,0:03:41.44,Standard,,0,0,0,,‫{\c&H00FFFF&}تیم بررسی صحنه جرم هنوز اونجاست؟‬\N‫{\c&HFFFFFF&}همه اونجان{\c}‬
Dialogue: 0,0:03:41.68,0:03:44.24,Standard,,0,0,0,,‫{\c&HFFFFFF&}۲۷ تا متخصص،‬\N‫کارشناس، تحلیلگر{\c}‬
Dialogue: 1,0:03:44.60,0:03:55.60,InfoBox,,0,0,0,,{\b1}die Riege{\b0}\N{\c&H00FFFF&}کله‌گنده‌های{\c}
Dialogue: 0,0:03:44.60,0:03:46.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}و‬\N‫{\u1}کله‌گنده‌های{\u0}‬\N‫رده‌بالا{\c}‬
Dialogue: 0,0:03:46.72,0:03:48.72,Standard,,0,0,0,,‫{\c&HFFFFFF&}یعنی... خیلی خیلی رده‌بالا{\c}‬
Dialogue: 0,0:03:49.00,0:03:53.64,Standard,,0,0,0,,‫{\c&HFFFFFF&}و یه بحث حسابی‬\N‫سر نحوه ادامه کار دارن{\c}‬
Dialogue: 0,0:03:55.32,0:03:57.12,Standard,,0,0,0,,‫{\c&HFFFFFF&}اینکه چطوری خبر رو پخش کنن{\c}‬
Dialogue: 0,0:04:00.20,0:04:03.40,Standard,,0,0,0,,‫{\c&H00FFFF&}حدس می‌زنم‬\N‫قضیه مربوط به یه آدم خاصه؟{\c}‬
Dialogue: 0,0:04:03.48,0:04:05.04,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی یه سلبریتی یا همچین چیزی؟{\c}‬
Dialogue: 0,0:04:07.32,0:04:08.92,Standard,,0,0,0,,‫{\c&HFFFFFF&}بفرمایید بشینید{\c}‬
Dialogue: 0,0:04:09.00,0:04:12.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}یکی میاد دنبالتون و‬\N‫شما رو در جریان می‌ذاره{\c}‬
Dialogue: 0,0:04:17.76,0:04:20.40,Standard,,0,0,0,,‫{\c&H00FFFF&}این دیگه خیلی‬\N‫مرموز و عجیبه{\c}‬
Dialogue: 0,0:04:23.36,0:04:25.00,Standard,,0,0,0,,‫{\c&H00FFFF&}یه سوال دیگه{\c}‬
Dialogue: 0,0:04:25.64,0:04:29.48,Standard,,0,0,0,,‫{\c&H00FFFF&}دستشویی کجاست؟‬\N‫یا اونم جزو اسراره؟{\c}‬
Dialogue: 0,0:04:32.72,0:04:34.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}از اون طرف{\c}‬
Dialogue: 1,0:04:45.96,0:04:56.96,InfoBox,,0,0,0,,{\b1}sich einkriegen{\b0}\N{\c&H00FFFF&}خودتو کنترل کن{\c}
Dialogue: 0,0:04:45.96,0:04:49.60,Standard,,0,0,0,,‫{\c&HFFFF00&}این دیگه آخریشه!‬\N‫{\c&H00FF00&}‬\N‫{\u1}خودتو کنترل کن{\u0}‬\N‫{\c}‬
Dialogue: 0,0:04:49.72,0:04:51.72,Standard,,0,0,0,,‫{\c&HFFFF00&}من خودم کلی پرونده دارم!{\c}‬
Dialogue: 0,0:04:51.80,0:04:54.32,Standard,,0,0,0,,‫{\c&HFFFF00&}«بیاید دیگه، شما که همین دور و برین!»{\c}‬
Dialogue: 0,0:04:54.36,0:04:56.28,Standard,,0,0,0,,‫{\c&HFFFF00&}مگه بیکارم؟{\c}‬
Dialogue: 0,0:04:56.36,0:04:58.20,Standard,,0,0,0,,‫{\c&HFFFF00&}پولش رو هم که نمیدن{\c}‬
Dialogue: 0,0:04:58.28,0:05:00.80,Standard,,0,0,0,,‫{\c&H00FF00&}نمیدن؟ {\c}‬\N‫{\c&HFFFF00&}بهش میگن کار خیر{\c}‬
Dialogue: 0,0:05:00.92,0:05:04.92,Standard,,0,0,0,,‫{\c&HFFFF00&}چیزی که حرصم رو درمیاره...{\c}‬\N‫{\c&H00FF00&}میدونی چی حرصم رو درمیاره؟{\c}‬
Dialogue: 0,0:05:05.04,0:05:07.48,Standard,,0,0,0,,‫{\c&H00FF00&}اینکه همیشه باید تو رو آروم کنم{\c}‬
Dialogue: 0,0:05:08.40,0:05:11.32,Standard,,0,0,0,,‫{\c&HFFFF00&}خب، که چی؟{\c}‬\N‫{\c&H00FF00&}منم دلم می‌خواد یه بار حرص بخورم{\c}‬
Dialogue: 1,0:05:11.40,0:05:22.40,InfoBox,,0,0,0,,{\b1}etwas raushauen{\b0}\N{\c&H00FFFF&}خالی کنم{\c}
Dialogue: 0,0:05:11.40,0:05:13.68,Standard,,0,0,0,,‫{\c&H00FF00&}یه بار راحت احساساتم رو‬\N‫{\u1}خالی کنم{\u0}‬\N‫{\c}‬
Dialogue: 0,0:05:13.72,0:05:15.36,Standard,,0,0,0,,‫{\c&HFFFF00&}خب بکن. {\c}‬\N‫{\c&H00FF00&}الان؟{\c}‬
Dialogue: 0,0:05:15.52,0:05:17.68,Standard,,0,0,0,,‫{\c&HFFFF00&}نفس عمیق بکش و بریز بیرون{\c}‬
Dialogue: 0,0:05:17.76,0:05:20.68,Standard,,0,0,0,,‫{\c&HFFFF00&}فقط هر چی تو دلته بریز بیرون{\c}‬\N‫{\c&HFFFF00&}خانم کونیگ{\c}‬
Dialogue: 0,0:05:20.84,0:05:21.92,Standard,,0,0,0,,‫{\c&H00FF00&}آره{\c}‬
Dialogue: 0,0:05:22.04,0:05:23.96,Standard,,0,0,0,,‫{\c&H00FF00&}یهویی که نمیشه{\c}‬
Dialogue: 0,0:05:24.04,0:05:25.88,Standard,,0,0,0,,‫{\c&H00FF00&}منظورم کلاً اینه، همینجوری{\c}‬
Dialogue: 0,0:05:26.40,0:05:27.64,Standard,,0,0,0,,‫{\c&HFFFF00&}آها{\c}‬
Dialogue: 1,0:05:27.72,0:05:38.72,InfoBox,,0,0,0,,{\b1}dichtmachen{\b0}\N{\c&H00FFFF&}تعطیلش کردن{\c}
Dialogue: 0,0:05:27.72,0:05:31.36,Standard,,0,0,0,,‫{\c&HFFFF00&}اگه دوباره زنگ بزنن...{\c}‬\N‫{\c&H00FF00&}نه، کلاً‬\N‫{\u1}تعطیلش کردن{\u0}‬\N‫{\c}‬
Dialogue: 0,0:05:31.48,0:05:33.64,Standard,,0,0,0,,‫{\c&HFFFF00&}جدی؟ {\c}‬\N‫{\c&H00FF00&}این آخریش بود{\c}‬
Dialogue: 0,0:05:37.96,0:05:39.24,Standard,,0,0,0,,‫{\c&HFFFF00&}نه بابا{\c}‬
Dialogue: 0,0:05:39.36,0:05:40.36,Standard,,0,0,0,,‫{\c&HFFFF00&}اصلاً{\c}‬
Dialogue: 0,0:05:40.44,0:05:41.80,Standard,,0,0,0,,‫{\c&HFFFF00&}نه، اصلاً خوب نیست{\c}‬
Dialogue: 0,0:05:42.52,0:05:44.68,Standard,,0,0,0,,‫{\c&HFFFF00&}نه بابا، اونجا رو ببین، اونجا رو{\c}‬
Dialogue: 0,0:05:44.76,0:05:47.56,Standard,,0,0,0,,‫{\c&HFFFF00&}باید تمیزِ تمیز بشه{\c}‬\N‫{\c&HFFFF00&}اون گوشه رو نگاه کن{\c}‬
Dialogue: 0,0:05:48.00,0:05:49.48,Standard,,0,0,0,,‫{\c&HFFFF00&}خیلی خیلی افتضاحه{\c}‬
Dialogue: 0,0:05:50.24,0:05:52.76,Standard,,0,0,0,,‫{\c&HFFFF00&}کل این کثافت‌کاریِ گوشه باید جمع بشه!{\c}‬
Dialogue: 0,0:05:53.32,0:05:55.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}آره، ولی...{\c}‬\N‫{\c&HFFFF00&}آره چی، آره ولی؟{\c}‬
Dialogue: 0,0:05:55.68,0:05:58.04,Standard,,0,0,0,,‫{\c&HFFFF00&}«آره ولی»، کل روز فقط «آره ولی»{\c}‬
Dialogue: 0,0:05:58.40,0:06:00.32,Standard,,0,0,0,,‫{\c&HFFFF00&}بیا، باید حسابی تمیزش کنیم{\c}‬
Dialogue: 1,0:06:00.44,0:06:11.44,InfoBox,,0,0,0,,{\b1}Mein lieber Gesangverein{\b0}\N{\c&H00FFFF&}ای بابا، عجب داستانیه{\c}
Dialogue: 0,0:06:00.44,0:06:02.24,Standard,,0,0,0,,‫{\c&HFFFF00&}‬\N‫{\u1}ای بابا، عجب داستانیه{\u0}‬\N‫{\c}‬
Dialogue: 0,0:06:02.40,0:06:04.04,Standard,,0,0,0,,‫{\c&HFFFF00&}بیا، عینک رو بزن بالا{\c}‬
Dialogue: 0,0:06:04.12,0:06:07.84,Standard,,0,0,0,,‫{\c&HFFFF00&}برس رو بردار، تمیز کن،{\c}‬\N‫{\c&HFFFF00&}باید خیلی عمیق بری{\c}‬
Dialogue: 0,0:06:08.84,0:06:11.48,Standard,,0,0,0,,‫{\c&HFFFF00&}باید خیلی عمیق بری{\c}‬\N‫{\c&HFFFF00&}توی گندکاری‌ها{\c}‬
Dialogue: 0,0:06:11.72,0:06:14.16,Standard,,0,0,0,,‫{\c&HFFFF00&}و سریع‌تر، خیلی کندی{\c}‬
Dialogue: 0,0:06:14.24,0:06:16.88,Standard,,0,0,0,,‫{\c&HFFFF00&}اگه کند باشی،{\c}‬\N‫{\c&HFFFF00&}خیلی زود کارت می‌پره{\c}‬
Dialogue: 0,0:06:16.96,0:06:20.16,Standard,,0,0,0,,‫{\c&HFFFF00&}من همیشه میگم:{\c}‬\N‫{\c&HFFFF00&}وقتی گند باید بره، پس باید بره{\c}‬
Dialogue: 0,0:06:20.24,0:06:23.08,Standard,,0,0,0,,‫{\c&HFFFF00&}پسر، عمیق‌تر، عمیق‌تر،{\c}‬\N‫{\c&HFFFF00&}همیشه عمیق‌تر برو!{\c}‬
Dialogue: 0,0:06:23.16,0:06:25.96,Standard,,0,0,0,,‫{\c&HFFFF00&}بالا نیار،{\c}‬\N‫{\c&HFFFF00&}چون باید اون استفراغ رو هم تمیز کنی{\c}‬
Dialogue: 0,0:06:26.04,0:06:30.24,Standard,,0,0,0,,‫{\c&HFFFFFF&}* عملیات پر کردن دریاچه بینن‌آلستر{\c}‬\N‫{\c&HFFFFFF&}به‌زودی آغاز می‌شود{\c}‬
Dialogue: 0,0:06:30.68,0:06:34.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}دلیل: هزینه‌های سرسام‌آور{\c}‬\N‫{\c&HFFFFFF&}فواره آب{\c}‬
Dialogue: 0,0:06:34.64,0:06:36.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}زمین‌های حاصل از این کار{\c}‬
Dialogue: 0,0:06:36.68,0:06:41.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}برای ساخت‌وساز مسکونی و{\c}‬\N‫{\c&HFFFFFF&}فضاهای تجاری استفاده خواهد شد{\c}‬
Dialogue: 0,0:06:43.40,0:06:46.32,Standard,,0,0,0,,‫{\c&HFFFFFF&}جینا هوتزینگر{\c}‬\N‫{\c&HFFFFFF&}دوست‌پسر جدیدی پیدا کرده{\c}‬
Dialogue: 0,0:06:46.36,0:06:50.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}این خواننده در حال بوسیدن‌های شدید{\c}‬\N‫{\c&HFFFFFF&}در شهربازی دوم دیده شده *{\c}‬
Dialogue: 0,0:06:50.72,0:06:53.72,Standard,,0,0,0,,‫{\c&HFFFFFF&}# عجب، عجب، کاراکاس...{\c}‬
Dialogue: 0,0:06:54.40,0:06:58.04,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه اتاق خالی، یه تخت خالی #{\c}‬
Dialogue: 0,0:07:00.00,0:07:01.68,Standard,,0,0,0,,‫{\c&HFFFFFF&}* صدای زنگ تلفن *{\c}‬
Dialogue: 0,0:07:02.32,0:07:03.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}بله؟{\c}‬
Dialogue: 0,0:07:05.12,0:07:06.76,Standard,,0,0,0,,‫{\c&HFFFFFF&}چرا، چرا، حتماً{\c}‬
Dialogue: 0,0:07:07.12,0:07:11.92,Standard,,0,0,0,,‫{\c&HFFFFFF&}فقط اجازه می‌خوام بگم{\c}‬\N‫{\c&HFFFFFF&}که این کار کلی دردسر داره،{\c}‬
Dialogue: 0,0:07:12.04,0:07:14.24,Standard,,0,0,0,,‫{\c&HFFFFFF&}که از نظر مالی و زمانی...{\c}‬
Dialogue: 0,0:07:15.40,0:07:16.76,Standard,,0,0,0,,‫{\c&HFFFFFF&}حتماً{\c}‬
Dialogue: 0,0:07:16.80,0:07:18.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}باشه، همین الان انجامش می‌دم{\c}‬
Dialogue: 0,0:07:28.84,0:07:31.28,Standard,,0,0,0,,‫{\c&HFFFFFF&}* صدای موسیقی در تلویزیون: «کاراکاس» *{\c}‬
Dialogue: 0,0:07:38.60,0:07:39.80,Standard,,0,0,0,,‫{\c&H00FFFF&}# کاراکاس... #{\c}‬
Dialogue: 0,0:07:43.84,0:07:48.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}خانم فون هینکلتیس و یکی از بچه‌های{\c}‬\N‫{\c&HFFFFFF&}فنی بیان اتاق کنفرانس{\c}‬
Dialogue: 0,0:07:48.68,0:07:50.84,Standard,,0,0,0,,‫{\c&HFFFFFF&}موضوع سر لوستر کریستالیه{\c}‬
Dialogue: 0,0:07:50.88,0:07:52.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}ممنون{\c}‬
Dialogue: 0,0:07:53.36,0:07:54.48,Standard,,0,0,0,,‫{\c&H00FFFF&}خب؟{\c}‬
Dialogue: 0,0:07:54.60,0:07:56.52,Standard,,0,0,0,,‫{\c&HFFFFFF&}دیگه چیزی نمونده{\c}‬
Dialogue: 0,0:07:56.76,0:07:58.12,Standard,,0,0,0,,‫{\c&HFFFFFF&}همه به توافق رسیدن:{\c}‬
Dialogue: 0,0:07:58.28,0:08:00.96,Standard,,0,0,0,,‫{\c&HFFFFFF&}مرگ بر اثر سقوط{\c}‬\N‫{\c&HFFFFFF&}لوستر{\c}‬
Dialogue: 0,0:08:01.04,0:08:03.64,Standard,,0,0,0,,‫{\c&H00FFFF&}و اون‌وقت برای این کار{\c}‬\N‫{\c&H00FFFF&}۲۷ تا متخصص لازم دارن؟{\c}‬
Dialogue: 0,0:08:03.72,0:08:06.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}فقط بحثِ{\c}‬\N‫{\c&HFFFFFF&}علت مرگ نیست{\c}‬
Dialogue: 0,0:08:06.28,0:08:08.72,Standard,,0,0,0,,‫{\c&HFFFFFF&}بحثِ ابعاد استعاری‌اش هم هست{\c}‬
Dialogue: 0,0:08:08.80,0:08:10.00,Standard,,0,0,0,,‫{\c&H00FFFF&}چی؟{\c}‬
Dialogue: 0,0:08:10.08,0:08:13.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}مثلاً تو این مورد، کشته شدن{\c}‬\N‫{\c&HFFFFFF&}زیر بار زرق و برق{\c}‬
Dialogue: 0,0:08:13.72,0:08:16.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}یا دنیای پر زرق و برقِ{\c}‬\N‫{\c&HFFFFFF&}کشنده و غیرقابل پیش‌بینی{\c}‬
Dialogue: 0,0:08:20.88,0:08:23.44,Standard,,0,0,0,,‫{\c&HFFFFFF&}* هیاهو در باغ‌وحش هاگن‌بک{\c}‬
Dialogue: 0,0:08:23.56,0:08:26.00,Standard,,0,0,0,,‫{\c&HFFFFFF&}فرونیکه، بچه گراز دریایی گم شده{\c}‬
Dialogue: 0,0:08:26.08,0:08:28.28,Standard,,0,0,0,,‫{\c&HFFFFFF&}یکی از مسئولین باغ‌وحش گزارش داد{\c}‬
Dialogue: 0,0:08:28.36,0:08:32.00,Standard,,0,0,0,,‫{\c&HFFFFFF&}فرونیکه موقع غذا دادن{\c}‬\N‫{\c&HFFFFFF&}سر جاش نبوده{\c}‬
Dialogue: 0,0:08:32.12,0:08:34.68,Standard,,0,0,0,,‫{\c&HFFFFFF&}عملیات جستجو هم بی‌نتیجه بوده{\c}‬
Dialogue: 0,0:08:34.76,0:08:39.12,Standard,,0,0,0,,‫{\c&HFFFFFF&}از اونجایی که فرونیکه شکموئه،{\c}‬\N‫{\c&HFFFFFF&}بعیده که خودش{\c}‬
Dialogue: 0,0:08:39.24,0:08:43.32,Standard,,0,0,0,,‫{\c&HFFFFFF&}داوطلبانه از محل غذا خوردن{\c}‬\N‫{\c&HFFFFFF&}دور شده باشه{\c}‬
Dialogue: 0,0:08:44.96,0:08:48.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}پلیس هنوز هم دنبال{\c}‬\N‫{\c&HFFFFFF&}یانیس گیلمان می‌گرده{\c}‬
Dialogue: 0,0:08:48.92,0:08:52.48,Standard,,0,0,0,,‫{\c&HFFFFFF&}که از زندان{\c}‬\N‫{\c&HFFFFFF&}فرار کرده بود{\c}‬
Dialogue: 0,0:08:52.56,0:08:57.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}اون به جرم قتل غیرعمد به{\c}‬\N‫{\c&HFFFFFF&}۱۴ سال حبس محکوم شده بود{\c}‬
Dialogue: 0,0:08:57.20,0:09:01.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}اون موفق شد فرار کنه،{\c}‬\N‫{\c&HFFFFFF&}بعد از اینکه با صابون و واکس کفش{\c}‬
Dialogue: 0,0:09:01.76,0:09:04.48,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه کلت قلابی ساخت{\c}‬
Dialogue: 0,0:09:04.68,0:09:07.68,Standard,,0,0,0,,‫{\c&HFFFFFF&}و با اون مامور زندان رو{\c}‬\N‫{\c&HFFFFFF&}تهدید کرد{\c}‬
Dialogue: 0,0:09:08.68,0:09:13.32,Standard,,0,0,0,,‫{\c&HFFFFFF&}امروز تو هامبورگ-لوکشتت{\c}‬\N‫{\c&HFFFFFF&}یه اتفاق تلخ افتاد{\c}‬
Dialogue: 0,0:09:13.40,0:09:16.84,Standard,,0,0,0,,‫{\c&HFFFFFF&}به دلایل نامعلومی{\c}‬\N‫{\c&HFFFFFF&}مردی جونش رو از دست داد{\c}‬
Dialogue: 0,0:09:17.00,0:09:20.36,Standard,,0,0,0,,‫{\c&HFFFFFF&}که به عنوان نظافتچی{\c}‬\N‫{\c&HFFFFFF&}توی اون ساختمون بود{\c}‬
Dialogue: 0,0:09:20.40,0:09:24.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}ظاهراً یه گلدون که کنار{\c}‬\N‫{\c&HFFFFFF&}جسد پیدا شده{\c}‬
Dialogue: 0,0:09:24.48,0:09:26.00,Standard,,0,0,0,,‫{\c&HFFFFFF&}علت مرگ بوده{\c}‬
Dialogue: 0,0:09:26.28,0:09:29.64,Standard,,0,0,0,,‫{\c&HFFFFFF&}اینکه گلدون اتفاقی{\c}‬\N‫{\c&HFFFFFF&}افتاده رو سرش{\c}‬
Dialogue: 0,0:09:29.76,0:09:32.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}یا پرتاب شده، هنوز مشخص نیست{\c}‬
Dialogue: 0,0:09:33.20,0:09:37.04,Standard,,0,0,0,,‫{\c&HFFFFFF&}اون مرد تنها زندگی می‌کرد،{\c}‬\N‫{\c&HFFFFFF&}اما تو فیسبوک{\c}‬
Dialogue: 0,0:09:37.20,0:09:39.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}طرفدار، دوست و دنبال‌کننده داشت{\c}‬
Dialogue: 0,0:09:40.52,0:09:45.24,Standard,,0,0,0,,‫{\c&HFFFFFF&}اونا خودجوش جلوی ساختمون{\c}‬\N‫{\c&HFFFFFF&}جمع شدن تا مراسم یادبود بگیرن *{\c}‬
Dialogue: 0,0:09:45.92,0:09:47.00,Standard,,0,0,0,,‫{\c&H00FFFF&}ببخشید؟{\c}‬
Dialogue: 0,0:09:48.56,0:09:50.84,Standard,,0,0,0,,‫{\c&H00FFFF&}اینجا چه جور شرکتیه؟{\c}‬
Dialogue: 0,0:09:50.92,0:09:52.48,Standard,,0,0,0,,‫{\c&H00FFFF&}کارشون چیه؟{\c}‬
Dialogue: 0,0:09:53.88,0:09:55.36,Standard,,0,0,0,,‫{\c&HFFFF00&}چه می‌دونم{\c}‬
Dialogue: 0,0:09:56.52,0:09:59.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی *{\c}‬
Dialogue: 0,0:10:20.04,0:10:22.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی عجیب *{\c}‬
Dialogue: 0,0:10:55.88,0:10:57.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}* صدای دینگ *{\c}‬
Dialogue: 0,0:11:04.56,0:11:08.36,Standard,,0,0,0,,‫{\c&H00FFFF&}فقط می‌خواستم بگم که{\c}‬\N‫{\c&H00FFFF&}زمان انتظار هم جزو ساعت کاریه{\c}‬
Dialogue: 1,0:11:08.44,0:11:19.44,InfoBox,,0,0,0,,{\b1}etwas in Rechnung stellen{\b0}\N{\c&H00FFFF&}تو فاکتور حساب کنم{\c}
Dialogue: 0,0:11:08.44,0:11:10.84,Standard,,0,0,0,,‫{\c&H00FFFF&}و من باید اینو{\c}‬\N‫{\c&H00FFFF&}‬\N‫{\u1}تو فاکتور حساب کنم{\u0}‬\N‫{\c}‬
Dialogue: 0,0:11:10.96,0:11:13.80,Standard,,0,0,0,,‫{\c&H00FFFF&}تازه کلی کار دیگه هم{\c}‬\N‫{\c&H00FFFF&}دارم که باید برسم{\c}‬
Dialogue: 0,0:11:14.04,0:11:16.88,Standard,,0,0,0,,‫{\c&HFFFFFF&}خوش به حالتون که{\c}‬\N‫{\c&HFFFFFF&}بعدش همه‌چی ادامه داره{\c}‬
Dialogue: 0,0:11:16.96,0:11:18.24,Standard,,0,0,0,,‫{\c&H00FFFF&}آره، یه جور مهمونیه{\c}‬
Dialogue: 1,0:11:18.32,0:11:29.32,InfoBox,,0,0,0,,{\b1}auflegen{\b0}\N{\c&H00FFFF&}دی‌جی‌ایه{\c}
Dialogue: 0,0:11:18.32,0:11:20.48,Standard,,0,0,0,,‫{\c&H00FFFF&}یکی از رفیقام اونجا‬\N‫{\u1}دی‌جی‌ایه{\u0}‬\N‫{\c}‬
Dialogue: 1,0:11:20.56,0:11:31.56,InfoBox,,0,0,0,,{\b1}gut aufgelegt sein{\b0}\N{\c&H00FFFF&}رو فرم باشم{\c}
Dialogue: 0,0:11:20.56,0:11:23.20,Standard,,0,0,0,,‫{\c&H00FFFF&}امیدوارم{\c}‬\N‫{\c&H00FFFF&}منم‬\N‫{\u1}رو فرم باشم{\u0}‬\N‫{\c}‬
Dialogue: 0,0:11:23.28,0:11:27.32,Standard,,0,0,0,,‫{\c&H00FF00&}من نالانی ودمبله هستم،{\c}‬\N‫{\c&H00FF00&}با تیا گورن قرار دارم{\c}‬
Dialogue: 0,0:11:27.56,0:11:28.84,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه لحظه صبر کنید{\c}‬
Dialogue: 0,0:11:31.72,0:11:33.80,Standard,,0,0,0,,‫{\c&H00FFFF&}شما اتفاقی اهل آنگولا نیستید؟{\c}‬
Dialogue: 0,0:11:33.84,0:11:36.84,Standard,,0,0,0,,‫{\c&H00FF00&}چرا می‌خواید بدونید؟{\c}‬\N‫{\c&H00FFFF&}خب، آخه...{\c}‬
Dialogue: 0,0:11:36.92,0:11:38.84,Standard,,0,0,0,,‫{\c&H00FFFF&}ما نزدیک بود ازدواج کنیم{\c}‬
Dialogue: 0,0:11:39.08,0:11:40.60,Standard,,0,0,0,,‫{\c&H00FFFF&}آه، خودتون که می‌دونید{\c}‬
Dialogue: 0,0:11:40.68,0:11:42.84,Standard,,0,0,0,,‫{\c&H00FFFF&}ما همدیگه رو نمی‌شناسیم، ولی...{\c}‬
Dialogue: 0,0:11:42.96,0:11:44.16,Standard,,0,0,0,,‫{\c&H00FFFF&}خودتون که می‌دونید{\c}‬
Dialogue: 0,0:11:46.44,0:11:49.00,Standard,,0,0,0,,‫{\c&H00FFFF&}تصور دیگه‌ای ازتون داشتم{\c}‬
Dialogue: 1,0:11:49.04,0:12:00.04,InfoBox,,0,0,0,,{\b1}das Himmelszelt{\b0} {\fs32\c&HC0C0C0&}(gehoben){\r}\N{\c&H00FFFF&}آسمون و ریسمون{\c}
Dialogue: 0,0:11:49.04,0:11:52.80,Standard,,0,0,0,,‫{\c&H00FFFF&}خب، در مورد نالانی،{\c}‬\N‫{\c&H00FFFF&}‬\N‫{\u1}آسمون و ریسمون{\u0}‬\N‫و...{\c}‬
Dialogue: 0,0:11:53.04,0:11:54.68,Standard,,0,0,0,,‫{\c&H00FFFF&}هنوز دنبال کسی می‌گردید؟{\c}‬
Dialogue: 0,0:11:55.48,0:11:57.48,Standard,,0,0,0,,‫{\c&H00FFFF&}یعنی به عنوان... شوهر؟{\c}‬
Dialogue: 0,0:12:03.80,0:12:05.52,Standard,,0,0,0,,‫{\c&H00FFFF&}خب می‌شد دیگه، مگه نه؟{\c}‬
Dialogue: 0,0:12:05.68,0:12:10.44,Standard,,0,0,0,,‫{\c&H00FFFF&}آدم که نمی‌دونه،{\c}‬\N‫{\c&H00FFFF&}اتفاق‌های عجیب غریب زیاد می‌افته{\c}‬
Dialogue: 0,0:12:14.28,0:12:15.60,Standard,,0,0,0,,‫{\c&H00FFFF&}مرله...{\c}‬
