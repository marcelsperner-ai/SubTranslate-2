Dialogue: 0,0:11:20.20,0:11:21.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}ولی آماده باش..."{\c}‬
Dialogue: 0,0:11:22.88,0:11:25.72,Standard,,0,0,0,,‫{\c&HFFFFFF&}"...باشید. خبرهای بدی دارم"{\c}‬
Dialogue: 0,0:11:31.00,0:11:33.16,Standard,,0,0,0,,‫{\c&HFFFFFF&}"آماده باش"{\c}‬
Dialogue: 1,0:11:45.88,0:11:56.88,InfoBox,,0,0,0,,{\b1}Alter{\b0}\N{\c&H00FFFF&}ای بابا{\c}
Dialogue: 0,0:11:45.88,0:11:47.68,Standard,,0,0,0,,‫{\c&HFFFFFF&}* صدای کوبیده شدن در *{\c}‬\N‫{\c&HFF00FF&}‬\N‫{\u1}ای بابا{\u0}‬\N‫{\c}‬
Dialogue: 0,0:11:48.80,0:11:51.56,Standard,,0,0,0,,‫{\c&HFF00FF&}می‌خواستم لباس‌هاتو بیارم{\c}‬\N‫{\c&HFFFFFF&}توی دستشویی بودم{\c}‬
Dialogue: 0,0:11:52.48,0:11:54.08,Standard,,0,0,0,,‫{\c&HFF00FF&}اوکی...{\c}‬
Dialogue: 0,0:12:24.08,0:12:26.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}(زوئی) خدای من{\c}‬\N‫{\c&HFFFFFF&}چقدر داغون به نظر میام{\c}‬
Dialogue: 0,0:12:27.12,0:12:29.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}ببخشید، اهم، هی بچه‌ها{\c}‬\N‫{\c&HFFFFFF&}حتماً براتون سوال شده{\c}‬
Dialogue: 0,0:12:29.84,0:12:32.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}که چرا{\c}‬\N‫{\c&HFFFFFF&}از قبل آرایش کردم{\c}‬
Dialogue: 0,0:12:33.04,0:12:34.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه خبر ناراحت‌کننده دارم{\c}‬
Dialogue: 0,0:12:34.84,0:12:37.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}احساساتم{\c}‬\N‫{\c&HFFFFFF&}واقعاً جریحه‌دار شده{\c}‬
Dialogue: 0,0:12:38.84,0:12:42.28,Standard,,0,0,0,,‫{\c&HFFFFFF&}امروز می‌خوام بهتون بگم چرا{\c}‬\N‫{\c&HFFFFFF&}می‌خوام کانالم رو تعطیل کنم{\c}‬
Dialogue: 0,0:12:43.68,0:12:45.16,Standard,,0,0,0,,‫{\c&HFFFFFF&}آره، دقیقاً{\c}‬
Dialogue: 0,0:12:45.32,0:12:48.00,Standard,,0,0,0,,‫{\c&HFFFFFF&}و به همین مناسبت{\c}‬\N‫{\c&HFFFFFF&}آموزش آرایش نداریم{\c}‬
Dialogue: 0,0:12:48.16,0:12:50.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}بلکه آموزش پاک کردن آرایش داریم{\c}‬
Dialogue: 0,0:12:50.64,0:12:52.48,Standard,,0,0,0,,‫{\c&HFFFFFF&}می‌خوایم صورتمون رو پاک کنیم{\c}‬
Dialogue: 0,0:12:52.64,0:12:54.88,Standard,,0,0,0,,‫{\c&HFFFFFF&}ولی قبل از اینکه شروع کنیم{\c}‬\N‫{\c&HFFFFFF&}لایک کنید{\c}‬
Dialogue: 0,0:12:54.92,0:12:57.68,Standard,,0,0,0,,‫{\c&HFFFFFF&}کامنت بذارید{\c}‬\N‫{\c&HFFFFFF&}و کانالم رو سابسکرایب کنید{\c}‬
Dialogue: 0,0:12:57.72,0:13:00.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}خب، ما اینجا{\c}‬\N‫{\c&HFFFFFF&}یه دستمال مرطوب داریم{\c}‬
Dialogue: 0,0:13:00.36,0:13:02.36,Standard,,0,0,0,,‫{\c&HFFFFFF&}* موسیقی ملایم *{\c}‬
Dialogue: 0,0:13:04.28,0:13:06.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}(برایان) موسیقی باحالیه تئو{\c}‬\N‫{\c&HFFFFFF&}چیه این؟{\c}‬
Dialogue: 0,0:13:08.40,0:13:11.92,Standard,,0,0,0,,‫{\c&HFFFF00&}کار خودمه. یعنی گروه موسیقی‌ام{\c}‬\N‫{\c&HFFFFFF&}واو، جدی؟{\c}‬
Dialogue: 0,0:13:12.08,0:13:13.64,Standard,,0,0,0,,‫{\c&HFFFFFF&}خیلی خوبه{\c}‬
Dialogue: 0,0:13:13.68,0:13:15.96,Standard,,0,0,0,,‫{\c&H00FF00&}ساختار و نظم{\c}‬\N‫{\c&H00FF00&}دیگه کجا...{\c}‬
Dialogue: 0,0:13:16.00,0:13:18.60,Standard,,0,0,0,,‫{\c&H00FF00&}تئو؟ دیگه کجا{\c}‬\N‫{\c&H00FF00&}ساختار و نظم وجود داره؟{\c}‬
Dialogue: 0,0:13:19.12,0:13:21.24,Standard,,0,0,0,,‫{\c&HFFFF00&}اهم...{\c}‬\N‫{\c&H00FF00&}مثلاً مدیریت بازرگانی{\c}‬
Dialogue: 0,0:13:21.40,0:13:25.08,Standard,,0,0,0,,‫{\c&H00FF00&}با اون می‌تونی هر کاری بکنی{\c}‬\N‫{\c&HFFFFFF&}من می‌تونم مدیریت بازرگانی رو توی ارتش بخونم{\c}‬
Dialogue: 0,0:13:25.12,0:13:28.84,Standard,,0,0,0,,‫{\c&HFFFFFF&}حقوق هم می‌گیرم{\c}‬\N‫{\c&HFFFFFF&}هزینه باشگاه هم که کلاً برام حذف میشه{\c}‬
Dialogue: 0,0:13:28.88,0:13:32.00,Standard,,0,0,0,,‫{\c&HFFFF00&}منطقیه. حالا اگه واقعاً{\c}‬\N‫{\c&HFFFF00&}ازش لذت می‌بری، چرا که نه؟{\c}‬
Dialogue: 0,0:13:32.04,0:13:35.12,Standard,,0,0,0,,‫{\c&H00FF00&}الو، حواستون هست چی می‌گید؟{\c}‬\N‫{\c&H00FF00&}اونجا ارتشه، ارتش!{\c}‬
Dialogue: 0,0:13:35.28,0:13:37.28,Standard,,0,0,0,,‫{\c&H00FF00&}سلاح، جنگ، کشتن آدم‌ها...{\c}‬
Dialogue: 0,0:13:37.44,0:13:39.24,Standard,,0,0,0,,‫{\c&H00FF00&}کجاش ممکنه لذت‌بخش باشه؟{\c}‬
Dialogue: 0,0:13:39.28,0:13:41.24,Standard,,0,0,0,,‫{\c&H00FFFF&}ببخشید، من باید اینجا{\c}‬\N‫{\c&H00FFFF&}یه نکته‌ای رو اصلاح کنم{\c}‬
Dialogue: 1,0:13:43.32,0:13:54.32,InfoBox,,0,0,0,,{\b1}Rampenlicht{\b0}\N{\c&H00FFFF&}در کانون توجه{\c}
Dialogue: 0,0:13:43.32,0:13:46.92,Standard,,0,0,0,,‫{\c&H00FFFF&}تا قضیه به اشتباه{\c}‬\N‫{\c&H00FFFF&}تفسیر نشه{\c}‬
Dialogue: 0,0:13:47.08,0:13:50.52,Standard,,0,0,0,,‫{\c&H00FFFF&}این‌ها همش پیش‌داوری‌های همیشگی{\c}‬\N‫{\c&H00FFFF&}در مورد ارتشه{\c}‬
Dialogue: 0,0:13:50.56,0:13:53.20,Standard,,0,0,0,,‫{\c&H00FF00&}اندی، ما داریم یه{\c}‬\N‫{\c&H00FF00&}گفتگوی خصوصی می‌کنیم{\c}‬
Dialogue: 0,0:13:53.24,0:13:55.60,Standard,,0,0,0,,‫{\c&H00FFFF&}اوضاع خیلی وقت‌ها{\c}‬\N‫{\c&H00FFFF&}با اون چیزی که فکر می‌کنید فرق داره{\c}‬
Dialogue: 0,0:13:56.28,0:13:58.84,Standard,,0,0,0,,‫{\c&H00FFFF&}من خودم زمان سربازی تو نیروی دریایی{\c}‬\N‫{\c&H00FFFF&}برق‌کار بودم{\c}‬
Dialogue: 0,0:13:58.88,0:14:00.80,Standard,,0,0,0,,‫{\c&H00FFFF&}اصلاً لازم نبود به کسی شلیک کنم{\c}‬
Dialogue: 0,0:14:00.84,0:14:03.96,Standard,,0,0,0,,‫{\c&H00FFFF&}من کسی رو{\c}‬\N‫{\c&H00FFFF&}نفرستادم اون دنیا،{\c}‬
Dialogue: 0,0:14:04.00,0:14:05.52,Standard,,0,0,0,,‫{\c&H00FFFF&}به قول معروف{\c}‬
Dialogue: 0,0:14:05.68,0:14:09.08,Standard,,0,0,0,,‫{\c&H00FFFF&}فقط باید حواسم می‌بود که{\c}‬\N‫{\c&H00FFFF&}مدارهای الکتریکی درست کار کنن{\c}‬
Dialogue: 0,0:14:09.12,0:14:12.48,Standard,,0,0,0,,‫{\c&H00FFFF&}این یه حقیقته، حتی اگه{\c}‬\N‫{\c&H00FFFF&}خیلی‌ها نخوان بشنون{\c}‬
Dialogue: 0,0:14:12.52,0:14:14.56,Standard,,0,0,0,,‫{\c&H00FFFF&}پسرجان، به حرف اینا گوش نده{\c}‬
Dialogue: 0,0:14:14.72,0:14:18.28,Standard,,0,0,0,,‫{\c&H00FFFF&}ارتش جاییه که توش{\c}‬\N‫{\c&H00FFFF&}رفاقت و نظم یاد می‌گیری{\c}‬
Dialogue: 0,0:14:18.44,0:14:22.04,Standard,,0,0,0,,‫{\c&H00FFFF&}به نظر من، ما تو این کشور قشنگمون{\c}‬\N‫{\c&H00FFFF&}خیلی کمبود این چیزها رو داریم{\c}‬
Dialogue: 0,0:14:27.12,0:14:28.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}* اندی آروغ می‌زند *{\c}‬
Dialogue: 0,0:14:35.36,0:14:36.84,Standard,,0,0,0,,‫{\c&H00FFFF&}خب دیگه، مگه نه؟{\c}‬
Dialogue: 0,0:14:37.72,0:14:39.96,Standard,,0,0,0,,‫{\c&H00FFFF&}من دیگه برم{\c}‬\N‫{\c&H00FFFF&}دیگه واقعاً...{\c}‬
Dialogue: 0,0:14:44.64,0:14:46.28,Standard,,0,0,0,,‫{\c&H00FFFF&}هوم، باشه{\c}‬
Dialogue: 0,0:14:47.60,0:14:49.92,Standard,,0,0,0,,‫{\c&HFFFF00&}خب، با همسایه‌مون هم{\c}‬\N‫{\c&HFFFF00&}آشنا شدی{\c}‬
Dialogue: 1,0:14:49.96,0:15:00.96,InfoBox,,0,0,0,,{\b1}krass{\b0}\N{\c&H00FFFF&}عجب آدمیه{\c}
Dialogue: 0,0:14:49.96,0:14:52.76,Standard,,0,0,0,,‫{\c&H00FF00&}به شونه‌فلده خوش اومدی{\c}‬\N‫{\c&HFFFFFF&}‬\N‫{\u1}عجب آدمیه{\u0}‬\N‫{\c}‬
Dialogue: 0,0:14:53.28,0:14:56.12,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه جورایی... خیلی واقعیه{\c}‬
Dialogue: 0,0:15:00.12,0:15:03.44,Standard,,0,0,0,,‫{\c&H00FF00&}خب، هنر. نظرت چیه دوباره{\c}‬\N‫{\c&H00FF00&}امتحانش کنی؟{\c}‬
Dialogue: 0,0:15:04.64,0:15:07.68,Standard,,0,0,0,,‫{\c&H00FF00&}ببین، تو ارتش فقط{\c}‬\N‫{\c&H00FF00&}باید دستور اجرا کنی{\c}‬
Dialogue: 0,0:15:07.72,0:15:10.04,Standard,,0,0,0,,‫{\c&H00FF00&}اونجا اصلاً اجازه نداری{\c}‬\N‫{\c&H00FF00&}مستقل فکر کنی{\c}‬
Dialogue: 0,0:15:10.08,0:15:12.08,Standard,,0,0,0,,‫{\c&H00FF00&}دیدیم که آخرش به کجا ختم میشه{\c}‬
Dialogue: 0,0:15:12.12,0:15:16.12,Standard,,0,0,0,,‫{\c&H00FF00&}ولی تو هنر، آزادی{\c}‬\N‫{\c&H00FF00&}هر کاری دلت بخواد می‌تونی بکنی{\c}‬
Dialogue: 0,0:15:16.28,0:15:18.28,Standard,,0,0,0,,‫{\c&H00FF00&}این دقیقاً همون چیزیه{\c}‬\N‫{\c&H00FF00&}که برات خوبه{\c}‬
Dialogue: 0,0:15:18.44,0:15:22.76,Standard,,0,0,0,,‫{\c&H00FF00&}به نظرم باید انجامش بدی{\c}‬\N‫{\c&HFFFFFF&}پس ساختار و نظم چی میشه؟{\c}‬
Dialogue: 0,0:15:22.80,0:15:25.64,Standard,,0,0,0,,‫{\c&HFFFF00&}آره، دقیقاً{\c}‬\N‫{\c&H00FF00&}اینا رو تو دانشگاه یاد می‌گیری{\c}‬
Dialogue: 0,0:15:25.68,0:15:27.32,Standard,,0,0,0,,‫{\c&HFFFF00&}دانشگاه هنر؟{\c}‬
Dialogue: 0,0:15:27.36,0:15:30.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}ولی فکر می‌کنید{\c}‬\N‫{\c&HFFFFFF&}از پس آزمون ورودیش برمیام؟{\c}‬
Dialogue: 0,0:15:30.24,0:15:33.56,Standard,,0,0,0,,‫{\c&H00FF00&}فقط امتحانش کن{\c}‬\N‫{\c&HFFFF00&}با این جذابیتی که داری، حتماً قبولت می‌کنن{\c}‬
Dialogue: 0,0:15:33.72,0:15:35.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}ممنون، تئو{\c}‬
Dialogue: 0,0:15:35.72,0:15:38.92,Standard,,0,0,0,,‫{\c&HFFFF00&}در نهایت خودت باید بدونی{\c}‬\N‫{\c&HFFFF00&}چه مسیری برات درسته{\c}‬
Dialogue: 0,0:15:38.96,0:15:40.68,Standard,,0,0,0,,‫{\c&HFFFF00&}اینکه حالا...{\c}‬\N‫{\c&H00FF00&}درسته{\c}‬
Dialogue: 0,0:15:40.84,0:15:42.44,Standard,,0,0,0,,‫{\c&H00FF00&}و این فقط تو هنر ممکنه{\c}‬
Dialogue: 0,0:15:44.20,0:15:47.00,Standard,,0,0,0,,‫{\c&H00FF00&}باید به حرف دلت گوش بدی{\c}‬\N‫{\c&H00FF00&}نه به عقلت{\c}‬
Dialogue: 0,0:15:48.72,0:15:50.36,Standard,,0,0,0,,‫{\c&HFFFFFF&}خیلی قشنگ گفتی{\c}‬
Dialogue: 0,0:15:52.52,0:15:54.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}* تئو سوت می‌زند *{\c}‬
Dialogue: 0,0:15:59.36,0:16:03.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}من عاشق پنکیکم{\c}‬\N‫{\c&HFFFF00&}می‌دونم، دارم کلی درست می‌کنم{\c}‬
Dialogue: 0,0:16:04.40,0:16:05.88,Standard,,0,0,0,,‫{\c&HFFFF00&}عالیه{\c}‬
Dialogue: 0,0:16:07.96,0:16:09.44,Standard,,0,0,0,,‫{\c&HFFFF00&}می‌خوای بری مطالعه کنی؟{\c}‬
Dialogue: 0,0:16:10.16,0:16:11.76,Standard,,0,0,0,,‫{\c&HFFFFFF&}نقاشی{\c}‬
Dialogue: 1,0:16:11.92,0:16:22.92,InfoBox,,0,0,0,,{\b1}Bilder{\b0}\N{\c&H00FFFF&}نقاشی‌های خفن{\c}
Dialogue: 0,0:16:11.92,0:16:14.08,Standard,,0,0,0,,‫{\c&HFFFF00&}با این وسیله{\c}‬\N‫{\c&HFFFF00&}اون‬\N‫{\u1}نقاشی‌های خفن{\u0}‬\N‫رو می‌کشی؟{\c}‬
Dialogue: 0,0:16:14.12,0:16:15.60,Standard,,0,0,0,,‫{\c&HFFFFFF&}آره، پس چطور؟{\c}‬
Dialogue: 0,0:16:16.40,0:16:18.32,Standard,,0,0,0,,‫{\c&HFFFF00&}حالا چی می‌کشی؟{\c}‬
Dialogue: 0,0:16:19.68,0:16:21.32,Standard,,0,0,0,,‫{\c&HFFFFFF&}ببینم چی به ذهنم می‌رسه{\c}‬
Dialogue: 0,0:16:21.36,0:16:23.40,Standard,,0,0,0,,‫{\c&HFFFFFF&}معمولاً اول گوگل می‌کنم{\c}‬
Dialogue: 0,0:16:23.56,0:16:25.56,Standard,,0,0,0,,‫{\c&HFFFFFF&}یه چند تا پین رو چک می‌کنم{\c}‬
Dialogue: 0,0:16:25.60,0:16:27.20,Standard,,0,0,0,,‫{\c&HFFFFFF&}ببینم چی بهم الهام می‌ده{\c}‬
Dialogue: 0,0:16:28.52,0:16:30.44,Standard,,0,0,0,,‫{\c&HFFFF00&}می‌تونی منو نقاشی کنی{\c}‬
Dialogue: 0,0:16:33.92,0:16:36.20,Standard,,0,0,0,,‫{\c&HFFFF00&}یعنی فقط یه پیشنهاد بود، چون...{\c}‬
Dialogue: 0,0:16:36.36,0:16:39.08,Standard,,0,0,0,,‫{\c&HFFFF00&}چون تو زیاد پرتره می‌کشی...‬\N‫و با خودم گفتم...{\c}‬
Dialogue: 0,0:16:42.16,0:16:44.04,Standard,,0,0,0,,‫{\c&HFFFF00&}ولی خب مجبور هم نیستی{\c}‬
Dialogue: 0,0:16:44.20,0:16:46.36,Standard,,0,0,0,,‫{\c&HFFFF00&}اگه نه هم درک می‌کنم‬\N‫{\c&HFFFFFF&}باشه، حله{\c}‬
Dialogue: 0,0:16:46.40,0:16:48.40,Standard,,0,0,0,,‫{\c&HFFFF00&}فقط یه پیشنهاد بود‬\N‫{\c&HFFFFFF&}ممنون{\c}‬
Dialogue: 0,0:16:53.96,0:16:57.48,Standard,,0,0,0,,‫{\c&H00FFFF&}روکی، پاشو بیا چمن‌زنی‬\N‫اول جلو، بعد پشت{\c}‬
Dialogue: 0,0:16:58.32,0:17:01.32,Standard,,0,0,0,,‫{\c&H00FFFF&}یه ساعته تمومش می‌کنیم‬\N‫{\c&HFFFFFF&}* صدای چمن‌زن *{\c}‬
Dialogue: 0,0:17:02.48,0:17:05.80,Standard,,0,0,0,,‫{\c&HFFFFFF&}«...داشتم‬\N‫خبرهای ناراحت‌کننده‌ای دارم{\c}‬
Dialogue: 0,0:17:05.96,0:17:08.84,Standard,,0,0,0,,‫{\c&HFFFFFF&}احساساتم‬\N‫واقعاً جریحه‌دار شده»{\c}‬
Dialogue: 0,0:17:09.00,0:17:10.48,Standard,,0,0,0,,‫{\c&HFF00FF&}عروسک{\c}‬
Dialogue: 0,0:17:10.52,0:17:14.08,Standard,,0,0,0,,‫{\c&HFFFFFF&}«امروز بهتون می‌گم چرا‬\N‫می‌خوام کانالم رو تعطیل کنم{\c}‬
